er setVariable [""LM_var_ctrlTextTimerNumbers"", _ctrlTextTimerNumbers]; " \n "           }; " \n " " \n "           showChat true; " \n " " \n "           while {(missionNameSpace getVariable [format[""LM_var_timerEnd_%1"", _affectedSide], serverTime]) > serverTime} do { " \n "            private _ctrlTextTimerTitle = (player getVariable [""LM_var_ctrlTextTimerTitle"", controlNull]); " \n "            private _ctrlTextTimerNumbers = (player getVariable [""LM_var_ctrlTextTimerNumbers"", controlNull]); " \n "            if (alive player) then { " \n "             if !(player getVariable [""LM_var_timerPlayerAlive"", false]) then { " \n "              { " \n "               _x ctrlSetFade 0;  " \n "               _x ctrlCommit 0;   " \n "              } forEach [_ctrlTextTimerTitle, _ctrlTextTimerNumbers]; " \n "              player setVariable [""LM_var_timerPlayerAlive"", true, true]; " \n "             }; " \n " " \n "             if (_affectedSide != (side player)) then { " \n "              _affectedSide = side player; " \n "             }; " \n "             _timerTitle = missionNameSpace getVariable [format[""LM_var_timerTitle_%1"", _affectedSide], """"]; " \n " " \n "             if (!isNull _display) then { " \n "              private _timeLeft = (missionNameSpace getVariable [format[""LM_var_timerEnd_%1"", _affectedSide], serverTime]) - serverTime; " \n "              private _mins = floor ((_timeLeft / 60) max 0); " \n "              if (_mins < 10) then { " \n "               _mins = ""0""+str _mins; " \n "              }; " \n "              private _secs = floor ((_timeLeft % 60) max 0); " \n "              if (_secs < 10) then { " \n "               _secs = ""0""+str _secs; " \n "              }; " \n " " \n "              _ctrlTextTimerTitle ctrlSetStructuredText parseText format[""<t align='center'>%1</t>"", toUpper _timerTitle]; " \n "              _ctrlTextTimerTitle ctrlCommit 0; " \n " " \n "              _ctrlTextTimerNumbers ctrlSetStructuredTex