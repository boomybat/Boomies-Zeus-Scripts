_spawnGroup; " \n "            }; " \n "            case ""NameVillage"": {  " \n "             [_zoneID, _centre, _light, format[""MKR_%1_MAX"", _zoneID], floor((random 1.5) * _multiplier)] call _fnc_spawnGroup; " \n "             [_zoneID, _centre, _medium, format[""MKR_%1_MAX"", _zoneID], floor((random 1) * _multiplier)] call _fnc_spawnGroup;  " \n "             [_zoneID, _centre, _squad, format[""MKR_%1_MAX"", _zoneID], 1 + floor((random 1.5) * _multiplier)] call _fnc_spawnGroup;  " \n "             [_zoneID, _centre, _team, format[""MKR_%1_MAX"", _zoneID], 1 + floor((random 2) * _multiplier)] call _fnc_spawnGroup;  " \n "             [_zoneID, _centre, _sentry, format[""MKR_%1_MIN"", _zoneID], 2 + floor((random 2) * _multiplier)] call _fnc_spawnGroup; " \n "            }; " \n "            case ""NameLocal"": {  " \n "             [_zoneID, _centre, _light, format[""MKR_%1_MAX"", _zoneID], floor((random 1) * _multiplier)] call _fnc_spawnGroup; " \n "             [_zoneID, _centre, _squad, format[""MKR_%1_MAX"", _zoneID], floor((random 1.5) * _multiplier)] call _fnc_spawnGroup;  " \n "             [_zoneID, _centre, _team, format[""MKR_%1_MAX"", _zoneID], 1 + floor((random 1) * _multiplier)] call _fnc_spawnGroup;  " \n "             [_zoneID, _centre, _sentry, format[""MKR_%1_MIN"", _zoneID], 1 + floor((random 2) * _multiplier)] call _fnc_spawnGroup; " \n "            }; " \n "            case ""Ambient"": {  " \n "             if (random 1 > 0.6) then { " \n "              [_zoneID, _centre, _light, format[""MKR_%1_MAX"", _zoneID], 1] call _fnc_spawnGroup; " \n "             } else { " \n "              [_zoneID, _centre, _team, format[""MKR_%1_MAX"", _zoneID], 1] call _fnc_spawnGroup; " \n "             }; " \n "             [_zoneID, _centre, _sentry, format[""MKR_%1_MIN"", _zoneID], floor((random 1.5) * _multiplier)] call _fnc_spawnGroup; " \n "            }; " \n "            case ""Task""; " \n "            default {        " \n "             switch (_str) do { " \n "              case ""Heavy"": {  " \n "               [_zoneID, _centre, _light, format[""MKR_%1_MAX"", _zoneID], 1 + floor((random 1) * _multiplier)] call _fnc_spawnGroup; " \n "               [_zoneID, _centre, _medium, format[""MKR_%1_MAX"", _zoneID], 1 + floor((random 1.5) * _multiplier)] call _fnc_spawnGroup;  " \n "               [_zoneID, _centre, _heavy, format[""MKR_%1_MIN"", _zoneID], floor((random 1) * _multiplier)] call _fnc_spawnGroup;   " \n "               [_zoneID, _centre, _squad, format[""MKR_%1_MAX"", _zoneID], 2 + floor((random 2) * _multiplier)] call _fnc_spawnGroup;  " \n "               [_zoneID, _centre, _team, format[""MKR_%1_MAX"", _zoneID], 1 + floor((random 2) * _multiplier)] call _fnc_spawnGroup;   " \n "              }; " \n "              case ""Light"": {  " \n "               [_zoneID, _centre, _light, format[""MKR_%1_MAX"", _zoneID], floor((random 1) * _multiplier)] call _fnc_spawnGroup; " \n "               [_zoneID, _centre, _squad, format[""MKR_%1_MAX"", _zoneID], floor((random 1) * _multiplier)] call _fnc_spawnGroup;  " \n "               [_zoneID, _centre, _team, format[""MKR_%1_MAX"", _zoneID], floor((random 1.5) * _multiplier)] call _fnc_spawnGroup;  " \n "               [_zoneID, _centre, _sentry, format[""MKR_%1_MIN"", _zoneID], 1 + floor((random 1) * _multiplier)] call _fnc_spawnGroup; " \n "              }; " \n "              default {  " \n "               [_zoneID, _centre, _light, format[""MKR_%1_MAX"", _zoneID], 1 + floor((random 1) * _multiplier)] call _fnc_spawnGroup; " \n "               [_zoneID, _centre, _medium, format[""MKR_%1_MAX"", _zoneID], floor((random 1) * _multiplier)] call _fnc_spawnGroup;  " \n "               [_zoneID, _centre, _squad, format[""MKR_%1_MAX"", _zoneID], 1 + floor((random 1.5) * _multiplier)] call _fnc_spawnGroup;  " \n "               [_zoneID, _centre, _team, format[""MKR_%1_MAX"", _zoneID], 1 + floor((random 1) * _multiplier)] call _fnc_spawnGroup;  " \n "              }; " \n "             }; " \n "            }; " \n "           }; " \n " " \n "           missionNamespace setVariable [format[ ""ZMM_%1_PatrolsEnabled"", _zoneID], false]; " \n "           missionNamespace setVariable [format[ ""ZMM_%1_PatrolsStrength"", _zoneID], _str]; " \n " " \n "           true " \n "          }; " \n "         }; " \n "         if (isNil(""zmm_fnc_areaQRF"")) then { " \n "          zmm_fnc_areaQRF = { " \n "           if !isServer exitWith {}; " \n "           params [ " \n "            [""_zoneID"", 0], " \n "            [""_triggerOnly"", false], " \n "            [""_delay"", 300], " \n "            [""_maxWave"", 10], " \n "            [""_qrfType"", -1], " \n "            [""_diff"",-1] " \n "           ]; " \n " " \n "           _qrfTypes = [ " \n "            ""Reserve"", " \n "            ""Motorized"", " \n "            ""Mechanised"", " \n "            ""Armoured"", " \n "            ""Airborne"", " \n "            ""Infantry"", " \n "            ""Helicopter"", " \n "            ""Aircraft"" " \n "           ]; " \n " " \n "           if (_delay < 1) then { " \n "            [""DEBUG"", format[""Zone%1 - Delay was not set, defaulting to: %2"", _zoneID, 300]] call zmm_fnc_logMsg; " \n "            _delay = 300; " \n "           }; " \n " " \n "           if (_maxWave < 1) then {  _maxWave = 3 }; " \n " " \n "           missionNamespace setVariable [format[ ""ZMM_%1_QRFTime"", _zoneID ], 0]; " \n " " \n "           private _centre = missionNamespace getVariable [format[""ZMM_%1_Location"", _zoneID], [0,0,0]]; " \n "           private _side = missionNamespace getVariable [format[""ZMM_%1_enemySide"", _zoneID], EAST]; " \n "           private _locations = missionNamespace getVariable [format[""ZMM_%1_QRFLocations"", _zoneID], []]; " \n " " \n "           if (_qrfType >= count _qrfTypes) then { _qrfType = selectRandom [0,1,2,3,4,5,6,7]; }; " \n " " \n "           private _sentry = missionNamespace getVariable [format[""ZMM_%1Grp_Sentry"",