"        _sides = _sides; " \n "        _minutes = round _minutes;  " \n "        _seconds = round _seconds; " \n "        private _timer = (_minutes * 60) + _seconds; " \n " " \n "        { " \n "         missionNameSpace setVariable [format[""LM_var_timerTitle_%1"", _x], _title, true]; " \n "         if (_timer > 0) then { " \n "          missionNameSpace setVariable [format[""LM_var_timerEnd_%1"", _x], serverTime + _timer, true]; " \n "         }; " \n "        } forEach _sides; " \n "        if (_timer > 0) then { " \n "         if (_minutes < 10) then { " \n "          _minutes = ""0""+str _minutes; " \n "         }; " \n "         if (_seconds < 10) then { " \n "          _seconds = ""0""+str _seconds; " \n "         }; " \n "         [format[""Countdown timer title set to '%1' and will end '%2:%3' minute(s) from now for side(s) '%4'."", _title, _minutes, _seconds, _sides],""3DEN_notificationDefault""] call LM_fnc_systemMessage; " \n "        } else { " \n "         [format[""Countdown timer title set to '%1' for side(s) '%2'."", _title, _sides],""3DEN_notificationDefault""] call LM_fnc_systemMessage; " \n "        }; " \n "       } else { " \n "        [""Title too long! Cannot send, max characters is 30, please retry."",""3DEN_notificationWarning""] call LM_fnc_systemMessage; " \n "       }; " \n " " \n "       _display closeDisplay 1; " \n "      },{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _display closeDisplay 2; " \n "      },[]] call MAZ_EZM_fnc_createDialog; " \n "     }; " \n " " \n " " \n "    comment ""Operation Area""; " \n "     LM_fnc_operationAreaModule = { " \n "      if(!visibleMap) exitWith {[""Cannot place a marker without the map open!"",""addItemFailed""] call LM_fnc_systemMessage;}; " \n "      private _position = [] call MAZ_EZM_fnc_getScreenPosition; " \n " " \n "      [""Operation Area"",[ " \n "       [ " \n "        ""TOOLBOX:ENABLED"", " \n "        [""AO - Control:"",""Control whether the operation area is enabled or not.\nChoose disable to remove any existing operation area, choosing enable will replace.""], " \n "        [true] " \n "       ], " \n "       [ " \n "        ""VECTOR"", " \n "        ""AO - Position:"", " \n "        [[(_position select 0),(_position select 1)],[""X"",""Y""],2] " \n "       ], " \n "       [ " \n "        ""VECTOR"", " \n "        ""AO - Size:"", " \n "        [[1000,1000],[""X"",""Y""],2] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""AO - Rotation:"",""Rotation of the rectangle in degrees.""], " \n "        [0,359,0] " \n "       ], " \n "       [ " \n "        ""TOOLBOX:ENABLED"", " \n "        [""Boundary - Control:"",""Whether to have a 3D Boundary Wall to designate the border of the operation area.""], " \n "        [(profileNamespace getVariable [""LM_AOWall_Enable"",true])] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Boundary - Column Spacing:"",""Distance in meters, between columns in the 3D Boundary Wall for the AO.""], " \n "        [0,250,(profileNamespace getVariable [""LM_AOWall_SpacingMeters"",16])] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Boundary - Row Amount:"",""Number of rows in the 3D Boundary Wall for the AO.""], " \n "        [0,50,(profileNamespace getVariable [""LM_AOWall_Layers"",5])] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Boundary - Row Spacing:"",""Distance in meters, between rows in the 3D Boundary Wall for the AO.""], " \n "        [0,50,(profileNamespace getVariable [""LM_AOWall_LayerHeight"",8])] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Boundary - Render Distance:"",""Distance in meters, from the player the 3D Boundary Wall for the AO is visible.""], " \n "        [0,2000,(profileNamespace getVariable [""LM_AOWall_RenderDist"",500])] " \n "       ], " \n "       [ " \n "        ""COLOR"", " \n "        [""Boundary - Distant Color:"", ""The color of the wall seen from a distance.""], " \n "        [profileNamespace getVariable [""LM_AOWall_Color"",[1, 0.3, 0.05, 0.3]]] " \n "       ], " \n "       [ " \n "        ""COLOR"", " \n "        [""Boundary - Close Color:"", ""The color of the wall which fades in close you get.""], " \n "        [profileNamespace getVariable [""LM_AOWall_WarnColorLine"",[1, 0, 0, 0.5]]] " \n "       ], " \n "       [ " \n "        ""TOOLBOX:ENABLED"", " \n "        [""Out of Bounds - Control:"",""Whether to have a warning for being out of bounds of the operation area.\n\nNOTE: Disabling damage on a player will prevent them from getting a warning.""], " \n "        [(profileNamespace getVariable [""LM_AOWall_WarnEnable"",true])] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Out of Bounds - Distance:"",""Distance in meters, from the 3D Boundary Wall the player must be before being warned via hint that they must turn back to avoid the edge of the operation area.""], " \n "        [0,300,(profileNamespace getVariable [""LM_AOWall_WarnDist"",150])] " \n "       ], " \n "       [ " \n "        ""TOOLBOX:ENABLED"", " \n "        [""Out of Bounds - Sound:"",""Whether to enable a radio sound on approaching and exiting the 3D Boundary Wall.""], " \n "        [(profileNamespace getVariable [""LM_AOWall_WarnSound"",true])] " \n "       ], " \n "       [ " \n "        ""TOOLBOX:ENABLED"", " \n "        [""Out of Bounds - Damage:"",""Whether to enable a slow reduction of the players health upon exiting the 3D Boundary Wall\nThey will be killed by the time they hit the max time out of bounds.""], " \n "        [(profileNamespace getVariable [""LM_AOWall_WarnDamage"",false])] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Out of Bounds - Time (min):"",""How many minutes a player can remain out of bounds if warning damage is enabled.""], " \n "        [1,5,(profileNamespace getVariable [""LM_AOWall_WarnInterval"",1])] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Out of Bounds - Interval (sec):"",""How many seconds between each time the current warning is repeated to the player.""], " \n "        [15,300,(profileNamespace getVariable [""LM_AOWall_WarnDuration"",15])] " \n "       ] " \n "      ],{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _values params [""_aoControl"",""_aoPos"",""_aoSize"",""_aoRotation"",""_wallControl"",""_wallColumnSpace"",""_wallRowAmount"",""_wallRowSpace"",""_wallRenderDist"",""_wallDistantColor"",""_wallCloseColor"",""_warningControl"",""_warningDist"",""_warningSound"",""_warningDamage"",""_warningTime"",""_warningInterval""]; " \n "        " \n "       profileNamespace setVariable [""LM_AOWall_Enable"",_wallControl]; " \n "       profileNamespace setVariable [""LM_AOWall_SpacingMeters"",_wallColumnSpace]; " \n "       profileNamespace setVariable [""LM_AOWall_Layers"",_wallRowAmount]; " \n "       profileNamespace setVariable [""LM_AOWall_LayerHeight"",_wallRowSpace]; " \n "       profileNamespace setVariable [""LM_AOWall_RenderDist"",_wallRenderDist]; " \n "       profileNamespace setVariable [""LM_AOWall_Color"",_wallDistantColor]; " \n "       profileNamespace setVariable [""LM_AOWall_WarnColorLine"",_wallCloseColor]; " \n "       profileNamespace setVariable [""LM_AOWall_WarnEnable"",_warningControl]; " \n "       profileNamespace setVariable [""LM_AOWall_WarnDist"",_warningDist]; " \n "       profileNamespace setVariable [""LM_AOWall_WarnSound"",_warningSound]; " \n "       profileNamespace setVariable [""LM_AOWall_WarnDamage"",_warningDamage]; " \n "       profileNamespace setVariable [""LM_AOWall_WarnInterval"",_warningTime]; " \n "       profileNamespace setVariable [""LM_AOWall_WarnDuration"",_warningInterval]; " \n " " \n "       LM_fnc_AOWall_showWarningRaw = { " \n "        params [""_level""]; " \n " " \n "        private _now = time; " \n "        if (_now - LM_AOWall_LastWarnTime < LM_AOWall_WarnInterval) exitWith {}; " \n "        LM_AOWall_LastWarnTime = _now; " \n " " \n "        if (isDamageAllowed player) then { " \n "         switch (_level) do { " \n "          case ""caution"": { " \n "           hintSilent parseText " \n "            ""<t color='#FFaa33' size='1.2' shadow='1' align='center'>CAUTION AO BOUNDARY</t>""; " \n "           if (LM_AOWall_WarnSound) then { playSound ""HintCollapse"" }; " \n "          }; " \n "          case ""warning"": { " \n "           hintSilent parseText ( " \n "            ""<t color='#FF5500' size='1.2' shadow='1' align='center'>WARNING AO BOUNDARY</t>"" " \n "           ); " \n "           if (LM_AOWall_WarnSound) then { playSound ""HintExpand"" }; " \n "          }; " \n "          case ""critical"": { " \n "           hintSilent parseText ( " \n "            ""<t color='#FF0000' size='1.2' shadow='1' align='center'>LEAVING AO BOUNDARY</t><br/>"" + " \n "            ""<t color='#FF3300' size='1.1' align='center'>Turn back immediately</t>"" " \n "           ); " \n "           if (LM_AOWall_WarnSound) then { [selectRandom [""A_Warn_No_Leader""], ""Zone_Restriction"", [true,true], ""DIRECT"", {true}, [player], 1, false] spawn BIS_fnc_kbTell }; " \n "          }; " \n "          case ""outside"": { " \n "           hintSilent parseText ( " \n "            ""<t color='#FF0000' size='1.2' shadow='1' align='center'>OUTSIDE AO BOUNDARY</t><br/>"" + " \n "            ""<t color='#FF3300' size='1.1' align='center'>Return to the Area of Operations</t>"" " \n "           ); " \n "           if (LM_AOWall_WarnSound) then { [selectRandom [""A_Warn_Has_Leader"", ""Warn_Has_Leader""], ""Zone_Restriction"", [true,true], ""DIRECT"", {true}, [player], 1, false] spawn BIS_fnc_kbTell }; " \n "           if (LM_AOWall_WarnDamage) then { player setDamage ((damage player) + (1/((LM_AOWall_WarnDuration*60)/LM_AOWall_WarnInterval))) }; " \n "          }; " \n "         }; " \n "        }; " \n "       }; " \n "       _showWarningCode = (str LM_fnc_AOWall_showWarningRaw) splitString """"; " \n "       _showWarningCode deleteAt (count _showWarningCode - 1); " \n "       _showWarningCode deleteAt 0; " \n "       missionNamespace setVariable [""LM_fnc_showWarningVariable"",_showWarningCode,true]; " \n " " \n "       [[_aoControl,_aoPos,_aoSize,_aoRotation,_wallControl,_wallColumnSpace,_wallRowAmount,_wallRowSpace,_wallRenderDist,_wallDistantColor,_wallCloseColor,_warningControl,_warningDist,_warningSound,_warningDamage,_warningTime,_warningInterval],{ " \n "        params [""_aoControl"",""_aoPos"",""_aoSize"",""_aoRotation"",""_wallControl"",""_wallColumnSpace"",""_wallRowAmount"",""_wallRowSpace"",""_wallRenderDist"",""_wallDistantColor"",""_wallCloseColor"",""_warningControl"",""_warningDist"",""_warningSound"",""_warningDamage"",""_warningTime"",""_warningInterval""]; " \n "         " \n "        comment ""Boundary""; " \n "         comment ""Wall Appearance""; " \n "          LM_AOWall_Enable    = _wallControl; " \n "          LM_AOWall_SpacingMeters  = _wallColumnSpace;  " \n "          LM_AOWall_Layers         = _wallRowAmount;  " \n "          LM_AOWall_LayerHeight    = _wallRowSpace;   " \n "          LM_AOWall_RenderDist     = _wallRenderDist;   " \n "          LM_AOWall_Color          = _wallDistantColor;   " \n "          LM_AOWall_WarnColorLine  = _wallCloseColor;  " \n " " \n " " \n "         comment ""Warning System""; " \n "          LM_AOWall_WarnEnable     = _warningControl;    " \n "          LM_AOWall_WarnDist       = _warningDist; " \n "          LM_AOWall_WarnSound      = _warningSound;  " \n "          LM_AOWall_WarnDamage     = _warningDamage;  " \n "          LM_AOWall_WarnInterval   = _warningInterval;  " \n "          LM_AOWall_WarnDuration   = _warningTime;        " \n " " \n " " \n "         comment ""Internal State""; " \n "          LM_AOWall_Active        = false; " \n "          LM_AOWall_DrawHandle    = -1; " \n "          LM_AOWall_WarnHandle    = scriptNull; " \n "          LM_AOWall_PlayerOutside = false; " \n "          LM_AOWall_LastWarnTime  = 0; " \n " " \n " " \n "         comment ""Functions""; " \n "          LM_fnc_AOWall_genPoints = { " \n "           params [""_center"",""_sizeX"",""_sizeY"",""_rotation"",""_spacing""]; " \n " " \n "           private _corners = [ " \n "            [-_sizeX,  _sizeY], " \n "            [ _sizeX,  _sizeY], " \n "            [ _sizeX, -_sizeY], " \n "            [-_sizeX, -_sizeY] " \n "           ]; " \n " " \n "           private _worldCorners = _corners apply { " \n "            private _lx = _x select 0; " \n "            private _ly = _x select 1; " \n "            [ " \n "             (_center select 0) + (_lx * cos(_rotation) - _ly * sin(_rotation)), " \n "             (_center select 1) + (_lx * sin(_rotation) + _ly * cos(_rotation)) " \n "            ] " \n "           }; " \n " " \n "           private _points = []; " \n "           for ""_side"" from 0 to 3 do { " \n "            private _p1 = _worldCorners select _side; " \n "            private _p2 = _worldCorners select ((_side + 1) % 4); " \n "            private _edgeLen = _p1 distance2D _p2; " \n "            private _steps = ceil(_edgeLen / _spacing); " \n " " \n "            for ""_i"" from 0 to (_steps - 1) do { " \n "             private _t = _i / _steps; " \n "             _points pushBack [ " \n "              (_p1 select 0) + ((_p2 select 0) - (_p1 select 0)) * _t, " \n "              (_p1 select 1) + ((_p2 select 1) - (_p1 select 1)) * _t " \n "             ]; " \n "            }; " \n "           }; " \n " " \n "           _points " \n "          }; " \n " " \n "          LM_fnc_AOWall_isInsideAO = { " \n "           params [""_pos"",""_center"",""_sizeX"",""_sizeY"",""_rotation""]; " \n " " \n "           private _dx = (_pos select 0) - (_center select 0); " \n "           private _dy = (_pos select 1) - (_center select 1); " \n " " \n "           private _lx =  _dx * cos(_rotation) + _dy * sin(_rotation); " \n "           private _ly = -_dx * sin(_rotation) + _dy * cos(_rotation); " \n " " \n "           (abs _lx <= _sizeX) && (abs _ly <= _sizeY) " \n "          }; " \n " " \n "          LM_fnc_AOWall_distToEdge = { " \n "           params [""_pos"",""_center"",""_sizeX"",""_sizeY"",""_rotation""]; " \n " " \n "           private _dx = (_pos select 0) - (_center select 0); " \n "           private _dy = (_pos select 1) - (_center select 1); " \n " " \n "           private _lx =  _dx * cos(_rotation) + _dy * sin(_rotation); " \n "           private _ly = -_dx * sin(_rotation) + _dy * cos(_rotation); " \n " " \n "           ((_sizeX - _lx) min (_sizeX + _lx) min (_sizeY - _ly) min (_sizeY + _ly)) " \n "          }; " \n " " \n "          LM_fnc_AOWall_showWarning = compile ((missionNamespace getVariable ""LM_fnc_showWarningVariable"") joinString """"); " \n "          waitUntil {!isNil (""LM_fnc_AOWall_showWarning"")}; " \n " " \n "          LM_fnc_AOBorderWall = { " \n "           params [ " \n "            [""_center"", [0,0], [[]]], " \n "            [""_sizeX"", 1000, [0]], " \n "            [""_sizeY"", 1000, [0]], " \n "            [""_rotation"", 0, [0]] " \n "           ]; " \n " " \n "           [] call LM_fnc_removeAOBorderWall; " \n " " \n "           private _allPoints = [_center, _sizeX, _sizeY, _rotation, LM_AOWall_SpacingMeters] " \n "            call LM_fnc_AOWall_genPoints; " \n " " \n "           missionNamespace setVariable [""LM_AOWall_AllPoints"", _allPoints, true]; " \n "           missionNamespace setVariable [""LM_AOWall_Center"", _center, true]; " \n "           missionNamespace setVariable [""LM_AOWall_SizeX"", _sizeX, true]; " \n "           missionNamespace setVariable [""LM_AOWall_SizeY"", _sizeY, true]; " \n "           missionNamespace setVariable [""LM_AOWall_Rotation"", _rotation, true]; " \n " " \n "           LM_AOWall_Active = true; " \n "           LM_AOWall_PlayerOutside = false; " \n "           LM_AOWall_LastWarnTime = 0; " \n " " \n "           LM_AOWall_DrawHandle = addMissionEventHandler [""Draw3D"", { " \n "            if !(LM_AOWall_Active) exitWith {}; " \n " " \n "            private _points     = missionNamespace getVariable [""LM_AOWall_AllPoints"", []]; " \n "            private _playerPos  = getPosASL player; " \n "            private _renderDist = LM_AOWall_RenderDist; " \n "            private _layers     = LM_AOWall_Layers; " \n "            private _layerH     = LM_AOWall_LayerHeight; " \n "            private _totalH     = _layers * _layerH; " \n "            private _baseColor  = LM_AOWall_Color; " \n "            private _warnColor  = LM_AOWall_WarnColorLine; " \n "            private _warnDist   = LM_AOWall_WarnDist; " \n "            private _count      = count _points; " \n " " \n "            for ""_i"" from 0 to (_count - 1) do { " \n "             private _pt = _points select _i; " \n "             private _dist = _playerPos distance2D _pt; " \n " " \n "             if (_dist > _renderDist) then { continue }; " \n " " \n "             private _alpha = linearConversion [_renderDist, _renderDist * 0.15, _dist, 0, 1, true]; " \n " " \n "             private _color = if (_dist < _warnDist) then { " \n "              private _t = linearConversion [_warnDist, 0, _dist, 0, 1, true]; " \n "              [ " \n "               (_baseColor#0) + ((_warnColor#0) - (_baseColor#0)) * _t, " \n "               (_baseColor#1) + ((_warnColor#1) - (_baseColor#1)) * _t, " \n "               (_baseColor#2) + ((_warnColor#2) - (_baseColor#2)) * _t, " \n "               ((_baseColor#3) + ((_warnColor#3) - (_baseColor#3)) * _t) * _alpha " \n "              ] " \n "             } else { " \n "              [_baseColor#0, _baseColor#1, _baseColor#2, (_baseColor#3) * _alpha] " \n "             }; " \n " " \n "             drawLine3D [ " \n "              AGLtoASL [_pt#0, _pt#1, 0], " \n "              AGLtoASL [_pt#0, _pt#1, _totalH], " \n "              _color " \n "             ]; " \n " " \n "             private _ptNext = _points select ((_i + 1) % _count); " \n " " \n "             if (_pt distance2D _ptNext < LM_AOWall_SpacingMeters * 1.5) then { " \n "              for ""_layer"" from 0 to _layers do { " \n "               private _h = _layer * _layerH; " \n "               drawLine3D [ " \n "                AGLtoASL [_pt#0, _pt#1, _h], " \n "                AGLtoASL [_ptNext#0, _ptNext#1, _h], " \n "                _color " \n "               ]; " \n "              }; " \n "             }; " \n "            }; " \n "           }]; " \n " " \n "           LM_AOWall_WarnHandle = [] spawn { " \n "            sleep 2; " \n " " \n "            while {LM_AOWall_Active} do { " \n "             private _playerPos = getPos player; " \n "             private _center   = missionNamespace getVariable [""LM_AOWall_Center"", [0,0]]; " \n "             private _sizeX    = missionNamespace getVariable [""LM_AOWall_SizeX"", 1000]; " \n "             private _sizeY    = missionNamespace getVariable [""LM_AOWall_SizeY"", 1000]; " \n "             private _rotation = missionNamespace getVariable [""LM_AOWall_Rotation"", 0]; " \n " " \n "             private _edgeDist = [_playerPos, _center, _sizeX, _sizeY, _rotation] " \n "              call LM_fnc_AOWall_distToEdge; " \n " " \n "             private _isInside = [_playerPos, _center, _sizeX, _sizeY, _rotation] " \n "              call LM_fnc_AOWall_isInsideAO; " \n " " \n "             if (LM_AOWall_WarnEnable) then { " \n "              if (!_isInside) then { " \n "               if (!LM_AOWall_PlayerOutside) then { " \n "                LM_AOWall_PlayerOutside = true; " \n "                LM_AOWall_LastWarnTime = 0; " \n "               }; " \n "               [""outside""] call LM_fnc_AOWall_showWarning; " \n "              } else { " \n "               if (LM_AOWall_PlayerOutside) then { " \n "                LM_AOWall_PlayerOutside = false; " \n "                hintSilent """"; " \n "               }; " \n " " \n "               if (_edgeDist < (LM_AOWall_WarnDist*(1/3))) then { " \n "                [""critical""] call LM_fnc_AOWall_showWarning; " \n "               } else { " \n "                if (_edgeDist < (LM_AOWall_WarnDist*(2/3))) then { " \n "                 [""warning""] call LM_fnc_AOWall_showWarning; " \n "                } else { " \n "                 if (_edgeDist < LM_AOWall_WarnDist) then { " \n "                  [""caution""] call LM_fnc_AOWall_showWarning; " \n "                 } else { " \n "                  hintSilent """"; " \n "                 }; " \n "                }; " \n "               }; " \n "              }; " \n "             }; " \n " " \n "             sleep 0.5; " \n "            }; " \n "           }; " \n "          }; " \n " " \n "          LM_fnc_removeAOBorderWall = { " \n "           LM_AOWall_Active = false; " \n " " \n "           if (LM_AOWall_DrawHandle >= 0) then { " \n "            removeMissionEventHandler [""Draw3D"", LM_AOWall_DrawHandle]; " \n "            LM_AOWall_DrawHandle = -1; " \n "           }; " \n " " \n "           if (!isNull LM_AOWall_WarnHandle) then { " \n "            terminate LM_AOWall_WarnHandle; " \n "           }; " \n " " \n "           LM_AOWall_PlayerOutside = false; " \n "           missionNamespace setVariable [""LM_AOWall_AllPoints"", [], true]; " \n "           hintSilent """"; " \n "          }; " \n " " \n " " \n "        comment ""Marker""; " \n "         _object = (([AGLtoASL [(_aoPos select 0),(_aoPos select 1),0], ""Land_HelipadEmpty_F"", 1, [0,0,0],0,{0},true] call BIS_fnc_spawnObjects) select 0); " \n "         _object setVariable [""objectArea"",[(_aoSize select 0), (_aoSize select 1), _aoRotation, false, 0]]; " \n "         if (_aoControl) then { " \n "          [_object, [], true] call BIS_fnc_moduleCoverMap; " \n " " \n "          if (_wallControl) then { " \n "           [[(_aoPos select 0),(_aoPos select 1),0], (_aoSize select 0), (_aoSize select 1), _aoRotation] call LM_fnc_AOBorderWall; " \n "          } else { " \n "           [] call LM_fnc_removeAOBorderWall; " \n "          }; " \n "         } else { " \n "          [_object, [], false] call BIS_fnc_moduleCoverMap; " \n "          [] call LM_fnc_removeAOBorderWall; " \n "         }; " \n "         deleteVehicle _object; " \n "          " \n "       }] remoteExec ['bis_fnc_call',-2,""LM_JIP_operationArea""]; " \n " " \n "       if (_aoControl) then { " \n "        systemchat format [""[ EZM Addon: AEGIS ] : Map now covered except for '%1'm by '%2'm around '%3' to designate the Operation Area! 3D boundary wall control set to '%4' and associated warning for the wall set to '%5'."", (_aoSize select 0), (_aoSize select 1), _aoPos, _wallControl, _warningControl]; " \n "       } else { " \n "        systemchat ""[ EZM Addon: AEGIS ] : Map now fully un-covered and any existing 3D boundary walls disabled!""; " \n "       }; " \n "       _display closeDisplay 1; " \n "      },{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _display closeDisplay 2; " \n "      },[]] call MAZ_EZM_fnc_createDialog; " \n "     }; " \n " " \n " " \n "    comment ""Server Message""; " \n "     LM_fnc_sendMessageModule = { " \n "      [""Send Subtitle Message"",[ " \n "       [ " \n "        ""EDIT"", " \n "        ""Sender Name"", " \n "        [missionNamespace getVariable [""EZM_senderName"",""High Command""]] " \n "       ], " \n "       [ " \n "        ""COLOR"", " \n "        ""Sender Color:"", " \n "        [missionNamespace getVariable [""LM_var_colorSender"",[side player] call BIS_fnc_sideColor]] " \n "       ], " \n "       [ " \n "        ""EDIT:MULTI"", " \n "        ""Message"", " \n "        [""Message...""] " \n "       ], " \n "       [ " \n "        ""COLOR"", " \n "        ""Message Color:"", " \n "        [missionNamespace getVariable [""LM_var_colorMessage"",[1,1,1,1]]] " \n "       ], " \n "       [ " \n "        ""SIDES"", " \n "        ""Sides Who See The Message"", " \n "        [side player] " \n "       ] " \n "      ],{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _values params [""_sender"",""_colorSender"",""_message"",""_colorMessage"",""_side""]; " \n "       private _sides = _side call LM_fnc_getSidesFromString; " \n "       _sides = _sides; " \n " " \n "       missionNamespace setVariable [""LM_var_colorSender"",_colorSender]; " \n "       _colorSender = _colorSender call BIS_fnc_colorRGBAtoHTML; " \n "       missionNamespace setVariable [""LM_var_colorMessage"",_colorMessage]; " \n "       _colorMessage = _colorMessage call BIS_fnc_colorRGBAtoHTML; " \n " " \n "       if(count _message > 300) exitWith { " \n "        [""Message too long! Cannot send, max characters is 300."",""addItemFailed""] call LM_fnc_systemMessage; " \n "       }; " \n "       _message = [_message] call MAZ_EZM_fnc_checkForBlacklistedWords; " \n "       [ " \n "        [ " \n "         format [""<t color='%3' size='2' shadow='2'>%1:</t><br/><t color='%4' size='1.75' shadow='2'>%2</t>"", _sender, _message, _colorSender, _colorMessage], " \n "         ""PLAIN DOWN"", " \n "         2, " \n "         true, " \n "         true " \n "        ] " \n "       ] remoteExec ['titleText',_sides]; " \n "       missionNamespace setVariable [""EZM_senderName"",_sender]; " \n "       _display closeDisplay 1; " \n "      },{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _display closeDisplay 2; " \n "      },[]] call MAZ_EZM_fnc_createDialog; " \n "     }; " \n " " \n " " \n "    comment ""Dynamic Simulation""; " \n "     LM_fnc_dynamicSimControlModule = { " \n "      [""Dynamic Simulation System Control"",[ " \n "       [ " \n "        ""TOOLBOX"", " \n "        [""Dynamic Simulation System Control:"",""Whether to enable or disable Dynamic Simulation globally.\n\nNOTE: It is recommended to set the below values near or the same as the current view distance!""], " \n "        [dynamicSimulationSystemEnabled,[""Disable"",""Enable""]] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""'Group':"",""Choose the distance units who can trigger Dynamic Simulation must be from 'Infantry units and groups' for the system to activate.""], " \n "        [0,(getnumber (configfile >> ""CfgWorlds"" >> worldName >> ""mapSize"")),dynamicSimulationDistance 'Group'] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""'Vehicle':"",""Choose the distance units who can trigger Dynamic Simulation must be from 'Vehicles with crew' for the system to activate.""], " \n "        [0,(getnumber (configfile >> ""CfgWorlds"" >> worldName >> ""mapSize"")),dynamicSimulationDistance 'Vehicle'] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""'EmptyVehicle':"",""Choose the distance units who can trigger Dynamic Simulation must be from 'All vehicles without crew' for the system to activate.""], " \n "        [0,(getnumber (configfile >> ""CfgWorlds"" >> worldName >> ""mapSize"")),dynamicSimulationDistance 'EmptyVehicle'] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""'Prop':"",""Choose the distance units who can trigger Dynamic Simulation must be from 'Static objects' for the system to activate.""], " \n "        [0,(getnumber (configfile >> ""CfgWorlds"" >> worldName >> ""mapSize"")),dynamicSimulationDistance 'Prop'] " \n "       ] " \n "      ],{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _values params [""_simulationControl"",""_distanceGroup"",""_distanceVehicle"",""_distanceEmpty"",""_distanceProp""]; " \n "        " \n "       [_simulationControl] remoteExec [""enableDynamicSimulationSystem"", 0, true]; " \n "       [""Group"", round (_distanceGroup)] remoteExec [""setDynamicSimulationDistance"", 0, true]; " \n "       [""Vehicle"", round (_distanceVehicle)] remoteExec [""setDynamicSimulationDistance"", 0, true]; " \n "       [""EmptyVehicle"", round (_distanceEmpty)] remoteExec [""setDynamicSimulationDistance"", 0, true]; " \n "       [""Prop"", round (_distanceProp)] remoteExec [""setDynamicSimulationDistance"", 0, true]; " \n "        " \n "       [format[""The Dynamic Simulation System has been %1. The distance for 'Group' has been set to %2, for 'Vehicle' has been set to %3, for 'EmptyVehicle' has been set to %4, for 'Prop' has been set to %5."", (if (_simulationControl) then { ""enabled"" } else { ""disabled"" }), round (_distanceGroup), round (_distanceVehicle), round (_distanceEmpty), round (_distanceProp)]] call LM_fnc_systemMessage; " \n "        " \n "       _display closeDisplay 1; " \n "      },{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _display closeDisplay 2; " \n "      },[]] call MAZ_EZM_fnc_createDialog; " \n "     }; " \n "      " \n "     LM_fnc_dynamicSimObjectModule = { " \n "      params [""_entity""]; " \n "      if (_entity isEqualTo objNull) exitWith {[""No object or group selected."",""addItemFailed""] call LM_fnc_systemMessage;}; " \n "      if ((((_entity call BIS_fnc_objectType) select 0) == ""Logic"")) exitWith {[""Please do not select any modules or logic."",""addItemFailed""] call LM_fnc_systemMessage;}; " \n "       " \n "      if ((if (!(_entity isEqualType (group player))) then {!(simulationEnabled _entity) and !(dynamicSimulationEnabled _entity)})) exitWith {[""Enable normal simulation on the object or group first in order to enable Dynamic Simulation for it."",""addItemFailed""] call LM_fnc_systemMessage;}; " \n "      if ((if (!(_entity isEqualType (group player))) then {count (crew _entity) > 0})) exitWith {[""Please only use this on a empty object or the object's group!"",""addItemFailed""] call LM_fnc_systemMessage;}; " \n " " \n "      if (dynamicSimulationEnabled _entity) then { " \n "       [_entity, false] remoteExec [""enableDynamicSimulation"", 0, true]; " \n "       [""Dynamic Simulation disabled.""] call LM_fnc_systemMessage; " \n "      } else { " \n "       [_entity, true] remoteExec [""enableDynamicSimulation"", 0, true]; " \n "       [""Dynamic Simulation enabled.""] call LM_fnc_systemMessage; " \n "      }; " \n "      playSound ""addItemOk""; " \n "     }; " \n "      " \n "     LM_fnc_dynamicSimRadiusModule = { " \n "      private _pos = [] call MAZ_EZM_fnc_getScreenPosition; " \n "      [""Toggle Object Dynamic Simulation (Radius)"",[ " \n "       [ " \n "        ""TOOLBOX"", " \n "        [""Dynamic Simulation Control:"",""Whether to enable or disable Dynamic Simulation for groups and objects within the radius.""], " \n "        [true,[""Disable"",""Enable""]] " \n "       ], " \n "       [ " \n "        ""SLIDER:RADIUS"", " \n "        [""Radius:"",""Choose a radius to select objecst within.""], " \n "        [0,(getnumber (configfile >> ""CfgWorlds"" >> worldName >> ""mapSize"")),250,_pos,[1,1,1,1]] " \n "       ] " \n "      ],{ " \n "       params [""_values"",""_pos"",""_display""]; " \n "       _values params [""_simulationControl"",""_radius""]; " \n "       _nearObjs = [_pos,_radius] call JAM_fnc_getEditableObjs_radius; " \n "        " \n "       _count = 0; " \n "       { " \n "        if (!((if (!(_x isEqualType (group player))) then {!(simulationEnabled _x) and !(dynamicSimulationEnabled _x)}) || (if (!(_x isEqualType (group player))) then {count (crew _x) > 0})) and !(((_x call BIS_fnc_objectType) select 0) == ""Logic"")) then { " \n "         [_x, _simulationControl] remoteExec [""enableDynamicSimulation"", 0, true]; " \n "         _count = _count + 1; " \n "        }; " \n "       } forEach _nearObjs; " \n "        " \n "       [format[""Dynamic Simulation %1 for %2 groups and objects."", (if (_simulationControl) then { ""enabled"" } else { ""disabled"" }), _count]] call LM_fnc_systemMessage; " \n "        " \n "       _display closeDisplay 1; " \n "      },{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _display closeDisplay 2; " \n "      },_pos] call MAZ_EZM_fnc_createDialog; " \n "     }; " \n "      " \n "     LM_fnc_dynamicSimGlobalModule = { " \n "      private _pos = [] call MAZ_EZM_fnc_getScreenPosition; " \n "      [""Toggle Object Dynamic Simulation (Global)"",[ " \n "       [ " \n "        ""TOOLBOX"", " \n "        [""Global Dynamic Simulation:"",""Whether to enable or disable Dynamic Simulation for all groups and objects on the map at once.""], " \n "        [true,[""Disable"",""Enable""]] " \n "       ] " \n "      ],{ " \n "       params [""_values"",""_pos"",""_display""]; " \n "       _values params [""_simulationControl"",""_radius""]; " \n "       _curatorObjs = []; " \n "       { " \n "        { " \n "         if (!(_x in _curatorObjs) and !(((_x call BIS_fnc_objectType) select 0) == ""Logic"")) then { " \n "          _curatorObjs append [_x]; " \n "         }; " \n "        } forEach curatorEditableObjects _x; " \n "       } forEach allCurators; " \n "       _curatorObjs = _curatorObjs arrayIntersect _curatorObjs; " \n "        " \n "       { " \n "        if (!((if (!(_x isEqualType (group player))) then {!(simulationEnabled _x) and !(dynamicSimulationEnabled _x)}) || (if (!(_x isEqualType (group player))) then {count (crew _x) > 0}))) then { " \n "         [_x, _simulationControl] remoteExec [""enableDynamicSimulation"", 0, true]; " \n "         [(vehicle _x), _simulationControl] remoteExec [""enableDynamicSimulation"", 0, true]; " \n "         [(group _x), _simulationControl] remoteExec [""enableDynamicSimulation"", 0, true]; " \n "        }; " \n "       } forEach _curatorObjs; " \n "        " \n "       _simCode = """"; " \n "       if (_simulationControl) then { " \n "        _simCode =  (str { " \n "         removeMissionEventHandler [""EntityCreated"", (player getVariable [""LM_MEH_globalSim"", -1])]; " \n "         _varMEH = addMissionEventHandler [""EntityCreated"", { " \n "          params [""_object""]; " \n "          if (!(((_object call BIS_fnc_objectType) select 0) == ""Logic"")) then { " \n "           [_object, true] remoteExec [""enableDynamicSimulation"", 0, true]; " \n "           [(vehicle _object), true] remoteExec [""enableDynamicSimulation"", 0, true]; " \n "           [(group _object), true] remoteExec [""enableDynamicSimulation"", 0, true]; " \n "          }; " \n "         }]; " \n "         player setVariable [""LM_MEH_globalSim"", _varMEH]; " \n "         (findDisplay 312) displayRemoveEventHandler [""KeyDown"", _thisEventHandler]; " \n "        }) splitString """"; " \n "       } else { " \n "        _simCode =  (str { " \n "         removeMissionEventHandler [""EntityCreated"", (player getVariable [""LM_MEH_globalSim"", -1])]; " \n "         (findDisplay 312) displayRemoveEventHandler [""KeyDown"", _thisEventHandler]; " \n "        }) splitString """"; " \n "       }; " \n "       _simCode deleteAt (count _simCode - 1); " \n "       _simCode deleteAt 0; " \n "       missionNamespace setVariable [""LM_fnc_globalSimVariable"",_simCode,true]; " \n "       [[],{ " \n "        waitUntil {!isNull (findDisplay 312) && alive player}; " \n "        (findDisplay 312) displayAddEventHandler [""KeyDown"", ((missionNamespace getVariable ""LM_fnc_globalSimVariable"") joinString """")]; " \n "       }] remoteExec [""bis_fnc_call"", 0, ""LM_JIP_globalSim""]; " \n "        " \n "       [format[""Global Dynamic Simulation for all objects on map %1."", (if (_simulationControl) then { ""enabled"" } else { ""disabled"" })]] call LM_fnc_systemMessage; " \n "        " \n "       _display closeDisplay 1; " \n "      },{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _display closeDisplay 2; " \n "      },_pos] call MAZ_EZM_fnc_createDialog; " \n "     }; " \n " " \n " " \n "    comment ""Scale Static Object""; " \n "     LM_fnc_objectSizeModule = { " \n "      params [""_entity""]; " \n "      if(isNull _entity) exitWith {[""You must place this on a object or unit!"",""addItemFailed""] call LM_fnc_systemMessage;}; " \n "      [format[""Scale Static Object - '%1'"", getText (configfile >> ""CfgVehicles"" >> (typeOf _entity) >> ""displayname"")],[ " \n "       [ " \n "        ""SLIDER"", " \n "        [""Select Size:"",""Select the size to change the object to (Object muust be attached to another object).""], " \n "        [0.0001,100,2] " \n "       ] " \n "      ],{ " \n "       params [""_values"",""_entity""]; " \n "       _values params [""_size""]; " \n "        " \n "       if (isNull attachedTo _entity) then { " \n "        _parentObj = (([[_entity, ""BOTTOM""], ""Land_HelipadEmpty_F"", 1, [0,0,0],0,{0},true] call BIS_fnc_spawnObjects) select 0); " \n "        [_entity,_parentObj] call BIS_fnc_attachToRelative; " \n "        [_parentObj] call MAZ_EZM_fnc_addObjectToInterface; " \n "        systemchat format [""[ EZM Addon: AEGIS ] : Object has been auto-attached to a invisible helipad due to not being already attached to another object!"", _size]; " \n "       }; " \n "       _entity setObjectScale _size; " \n "       systemchat format [""[ EZM Addon: AEGIS ] : Object size scaled to '%1'!"", _size]; " \n "       _display closeDisplay 1; " \n "      },{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _display closeDisplay 2; " \n "      },_entity] call MAZ_EZM_fnc_createDialog; " \n "     }; " \n " " \n " " \n "    comment ""Build Menu""; " \n "     LM_fnc_buildMenuModule = { " \n "      params [""_entity""]; " \n " " \n "      if(isNull _entity || !((typeOf _entity) isKindOf ""Man"") || !(isPlayer _entity)) exitWith { " \n "       [""Build Menu Control"",[ " \n "        [ " \n "         ""TOOLBOX:ENABLED"", " \n "         [""Category Access - Buildings:"",""Control access to the Build Menu objects category 'Buildings' for all players.""], " \n "         [(profileNamespace getVariable [""LM_var_buildMenuBuildings"",true])] " \n "        ], " \n "        [ " \n "         ""TOOLBOX:ENABLED"", " \n "         [""Category Access - Bunkers:"",""Control access to the Build Menu objects category 'Bunkers' for all players.""], " \n "         [(profileNamespace getVariable [""LM_var_buildMenuBunkers"",true])] " \n "        ], " \n "        [ " \n "         ""TOOLBOX:ENABLED"", " \n "         [""Category Access - Barricades:"",""Control access to the Build Menu objects category 'Barricades' for all players.""], " \n "         [(profileNamespace getVariable [""LM_var_buildMenuBarricades"",true])] " \n "        ], " \n "        [ " \n "         ""TOOLBOX:ENABLED"", " \n "         [""Category Access - Statics:"",""Control access to the Build Menu objects category 'Statics' for all players.""], " \n "         [(profileNamespace getVariable [""LM_var_buildMenuStatics"",true])] " \n "        ], " \n "        [ " \n "         ""TOOLBOX:ENABLED"", " \n "         [""Category Access - Supplies:"",""Control access to the Build Menu objects category 'Supplies' for all players.""], " \n "         [(profileNamespace getVariable [""LM_var_buildMenuSupplies"",true])] " \n "        ], " \n "        [ " \n "         ""TOOLBOX:ENABLED"", " \n "         [""Category Access - Lights:"",""Control access to the Build Menu objects category 'Lights' for all players.""], " \n "         [(profileNamespace getVariable [""LM_var_buildMenuLights"",true])] " \n "        ], " \n "        [ " \n "         ""TOOLBOX:ENABLED"", " \n "         [""Category Access - Flags:"",""Control access to the Build Menu objects category 'Flags' for all players.""], " \n "         [(profileNamespace getVariable [""LM_var_buildMenuFlags"",true])] " \n "        ] " \n "       ],{ " \n "        params [""_values"",""_entity"",""_display""]; " \n "        _values params [""_controlBuildings"", ""_controlBunkers"", ""_controlBarricades"", ""_controlStatics"", ""_controlSupplies"", ""_controlLights"", ""_controlFlags""]; " \n " " \n "        profileNamespace setVariable [""LM_var_buildMenuBuildings"",_controlBuildings]; " \n "        profileNamespace setVariable [""LM_var_buildMenuBunkers"",_controlBunkers]; " \n 