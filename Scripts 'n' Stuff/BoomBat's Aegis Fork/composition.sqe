EH_SpaceChair = (findDisplay 46) displayAddEventHandler [""KeyDown"", { " \n "         params [""_display"", ""_key"", ""_shift"", ""_ctrl"", ""_alt""]; " \n " " \n "         private _handled = false; " \n " " \n "         private _keybind = profileNamespace getVariable [""LM_KB_sitChairs"", 57]; " \n "         if ((_key == _keybind) && (!_ctrl)) then { " \n "           " \n "          if (isNull (player getVariable [""LM_currentChair"", objNull])) then { " \n "            " \n "           private _nearObjects = nearestObjects [player, [], 1.25]; " \n "            " \n "           private _foundChair = objNull; " \n "           { " \n "            private _type = toLower (typeOf _x); " \n "            if (((_type find ""chair"" > -1) || (_type find ""bench"" > -1)) && ((_type find ""folded"" <= -1)) && ((_type find ""work"" <= -1)) && ((_type find ""pod"" <= -1))) exitWith { " \n "             _foundChair = _x; " \n "            }; " \n "           } forEach _nearObjects; " \n " " \n "           if (!isNull _foundChair) then { " \n "             " \n "            player setVariable [""LM_currentChair"", _foundChair]; " \n "            player setVariable [""LM_Chair_RelRot"", 180];  " \n "             " \n "            [player, _foundChair] spawn { " \n "             params [""_unit"", ""_chair""]; " \n "              " \n "             _unit allowDamage false; " \n "              " \n "             _unit setPosASL (getPosASL _chair); " \n "              " \n "             [_unit, selectRandom [ " \n "              ""hubsittingchaira_idle1"",""hubsittingchaira_idle2"",""hubsittingchaira_idle3"", " \n "              ""hubsittingchairb_idle1"",""hubsittingchairb_idle2"",""hubsittingchairb_idle3"", " \n "              ""hubsittingchairc_idle1"",""hubsittingchairc_idle2"",""hubsittingchairc_idle3"" " \n "             ]] remoteExec [""switchMove"", 0]; " \n " " \n "             _unit attachTo [_chair, [0, -0.1, -0.5]];  " \n "              " \n "             private _pb = _chair call BIS_fnc_getPitchBank; " \n "             [_unit, [180, _pb select 0, _pb select 1]] call BIS_fnc_setObjectRotation; " \n "            }; " \n " " \n "            systemChat ""[ EZM Addon: AEGIS ] : Press 'W' to exit, move mouse left or right to rotate.""; " \n " " \n "            LM_fnc_exitChair = (findDisplay 46) displayAddEventHandler [""KeyDown"", { " \n "             params [""_display"", ""_key""]; " \n "             if (_key == 17) then { " \n "              private _chair = player getVariable [""LM_currentChair"", objNull]; " \n " " \n "              (findDisplay 46) displayRemoveEventHandler [""KeyDown"", uiNamespace getVariable [""LM_EH_ExitId"", -1]]; " \n "              (findDisplay 46) displayRemoveEventHandler [""MouseMoving"", uiNamespace getVariable [""LM_EH_RotateId"", -1]]; " \n "               " \n "              player allowDamage true; " \n "              detach player; " \n "              [player, """"] remoteExec ['switchMove', 0]; " \n "              player setVariable [""LM_currentChair"", objNull]; " \n "              player setVariable [""LM_Chair_RelRot"", nil]; " \n " " \n "              if (!isNull _chair) then { " \n "               private _bBox = boundingBoxReal _chair; " \n "               private _min = _bBox select 0; " \n "               private _yMin = _min select 1;  " \n "               private _exitPos = _chair modelToWorld [0, _yMin - 0.5, 0]; " \n "                " \n "               _exitPos set [2, (getPosASL player) select 2]; " \n "               player setPosASL _exitPos; " \n "              }; " \n "             }; " \n "            }]; " \n "            uiNamespace setVariable [""LM_EH_ExitId"", LM_fnc_exitChair]; " \n " " \n "            LM_fnc_rotateChair = (findDisplay 46) displayAddEventHandler [""MouseMoving"", { " \n "             params [""_display"", ""_deltaX"", ""_deltaY""]; " \n "              " \n "             private _rotationSpeed = 0.15; " \n "              " \n "             if (_deltaX != 0) then { " \n "              private _currentRelRot = player getVariable [""LM_Chair_RelRot"", 180]; " \n "              private _newDir = _currentRelRot + (_deltaX * _rotationSpeed); " \n "               " \n "              player setVariable [""LM_Chair_RelRot"", _newDir]; " \n " " \n "              private _chair = attachedTo player; " \n "              if (!isNull _chair) then { " \n "               private _pb = _chair call BIS_fnc_getPitchBank; " \n "               [player, [_newDir, _pb select 0, _pb select 1]] call BIS_fnc_setObjectRotation; " \n "              }; " \n "             }; " \n "            }]; " \n "            uiNamespace setVariable [""LM_EH_RotateId"", LM_fnc_rotateChair]; " \n " " \n "            _handled = true; " \n "           }; " \n "          }; " \n "         }; " \n " " \n "         _handled " \n "        }]; " \n " " \n "        player setVariable [""LM_EH_SpaceChair"", LM_EH_SpaceChair, true]; " \n "       }] remoteExec [""bis_fnc_call"", 0, ""LM_JIP_sitChairs""]; " \n "       systemchat format[""[ EZM Addon: AEGIS ] : Pressing '%1' when near a chair or bench to sit enabled"", keyName (profileNamespace getVariable [""LM_KB_sitChairs"", 57])]; " \n " " \n "       missionNamespace setVariable [""LM_init_sitChairs"", true, true]; " \n "      }; " \n " " \n " " \n "     comment ""Disable Stamina""; " \n "      if ((profileNamespace getVariable [""LM_init_disableStamina"", true]) && " \n "       !(missionNamespace getVariable [""LM_init_disableStamina"", false])) then { " \n " " \n "       [[], { " \n "        private _var = player getVariable ""QQ_respawnStaminaHandler""; " \n "        if (isNil ""_var"") then " \n "        { " \n "         waitUntil { sleep 0.5; alive player && !(isNull findDisplay 46) };  " \n "          player enableStamina false;  " \n " " \n "          _eh = player addEventHandler [""Respawn"", {  " \n "          player enableStamina false;  " \n "         }];  " \n "         player setVariable [""QQ_respawnStaminaHandler"", _eh, true]; " \n "        }; " \n "       }] remoteExec [""bis_fnc_call"", 0, ""LM_JIP_disableStamina""]; " \n "       systemchat ""[ EZM Addon: AEGIS ] : Stamina disabled for all players""; " \n " " \n "       missionNamespace setVariable [""LM_init_disableStamina"", true, true]; " \n "      }; " \n " " \n " " \n "     comment ""Enable Spectating""; " \n "      if ((profileNamespace getVariable [""LM_init_enableSpec"", true]) && " \n "       !(missionNamespace getVariable [""LM_init_enableSpec"", false])) then { " \n " " \n "       [[], { " \n "        with uiNamespace do {  " \n "         waitUntil {sleep 0.01; !isNull (findDisplay 12 displayCtrl 88811)};  " \n " " \n "         missionNamespace setVariable ['BIS_respSpecAI', true];  " \n "         missionNamespace setVariable ['BIS_respSpecAllowFreeCamera', true];  " \n "         missionNamespace setVariable ['BIS_respSpecAllow3PPCamera', true];  " \n "         missionNamespace setVariable ['BIS_respSpecShowFocus', true];  " \n "         missionNamespace setVariable ['BIS_respSpecShowCameraButtons', true];  " \n "         missionNamespace setVariable ['BIS_respSpecShowControlsHelper', true];  " \n "         missionNamespace setVariable ['BIS_respSpecShowHeader', true];  " \n "         missionNamespace setVariable ['BIS_respSpecLists', true];  " \n "         player setVariable [""AllowAi"", true];   " \n "         player setVariable [""AllowFreeCamera"", true];   " \n "         player setVariable [""Allow3PPCamera"", true];   " \n "         player setVariable [""ShowFocusInfo"", true];   " \n "         player setVariable [""ShowCameraButtons"", true];   " \n "         player setVariable [""ShowControlsHelper"", true];   " \n "         player setVariable [""ShowHeader"", true];   " \n "         player setVariable [""ShowLists"", true];   " \n "         player setVariable [""WhitelistedSides"", ([west, east, independent, civilian] select { (((side (group player)) getFriend _x) >= 0.6) }) apply { str _x }];   " \n " " \n "         private _respawnButton = (findDisplay 12 displayCtrl 88811); " \n "         _respawnButton ctrlEnable true; " \n "         _respawnButton ctrlSetTooltip ""Spectate via Freecam or any Friendly Units""; " \n "         _respawnButton ctrlSetBackgroundColor [(profileNamespace getVariable ['GUI_BCG_RGB_R', 0.5]),(profileNamespace getVariable ['GUI_BCG_RGB_G', 0.5]),(profileNamespace getVariable ['GUI_BCG_RGB_B', 0.5]),(profileNamespace getVariable ['GUI_BCG_RGB_A', 1])]; " \n "         _respawnButton ctrlCommit 0;  " \n "        }; " \n "       }] remoteExec [""bis_fnc_call"", 0, ""LM_JIP_enableSpec""]; " \n "       systemChat ""[ EZM Addon: AEGIS ] : Spectator button on respawn screen enabled""; " \n " " \n "       missionNamespace setVariable [""LM_init_enableSpec"", true, true]; " \n "      }; " \n " " \n " " \n "     comment ""Respawn Loadouts""; " \n "      if ((profileNamespace getVariable [""LM_init_respawnLoadouts"", true]) && " \n "       !(missionNamespace getVariable [""LM_init_respawnLoadouts"", false])) then { " \n " " \n "       [] spawn { " \n "        private _sideMap = [east, west, resistance, civilian]; " \n "        { " \n "         private _class = configName _x; " \n "          " \n "         if ((_class isKindOf ""Man"") && { getNumber (_x >> ""scope"") == 2 }) then { " \n "           " \n "          private _sideID = getNumber (_x >> ""side""); " \n " " \n "          if ((_sideID >= 0) && (_sideID <= 3)) then { " \n "           private _targetSide = _sideMap select _sideID; " \n "           [_targetSide, _class] call BIS_fnc_addRespawnInventory; " \n "          }; " \n "         }; " \n "        } forEach (""true"" configClasses (configFile >> ""CfgVehicles"")); " \n "        [getAssignedCuratorLogic player, true] call BIS_fnc_moduleRespawnInventory; " \n " " \n "        systemChat ""[ EZM Addon: AEGIS ] : All CfgVehicles loadouts for each side added to their respective respawn loadouts""; " \n "       }; " \n " " \n "       missionNamespace setVariable [""LM_init_respawnLoadouts"", true, true]; " \n "      }; " \n " " \n " " \n "     comment ""Quick Respawn Timer""; " \n "      if ((profileNamespace getVariable [""LM_init_quickRespawnTimer"", true]) && " \n "       !(missionNamespace getVariable [""LM_init_quickRespawnTimer"", false])) then { " \n " " \n "       private _timer = 1; " \n "       MAZ_EZM_respawnTimer = _timer + 5; " \n "       publicVariable 'MAZ_EZM_respawnTimer'; " \n "       [[],{ " \n "        if(!isNil ""MAZ_EZM_respawnTimerEH"") then { " \n "         player removeEventHandler [""Respawn"",MAZ_EZM_respawnTimerEH]; " \n "        }; " \n "        setPlayerRespawnTime MAZ_EZM_respawnTimer; " \n "        MAZ_EZM_respawnTimerEH = player addEventHandler [""Respawn"",{ " \n "         [] spawn { " \n "          sleep 3; " \n "          setPlayerRespawnTime MAZ_EZM_respawnTimer; " \n "         }; " \n "        }]; " \n "       }] remoteExec ['spawn',0,'LM_JIP_quickRespawnTimer']; " \n " " \n "       missionNamespace setVariable [""LM_init_quickRespawnTimer"", true, true]; " \n "      }; " \n " " \n " " \n "     comment ""Zeus Ping Prompt""; " \n "      if ((profileNamespace getVariable [""LM_init_zeusPingPrompt"", true]) && " \n "       !(missionNamespace getVariable [""LM_init_zeusPingPrompt"", false])) then { " \n " " \n "       { " \n "        { " \n "         private _zeusLogic = _x; " \n "         _zeusLogic removeAllEventHandlers ""CuratorPinged""; " \n "         _zeusLogic addEventHandler [""CuratorPinged"", { " \n "          params [""_curator"", ""_player""]; " \n " " \n "          [""Zeus Pinged"", [""ZEUS INFORMED:"",  " \n "          ""The Zeus has been informed of your ping, communicate with them via voice or text to coordinate actions."",  " \n "          ""DISCLAIMER:"",  " \n "          ""By pressing continue you agree to not abuse this action, understanding you may be kicked if you do not.""]] remoteExec [""hintC"", _player]; " \n "           " \n "          systemChat format[""[ EZM Addon: AEGIS ] : Be aware, player '%1' has pinged Zeus."", name _player]; " \n "         }]; " \n "        } foreach allCurators; " \n "       } remoteExec [""bis_fnc_call"",0,""LM_JIP_zeusPingPrompt""]; " \n "       systemChat ""[ EZM Addon: AEGIS ] : Extra logging when curator pinged enabled.""; " \n " " \n "       missionNamespace setVariable [""LM_init_zeusPingPrompt"", true, true]; " \n "      }; " \n " " \n "    }; " \n " " \n " " \n "  }; " \n " " \n " " \n " comment ""Addons Frontend""; " \n "  LM_fnc_editCuratorInterface = { " \n "   with uiNamespace do { " \n "    [] spawn { " \n "     comment ""UI Population Variable Resets""; " \n "      currentlyPopulatingZECComps = false; " \n "      currentlyPopulatingDynamicTasks = false; " \n " " \n " " \n "     comment ""Modules""; " \n "      comment ""Category - Objectives""; " \n "       comment ""Category"";  " \n "        if (profileNamespace getVariable [""LM_init_objType"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [7], " \n "          """", " \n "          ""[ Placeholder ]"", " \n "          LM_themeColor, " \n "          """", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "       comment ""Modules"";  " \n "        if (profileNamespace getVariable [""LM_init_objType"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [7], " \n "          ""Objective Type"", " \n "          ""Allows you to set a custom icon for a placed objective by changing its type."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\A3\ui_f\data\igui\cfg\simpleTasks\types\default_ca.paa"", " \n "          [], " \n "          ""LM_fnc_objectiveIconModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "        }; " \n " " \n "        if (profileNamespace getVariable [""LM_init_objType"", true]) then { " \n "         MAZ_zeusModulesTree tvSort [[7], false]; " \n "        }; " \n " " \n "       " \n "      comment ""Category - Enhanced Zeus Modules""; " \n "       comment ""Modules"";  " \n "        [ " \n "         MAZ_zeusModulesTree, " \n "         [MAZ_EZMLabelTree], " \n "         format[""AEGIS Addon - %1"", (missionNamespace getVariable ['LM_AEGIS_Version',''])], " \n "         ""Further enabling Public Zeus's worldwide, a 'Lockheed Martin' production.\n\nJoin the conversation, help expand the addon:\n• https://discord.gg/XXXX\n\nPlace this module for script credits, press OK to open the dashboard!"", " \n "         LM_themeColor, " \n "         """", " \n "         [], " \n "         ""\A3\Ui_f\data\GUI\Cfg\UnitInsignia\TFAegis_ca.paa"", " \n "         [], " \n "         ""LM_fnc_creditsModule"", " \n "         sideLogic " \n "        ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "       " \n "       " \n "      comment ""Category - AI Modifiers""; " \n "       comment ""Category"";  " \n "        if ((profileNamespace getVariable [""LM_init_ambAnimation"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_headLamp"", true]) ||  " \n "         (missionNamespace getVariable [""LM_init_headLamp"", false])) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_EditAITree], " \n "          """", " \n "          ""[ Placeholder ]"", " \n "          LM_themeColor, " \n "          """", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "       comment ""Modules"";  " \n "        if (profileNamespace getVariable [""LM_init_ambAnimation"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_EditAITree, 8], " \n "          """", " \n "          """", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          """", " \n "          [], " \n "          ""LM_fnc_setAnimationModule"" " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "        if ((profileNamespace getVariable [""LM_init_headLamp"", true]) ||  " \n "         (missionNamespace getVariable [""LM_init_headLamp"", false])) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_EditAITree], " \n "          ""Head Lamp"", " \n "          ""Places a light mounted above the right ear of the selected man."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\3den\data\displays\display3den\toolbar\flashlight_off_ca.paa"", " \n "          [], " \n "          ""LM_fnc_headLampModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "        }; " \n " " \n "        if (profileNamespace getVariable [""LM_init_forceSpeed"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_EditAITree], " \n "          ""Force Speed Limit"", " \n "          ""Set the top speed of the selected AI driven/piloted vehicle."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\ui_f\data\igui\cfg\simpletasks\types\car_ca.paa"", " \n "          [], " \n "          ""LM_fnc_forceSpeedModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "        }; " \n " " \n "        if ((profileNamespace getVariable [""LM_init_ambAnimation"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_headLamp"", true]) ||  " \n "         (missionNamespace getVariable [""LM_init_headLamp"", false])) then { " \n "         MAZ_zeusModulesTree tvSort [[MAZ_EditAITree], false]; " \n "        }; " \n " " \n " " \n "      comment ""Category - Arsenal Creator""; " \n "       comment ""Category"";  " \n "        if (profileNamespace getVariable [""LM_init_arsenalRestrict"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_ArsenalTree], " \n "          """", " \n "          ""[ Placeholder ]"", " \n "          LM_themeColor, " \n "          """", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "       comment ""Modules"";  " \n "        if (profileNamespace getVariable [""LM_init_arsenalRestrict"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_ArsenalTree, 0], " \n "          """", " \n "          ""----------------------------------------------------------------------------------------------------------------------------------------------------------------------\nAll-In-One Arsenal (by M9-SD)\n----------------------------------------------------------------------------------------------------------------------------------------------------------------------\n\nDescription:\n There are two ways to use this module:\n(1) Place onto another object to make it an AIO arsenal.\n(2) Place on ground to spawn supply box AIO arsenal.\n\nIncludes the following options:\n- Full Arsenal\n- Quick Rearm\n- Copy Loadout\n- Empty Loadout\n- Delete Respawn Loadout\n- Edit Group Loadouts\n\n* Warning: Incompatible with full arsenal by Expung3d."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          """", " \n "          [], " \n "          ""LM_fnc_createArsenalModule"" " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n " " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_ArsenalTree], " \n "          ""Arsenal Restrictions"", " \n "          ""Restrict a side to a set of arsenal loadouts based on sides."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\A3\ui_f\data\Logos\a_64_ca.paa"", " \n "          [], " \n "          ""LM_fnc_arsenalRestrictionsModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "        }; " \n " " \n "        if (profileNamespace getVariable [""LM_init_arsenalRestrict"", true]) then { " \n "         MAZ_zeusModulesTree tvSort [[MAZ_ArsenalTree], false]; " \n "        }; " \n " " \n " " \n "      comment ""Category - Automatic Missions""; " \n "       comment ""Category"";  " \n "        if ((profileNamespace getVariable [""LM_init_autoGarrisonArea"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_dynTasks"", true])) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_AutoMissionTree], " \n "          """", " \n "          ""[ Placeholder ]"", " \n "          LM_themeColor, " \n "          """", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "       comment ""Modules"";  " \n "        if (profileNamespace getVariable [""LM_init_autoGarrisonArea"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_AutoMissionTree, 0], " \n "          ""Toggle Auto Heli Crash Missions"" " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n " " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_AutoMissionTree, 1], " \n "          ""Toggle Auto Convoy Missions"" " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n " " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_AutoMissionTree, 2], " \n "          ""Auto Garrison Area"", " \n "          ""Automatically garrisons a named town or the location where the module is placed.\nIf placing over water it is recommended to use only Garrisons not Patrols."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          """", " \n "          [], " \n "          ""LM_fnc_createGarrisonDialog"" " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "        if (profileNamespace getVariable [""LM_init_dynTasks"", true]) then { " \n "         LM_DynamicTasksTree = [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_AutoMissionTree], " \n "          ""Dynamic Tasks Framework"", " \n "          ""A framework built around the placement of 'Zones/Sectors', said are automatically populated with reaction QRF, IEDs, structures, interiors, and even tasks."", " \n "          LM_themeColor, " \n "          ""\A3\ui_f\data\map\markers\nato\o_installation.paa"", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "          " \n "         currentlyPopulatingDynamicTasks = true; " \n "         while {currentlyPopulatingDynamicTasks} do { " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Initialization"", " \n "           ""Run this module first in order to populate the world and provide the server the required functions."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\a3\3den\data\cfgwaypoints\scripted_ca.paa"", " \n "           [], " \n "           ""LM_fnc_dynamicTasks"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Populate World"", " \n "           ""Spawn a specified amount of new Zones across the world in random positions."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\a3\modules_f\data\hideterrainobjects\icon_ca.paa"", " \n "           [], " \n "           ""LM_fnc_populateWorld"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone Spawn"", " \n "           ""Spawn a new Zone at the specified non-water location."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\A3\ui_f\data\map\markers\nato\o_installation.paa"", " \n "           [], " \n "           ""LM_fnc_zoneSpawn"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone Populate"", " \n "           ""Populate an existing Zone with units for the corresponding side."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\a3\ui_f_curator\data\displays\rscdisplaycurator\modegroups_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zonePopulate"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone Emplacement"", " \n "           ""Spawn a Static/Support/Site emplacement within an existing Zone."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\a3\modules_f\data\editterrainobject\icon_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zoneEmplacement"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone Roadblock"", " \n "           ""Spawn a Roadblock near an existing Zone."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\a3\static_f_oldman\hmg_02\data\ui\icon_hmg_02_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zoneRoadblock"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone Garrison"", " \n "           ""Spawn Garrisons of units within an existing Zone."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\getin_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zoneGarrison"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone Militarise"", " \n "           ""Spawn Garrisons of units within Military structures within an existing Zone."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\a3\ui_f\data\gui\cfg\communicationmenu\attack_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zoneMilitarise"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone Patrols"", " \n "           ""Spawn Patrols of units within an existing Zone."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\run_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zonePatrols"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone QRF"", " \n "           ""Spawn Quick Reaction Forces of units to move to an existing Zone."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\a3\air_f\heli_light_01\data\ui\map_heli_light_01_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zoneQRF"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone IEDs"", " \n "           ""Spawn IEDs within an existing Zone."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\destroy_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zoneIED"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone Paratroopers"", " \n "           ""Spawn Helos with Paratroopers to jump at an existing Zone."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\a3\air_f_beta\parachute_01\data\ui\portrait_parachute_01_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zonePara"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Zone Task"", " \n "           ""Spawn a Task within an existing Zone."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\a3\modules_f_curator\data\portraitobjectivemove_ca.paa"", " \n "           [], " \n "           ""LM_fnc_zoneTask"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "           " \n "          [ " \n "           MAZ_zeusModulesTree, " \n "           [LM_DynamicTasksTree select 0, LM_DynamicTasksTree select 1], " \n "           ""Change Task Status"", " \n "           ""Set the status of a Task to Succeeded or Failed."", " \n "           LM_themeColor, " \n "           """", " \n "           [], " \n "           ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\whiteboard_ca.paa"", " \n "           [], " \n "           ""LM_fnc_taskStatus"", " \n "           sideLogic " \n "          ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n " " \n "          currentlyPopulatingDynamicTasks = false; " \n "         }; " \n "        }; " \n " " \n " " \n "      comment ""Category - Building Interiors""; " \n "       comment ""Category"";  " \n "        if ((profileNamespace getVariable [""LM_init_autoGarrisonArea"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_dynTasks"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_zeiCustomInt"", true])) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_BuildingInteriorsTree], " \n "          """", " \n "          ""[ Placeholder ]"", " \n "          LM_themeColor, " \n "          """", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "       comment ""Modules"";  " \n "        if ((profileNamespace getVariable [""LM_init_autoGarrisonArea"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_dynTasks"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_zeiCustomInt"", true])) then { " \n "         LM_ZEITree = [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_BuildingInteriorsTree], " \n "          ""ZEI - Custom Interiors"", " \n "          ""Handcrafted interiors spawnable within buildings of a specified area of a\nspecified category."", " \n "          LM_themeColor, " \n "          ""\a3\modules_f\data\editterrainobject\icon_ca.paa"", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "          " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [LM_ZEITree select 0, LM_ZEITree select 1], " \n "          ""Spawn ZEI Building Interiors"", " \n "          ""Spawn a custom ZEI interior for the % of buildings within the affected radius or provided town."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\ui_f\data\igui\cfg\actions\open_door_ca.paa"", " \n "          [], " \n "          ""LM_fnc_spawnZEIBuildingInteriorsModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "          " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [LM_ZEITree select 0, LM_ZEITree select 1], " \n "          ""Remove ZEI Building Interiors"", " \n "          ""Remove any custom ZEI interiors inside the buildings of the affected radius or provided town."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\3den\data\displays\display3den\panelleft\entitylist_delete_ca.paa"", " \n "          [], " \n "          ""LM_fnc_removeZEIBuildingInteriorsModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "        }; " \n " " \n " " \n "      comment ""Category - Cinematics""; " \n "       comment ""Category"";  " \n "        if ((profileNamespace getVariable [""LM_init_cinematicIntro"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_fadeInIntro"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_phaseTrans"", true])) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_Cinematics], " \n "          """", " \n "          ""[ Placeholder ]"", " \n "          LM_themeColor, " \n "          """", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "       comment ""Modules"";  " \n "        if (profileNamespace getVariable [""LM_init_cinematicIntro"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_Cinematics], " \n "          ""Cinematic Intro"", " \n "          ""Show a brief cinematic screen with mission introduction then pan over a\nlocation or in front of your player."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\ui_f\data\gui\cfg\keyframeanimation\iconcamera_ca.paa"", " \n "          [], " \n "          ""LM_fnc_cinematicIntroModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "        }; " \n " " \n "        if (profileNamespace getVariable [""LM_init_fadeInIntro"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_Cinematics], " \n "          ""Fade-In Intro"", " \n "          ""Show a brief cinematic screen with mission introduction."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\ui_f\data\igui\cfg\simpletasks\types\Talk_ca.paa"", " \n "          [], " \n "          ""LM_fnc_fadeIntroModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "        }; " \n " " \n "        if (profileNamespace getVariable [""LM_init_phaseTrans"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_Cinematics], " \n "          ""Phase Transition"", " \n "          ""Show a brief 15 second phase with cinematic black bars followed by a\nmission name, useful for transition between objectives."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\ui_f\data\igui\cfg\simpletasks\types\Talk_ca.paa"", " \n "          [], " \n "          ""LM_fnc_phaseTransitionModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "        }; " \n " " \n "        if ((profileNamespace getVariable [""LM_init_cinematicIntro"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_fadeInIntro"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_phaseTrans"", true])) then { " \n "         MAZ_zeusModulesTree tvSort [[MAZ_Cinematics], false]; " \n "        }; " \n " " \n " " \n "      comment ""Category - Clean-Up Tools""; " \n "       comment ""Category"";  " \n "        if (profileNamespace getVariable [""LM_init_dynTasks"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_CleanUpTree], " \n "          """", " \n "          ""[ Placeholder ]"", " \n "          LM_themeColor, " \n "          """", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "       comment ""Modules"";  " \n "        if (profileNamespace getVariable [""LM_init_dynTasks"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_CleanUpTree, 4], " \n "          """", " \n "          """", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          """", " \n "          [], " \n "          ""LM_fnc_deleteMarkersModule"" " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n "       " \n "       " \n "       " \n "      comment ""Category - Create/Delete Ships""; " \n "       comment ""Category"";  " \n "        if (profileNamespace getVariable [""LM_init_createDestroyer"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_DeleteShipTree], " \n "          """", " \n "          ""[ Placeholder ]"", " \n "          LM_themeColor, " \n "          """", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "       comment ""Modules"";  " \n "        if (profileNamespace getVariable [""LM_init_createDestroyer"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_DeleteShipTree, 1], " \n "          """", " \n "          ""When placed on a boat, creates the USS Liberty at its position.\nComes with a full interior, hull customization options, and is drivable by anyone."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          """", " \n "          [], " \n "          ""LM_fnc_createDestroyerModule"" " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n " " \n "      comment ""Category - Developer Tools""; " \n "       comment ""Category"";  " \n "        if ((profileNamespace getVariable [""LM_init_compTools"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_debugConsole"", true]) ||  " \n "         (profileNamespace getVariable [""LM_init_syncTasks"", true])) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_DevToolsTree], " \n "          """", " \n "          ""[ Placeholder ]"", " \n "          LM_themeColor, " \n "          """", " \n "          LM_themeColor " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "       comment ""Modules"";  " \n "        if (profileNamespace getVariable [""LM_init_compTools"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_DevToolsTree], " \n "          ""Composition Copier"", " \n "          ""Used to copy an array of objects to your clipboard in order to 'save' for later."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\3den\data\cfgwaypoints\scripted_ca.paa"", " \n "          [], " \n "          ""LM_fnc_compositionCopierModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n " " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_DevToolsTree], " \n "          ""Composition Paster"", " \n "          ""Used to paste an array of objects akin to how compositions work."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\3den\data\cfgwaypoints\scripted_ca.paa"", " \n "          [], " \n "          ""LM_fnc_compositionPasterModule"", " \n "          sideLogic " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusAddTV""); " \n "        }; " \n " " \n "        if (profileNamespace getVariable [""LM_init_debugConsole"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_DevToolsTree, 1], " \n "          """", " \n "          ""Opens the Debug Console."", " \n "          LM_themeColor, " \n "          """", " \n "          [], " \n "          ""\a3\3den\data\displays\display3den\entitymenu\findconfig_ca.paa"", " \n "          [], " \n "          ""LM_fnc_debugConsole"" " \n "         ] call (missionNamespace getVariable ""LM_fnc_zeusEditTV""); " \n "        }; " \n " " \n "        if (profileNamespace getVariable [""LM_init_syncTasks"", true]) then { " \n "         [ " \n "          MAZ_zeusModulesTree, " \n "          [MAZ_DevToolsTree], " \n "          ""Sync Tasks"", " \n "          ""Fetch tasks from the first available player