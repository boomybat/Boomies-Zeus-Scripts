PuristaBold'>Quality Of Life:</font><br /><img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>Zeuses gain access to the following improving server setup and player experience:<br />"" +  " \n "       ""%1"" + " \n "       ""<br /><br />These quality-of-life additions can be enabled at any time (require server restart to disable). They help to <font color='#ff9100'>automate</font> server setup as well as add small player <font color='#ff9100'>improvements</font>.</font>"", " \n "       _qualityOfLifesList " \n "      ]; " \n " " \n " " \n "      private _playerActionsList = """"; " \n "      { " \n "       _playerActionsList = _playerActionsList + format[""<br />• <img image='%1' width='20' height='20' /> %2"", _x select 2, (_x select 0) regexReplace [""Create"", ""Spawn""]]; " \n "      } forEach LM_var_playerActionsTypes; " \n " " \n "      private _playerActionsDesc = format[ " \n "       ""<font size='12'><font size='20' face='PuristaBold'>Player Actions:</font><br /><img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>Zeuses control access to the following additions players can utilize:<br />"" +  " \n "       ""%1"" + " \n "       ""<br /><br />Once enabled by Zeus, players can locally <font color='#ff9100'>toggle</font> these anytime. The actions are geared towards expansion of player <font color='#ff9100'>situational awareness</font>, <font color='#ff9100'>quality of life</font>, and <font color='#ff9100'>coordination</font>.</font>"", " \n "       _playerActionsList " \n "      ]; " \n " " \n " " \n "      private _contextActionsList = """"; " \n "      { " \n "       _contextActionsList = _contextActionsList + format[""<br />• <img image='%1' width='20' height='20' /> %2"", _x select 2, (_x select 0) regexReplace [""Create"", ""Spawn""]]; " \n "      } forEach LM_var_contextActionsTypes; " \n " " \n "      private _contextActionsDesc = format[ " \n "       ""<font size='12'><font size='20' face='PuristaBold'>Context Actions:</font><br /><img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>Zeuses gain access to the following new or modified context actions on right-click:<br />"" +  " \n "       ""%1"" + " \n "       ""<br /><br />These context actions are <font color='#ff9100'>toggleable</font> at anytime, focused on minor expansions to existing systems such as <font color='#ff9100'>teleporting</font>, <font color='#ff9100'>toggling damage</font>, and <font color='#ff9100'>hiding editable objects</font>.</font>"", " \n "       _contextActionsList " \n "      ]; " \n " " \n " " \n "      private _modulesList = """"; " \n "      { " \n "       _modulesList = _modulesList + format[""<br />• <img image='%1' width='20' height='20' /> %2"", _x select 2, (_x select 0) regexReplace [""Create"", ""Spawn""]]; " \n "      } forEach LM_var_modulesTypes; " \n " " \n "      private _modulesDesc = format[ " \n "       ""<font size='12'><font size='20' face='PuristaBold'>Modules:</font><br /><img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>Zeuses gain access to the following new or modified modules to place:<br />"" +  " \n "       ""%1"" + " \n "       ""<br /><br />These modules are <font color='#ff9100'>toggleable</font> at anytime, providing additions like <font color='#ff9100'>42</font> auto-populating tasks, <font color='#ff9100'>163</font> placeable compositions, and custom interiors for <font color='#ff9100'>713</font> building types.</font>"", " \n "       _modulesList " \n "      ]; " \n " " \n " " \n "      [[_qualityOfLifesDesc, _playerActionsDesc, _contextActionsDesc, _modulesDesc, (missionNamespace getVariable ['LM_AEGIS_Version',''])],{ " \n "       params [""_qualityOfLifesDesc"", ""_playerActionsDesc"", ""_contextActionsDesc"", ""_modulesDesc"", ""_aegisVersion""]; " \n " " \n "       if (not (player diarySubjectExists ""LM_diary_aegisBranding"")) then { " \n "        [_qualityOfLifesDesc, _playerActionsDesc, _contextActionsDesc, _modulesDesc, _aegisVersion] spawn { " \n "         params [""_qualityOfLifesDesc"", ""_playerActionsDesc"", ""_contextActionsDesc"", ""_modulesDesc"", ""_aegisVersion""]; " \n " " \n "         waitUntil {!isNil (""LM_fnc_makeDiarySubjectCodeCompile"")}; " \n "         waitUntil {!isNil (""LM_fnc_makeDiaryRecordCodeCompile"")}; " \n "         [""LM_diary_aegisBranding"", format[""AEGIS %1"", _aegisVersion], ""\A3\Ui_f\data\GUI\Cfg\UnitInsignia\TFAegis_ca.paa""] call LM_fnc_makeDiarySubjectCodeCompile; " \n "          " \n "         [ " \n "          ""LM_diary_aegisBranding"",  " \n "          [ " \n "           ""Quality Of Life"",  " \n "           _qualityOfLifesDesc, " \n "           ""\a3\3den\data\cfgwaypoints\scripted_ca.paa"" " \n "          ],  " \n "          taskNull,  " \n "          ""NONE"",  " \n "          false " \n "         ] call LM_fnc_makeDiaryRecordCodeCompile; " \n " " \n "         [ " \n "          ""LM_diary_aegisBranding"",  " \n "          [ " \n "           ""Player Actions"",  " \n "           _playerActionsDesc, " \n "           ""\a3\ui_f\data\gui\rsc\rscdisplaymain\menu_multiplayer_ca.paa"" " \n "          ],  " \n "          taskNull,  " \n "          ""NONE"",  " \n "          false " \n "         ] call LM_fnc_makeDiaryRecordCodeCompile; " \n " " \n "         [ " \n "          ""LM_diary_aegisBranding"",  " \n "          [ " \n "           ""Context Actions"",  " \n "           _contextActionsDesc, " \n "           ""\a3\3den\data\cfgwaypoints\move_ca.paa"" " \n "          ],  " \n "          taskNull,  " \n "          ""NONE"",  " \n "          false " \n "         ] call LM_fnc_makeDiaryRecordCodeCompile; " \n " " \n "         [ " \n "          ""LM_diary_aegisBranding"",  " \n "          [ " \n "           ""Modules"",  " \n "           _modulesDesc, " \n "           ""\a3\ui_f_curator\Data\Displays\RscDisplayCurator\modeModules_ca.paa"" " \n "          ],  " \n "          taskNull,  " \n "          ""NONE"",  " \n "          false " \n "         ] call LM_fnc_makeDiaryRecordCodeCompile; " \n " " \n "         [ " \n "          ""LM_diary_aegisBranding"",  " \n "          [ " \n "           ""Overview"",  " \n "           ""<font size='12'><font size='20' face='PuristaBold'>Overview:</font><br /><img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>'<font color='#ff9100'>AEGIS</font>' is an addon for '<font color='#ff9100'>Enhanced Zeus Modules</font>' designed to empower Zeuses by expanding key systems and dramatically speeding up repetitive tasks. "" +  " \n "           ""Key categories include:<br /><br />• <font color='#ff9100'>49</font> Modules<br />• <font color='#ff9100'>04</font> Context Actions<br />• <font color='#ff9100'>12</font> Player Actions<br />• <font color='#ff9100'>12</font> Quality of Life Additions<br /><br />A customizable dashboard lets you toggle specific features, with full support for multiple Zeuses operating simultaneously without interference.<br />"" + " \n "           ""<br />'<font color='#ff9100'>AEGIS</font>' addon authored by '<font color='#ff9100'>Lockheed Martin</font>', Steam friend code '<font color='#ff9100'>487755911</font>'."" + " \n "           ""<img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/><font size='14' color='#ff9100' face='PuristaBold'><execute expression='hint """"Workshop link copied, paste in browser.\nSee you soon!""""; """"https://steamcommunity.com/sharedfiles/filedetails/?id=XXXXXX"""" remoteExec [""""copyToClipboard""""];'>Steam Workshop Page</execute></font></font>"",  " \n "           ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\whiteboard_ca.paa"" " \n "          ],  " \n "          taskNull,  " \n "          ""NONE"",  " \n "          false " \n "         ] call LM_fnc_makeDiaryRecordCodeCompile; " \n "        }; " \n "       }; " \n "      }] remoteExec ['bis_fnc_call',0,""LM_JIP_aegisBrandingDiary""]; " \n " " \n "      missionNamespace setVariable [""LM_in