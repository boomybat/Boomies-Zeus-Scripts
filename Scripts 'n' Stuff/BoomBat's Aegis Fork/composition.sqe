erie Items:"",""Whether to add all Gendarmerie items to the virtual arsenal assignment.""], " \n "        [false] " \n "       ], " \n "       [ " \n "        ""TOOLBOX:ENABLED"", " \n "        [""FIA Items:"",""Whether to add all FIA items to the virtual arsenal assignment.""], " \n "        [false] " \n "       ], " \n "       [ " \n "        ""TOOLBOX:ENABLED"", " \n "        [""Syndikat Items:"",""Whether to add all SYNDIKAT items to the virtual arsenal assignment.""], " \n "        [false] " \n "       ], " \n "       [ " \n "        ""TOOLBOX:ENABLED"", " \n "        [""Civilian Items:"",""Whether to add all Civilian items to the virtual arsenal assignment.""], " \n "        [false] " \n "       ], " \n "       [ " \n "        ""TOOLBOX:ENABLED"", " \n "        [""Force Suppressors:"",""Whether to add suppressors to user's loadouts when they exit Arsenal.""], " \n "        [false] " \n "       ] " \n "      ],{ " \n "       params [""_values"",""_entity"",""_display""]; " \n "       _values params [""_affectedSide"",""_arsenalType"",""_enableGend"",""_enableFIA"",""_enableSynd"",""_enableIDAP"",""_forceSuppressor""]; " \n " " \n "       switch _arsenalType do { " \n "        case ""NONE"": { " \n "         _arsenalType = [""NONE"",-1]; " \n "        }; " \n "        case ""NATO"": { " \n "         _arsenalType = [""NATO"",0,0,""B_UavTerminal""]; " \n "        }; " \n "        case ""CSAT"": { " \n "         _arsenalType = [""CSAT"",1,1,""O_UavTerminal""]; " \n "        }; " \n "        case ""AAF"": { " \n "         _arsenalType = [""AAF"",2,2,""I_UavTerminal""]; " \n "        }; " \n "        case ""LDF"": { " \n "         _arsenalType = [""LDF"",3,2,""I_E_UavTerminal""]; " \n "        }; " \n "       }; " \n "        " \n "       [_affectedSide,_arsenalType,_enableGend,_enableFIA,_enableSynd,_enableIDAP,_forceSuppressor] call LM_fnc_arsenalRestrict; " \n " " \n "       _display closeDisplay 1; " \n "      },{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _display closeDisplay 2; " \n "      },_entity] call MAZ_EZM_fnc_createDialog; " \n "     }; " \n " " \n " " \n "    comment ""Auto Garrison Town""; " \n "     LM_fnc_createGarrisonDialog = { " \n "      private _pos = [] call MAZ_EZM_fnc_getScreenPosition; " \n "      [""Garrison Town"",[ " \n "       [ " \n "        ""EDIT"", " \n "        [""Town Name:"",""Optional: Enter a village, town, or city name, like 'Kavala' or 'Athira'.""], " \n "        [""""] " \n "       ], " \n "       [ " \n "        ""LIST"", " \n "        [""Faction:"",""Choose force to spawn""], " \n "        [ " \n "         [""NATO"",""CTRG"",""Gendarmerie"",""CSAT"",""Viper"",""Spetznaz"",""AAF"",""LDF"",""FIA"",""Syndicat"",""Civilian""], " \n "         [ " \n "          [""NATO"","""",""\a3\UI_F\data\Map\Markers\Flags\NATO_ca.paa""], " \n "          [""CTRG"","""",""\a3\UI_F\data\Map\Markers\Flags\CTRG_ca.paa""], " \n "          [""Gendarmerie"","""",""\A3\Ui_f\data\Map\Markers\Flags\tanoaGendarmerie_ca.paa""], " \n "          [""CSAT"","""",""\a3\UI_F\data\Map\Markers\Flags\CSAT_ca.paa""], " \n "          [""Viper"","""",""\a3\UI_F\data\Map\Markers\Flags\Viper_ca.paa""], " \n "          [""Spetznaz"","""",""\a3\UI_F_Enoch\data\CfgMarkers\Spetsnaz_ca.paa""], " \n "          [""AAF"","""",""\a3\UI_F\data\Map\Markers\Flags\AAF_ca.paa""], " \n "          [""LDF"","""",""\a3\UI_F_Enoch\data\CfgMarkers\LDF_ca.paa""], " \n "          [""FIA"","""",""\a3\UI_F\data\Map\Markers\Flags\FIA_ca.paa""], " \n "          [""Syndicat"","""",""\a3\UI_F\data\Map\Markers\Flags\syndicat_ca.paa""], " \n "          [""Civilian"","""",""\A3\ui_f\data\map\markers\flags\UN_ca.paa""] " \n "         ], " \n "         0, " \n "         11 " \n "        ] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Number of Garrisons:"",""Amount of squads to garrison in buildings.""], " \n "        [0,50,2] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Number of Patrols:"",""Amount of squads to patrols in buildings.""], " \n "        [0,50,1] " \n "       ], " \n "       [ " \n "        ""SLIDER:RADIUS"", " \n "        [""Spawn Radius (m):"",""Choose area to spawn units in.""], " \n "        [0,(getnumber (configfile >> ""CfgWorlds"" >> worldName >> ""mapSize"")),100,_pos,[1,1,1,1]] " \n "       ], " \n "       [ " \n "        ""TOOLBOX"", " \n "        [""Patrol Vehicles:"",""Allow for vehicles to spawn in patrols.""], " \n "        [false,[""Disable"",""Enable""]] " \n "       ], " \n "       [ " \n "        ""TOOLBOX"", " \n "        [""Enable Animations:"",""Allow for patrolling garrisoned troops to briefly enter into animations when stopping.\n\nNOTE: Animations create background scripts that can till mission end, dramatically increase server stress with the more Garrisons spawned!""], " \n "        [false,[""Disable"",""Enable""]] " \n "       ], " \n "       [ " \n "        ""LIST"", " \n "        [""Interior Type:"",""Choose a type of interior to populate all buildings within the Zone with.""], " \n "        [ " \n "         [""none"", ""random"", ""military"", ""civilian"", ""cbrn""], " \n "         [ " \n "          [""None"","""",""""], " \n "          [""Random"","""",""""], " \n "          [""Military"","""",""""], " \n "          [""Civilian"","""",""""], " \n "          [""CBRN"","""",""""] " \n "         ], " \n "         0, " \n "         4 " \n "        ] " \n "       ], " \n "       [ " \n "        ""TOOLBOX"", " \n "        [""Editable Interiors Control:"",""Control whether to add all interior objects to the Zeus interface as editable.\n\nOtherwise all objects will spawn 'simple' aka permanently uneditable, they can be deleted using the ZEI Interior Removal module OR by destroying the parent building.""], " \n "        [false,[""Simple"",""Editable""]] " \n "       ], " \n "       [ " \n "        ""SLIDER"", " \n "        [""Interior Spawn Chance:"", ""Chance for each building in a Zone to spawn an interior.\nNOTE: Lower value for larger cities!""], " \n "        [0,1,0] " \n "       ] " \n "      ],{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _values params [""_town"",""_faction"",""_garrisons"",""_patrols"",""_radius"",""_vehicles"",""_animations"",""_interiorType"",""_interiorControl"",""_interiorChance""]; " \n "       _args params [""_position""]; " \n "       private _locationNames = []; " \n "       {  " \n "        private _lct = _forEachIndex; " \n "        {  " \n "         _locationNames pushBack (toUpper (text _x)); " \n "        } forEach nearestLocations [getArray (configFile >> ""CfgWorlds"" >> worldName >> ""centerPosition""), [_x], worldSize];  " \n "       } forEach [""NameVillage"", ""NameCity"", ""NameCityCapital""]; " \n "       if(!(toUpper _town in _locationNames) && ((toUpper _town) != ""NONE"" && (toUpper _town) != """")) exitWith {[""No such town!"",""addItemFailed""] call LM_fnc_systemMessage;}; " \n "        " \n "       private _sideNew = civilian; " \n "       if (_faction in [""NATO"",""CTRG"",""Gendarmerie""]) then { " \n "        _sideNew = west; " \n "       } else { " \n "        if (_faction in [""CSAT"",""Viper"",""Spetznaz""]) then { " \n "         _sideNew = east; " \n "        } else { " \n "         if (_faction in [""AAF"",""LDF"",""FIA"",""Syndicat""]) then { " \n "          _sideNew = independent; " \n "         }; " \n "        }; " \n "       }; " \n " " \n "       if (_interiorChance >= 0.5) then { " \n "        player setVariable [""LM_var_interiorConfirm"", [_town,_sideNew,(round _garrisons),(round _patrols),_faction,(round _radius),_vehicles,_position,_animations,_interiorType,_interiorControl,_interiorChance]]; " \n "        [ " \n "         ""Interior Spawn Chance set to greater than or equal to 50%, be advised in larger cities this WILL cause LAG for players!"", " \n "         format [""Proceed with Interior Spawn Chance of %1%%"", _interiorChance * 100], " \n "         [ " \n "  