           " \n "            [_pos, _side, _markerID, _markerIDArea] spawn { " \n "             params ['_pos', '_side', '_markerID', '_markerIDArea']; " \n "              " \n "             [4] remoteExec ['BIS_fnc_earthquake']; " \n " " \n "             private _nearbyMines = nearestMines [_pos, [], 250]; " \n "             { " \n "              [_x] spawn { " \n "               params ['_mine']; " \n "               sleep (1 + random 4); " \n "               _mine setDamage 1; " \n "              }; " \n "             } forEach _nearbyMines; " \n " " \n "             private _nearbyBuildings = nearestObjects [_pos, ['House', 'Building'], 250]; " \n "             private _totalCount = count _nearbyBuildings; " \n "             private _numToSelect = round (_totalCount * 0.15); " \n "             private _shuffledBuildings = _nearbyBuildings call BIS_fnc_arrayShuffle; " \n "             private _selectedBuildings = _shuffledBuildings select [0, _numToSelect]; " \n "             { " \n "              if (damage _x < 1) then { " \n "               [_x] spawn { " \n "                params ['_building']; " \n "                sleep (2 + random 3);  " \n "                _building setDamage 1; " \n "               }; " \n "              }; " \n "             } forEach _selectedBuildings; " \n " " \n "             sleep 20; " \n "             deleteMarker _markerID; " \n "             deleteMarker _markerIDArea; " \n "            }; " \n "           }; " \n "          } else { " \n "           systemChat '[ EZM Addon: AEGIS ] : To call in an Seismic Cascade you must have a Mine Detector in your inventory, it will be removed upon calling the support.'; " \n "           playSound 'addItemFailed'; " \n "          }; " \n "         ""]] call BIS_fnc_addCommMenuItem)]; " \n "         _entity setVariable [""_supportSeismicCascade"",true]; " \n "        }] remoteExec ['bis_fnc_call',0,false]; " \n "       }; " \n "      } else { " \n "       if (!((_entity getVariable [""_supportSeismicCascade_ItemID"",-1]) == -1)) then { " \n "        [[_entity],{ " \n "         params ['_entity']; " \n "         [_entity, (_entity getVariable [""_supportSeismicCascade_ItemID"",-1])] call BIS_fnc_removeCommMenuItem; " \n "         _entity setVariable [""_supportSeismicCascade_ItemID"",-1]; " \n "         _entity setVariable [""_supportSeismicCascade"",false]; " \n "        }] remoteExec ['bis_fnc_call',0,false]; " \n "       }; " \n "      }; " \n "     }; " \n " " \n "      comment ""Broadcast Support Menu Cooldown""; " \n "       if ((isNil ""LM_var_supportCooldown"") &&  " \n "        ((profileNamespace getVariable [""LM_init_supportMenu"", true]) ||  " \n "        (profileNamespace getVariable [""LM_init_groundCommand"", true]))) then { " \n " " \n "        private _supportCooldown = profileNamespace getVariable [""LM_var_supportCooldown"", 1]; " \n "        missionNamespace setVariable [""LM_var_supportCooldown"", _supportCooldown, true]; " \n " " \n "        { " \n "         private _zeusPlayer = getAssignedCuratorUnit _x; " \n "         [[_supportCooldown, name player], { " \n "          params [""_supportCooldown"", ""_setter""]; " \n " " \n "          systemChat format[""[ EZM Addon: AEGIS ] : Be aware, callable supports cooldown set to '%1' minute(s) by Zeus '%2' due to them enabling the Support Menu or Ground Command module in the addon before you."", _supportCooldown, _setter]; " \n "         }] remoteExec [""bis_fnc_call"", _zeusPlayer]; " \n "        } forEach allCurators; " \n "       }; " \n " " \n "      comment ""Ground Command - Enable for Zeus""; " \n "       if (profileNamespace getVariable [""LM_init_groundCommand"", true]) then { " \n "        [true, player, true, false] call LM_fnc_groundCommand; " \n "       }; " \n " " \n " " \n "    comment ""48+2 Side Switcher""; " \n "     LM_fnc_482SideSwitcher = {  " \n "      params [  " \n "       [""_side"",west,[west]],  " \n "       [""_flag"",""\A3\Data_F\Flags\flag_NATO_CO.paa"",[""""]],  " \n "       [""_text"",""BLUFOR<br/>(NATO)"",[""""]]  " \n "      ];  " \n "      private _defaultGroup = createGroup _side;  " \n "      private _defaultGroupLogic = _defaultGroup createUnit ['Logic', [0,0,0], [], 0, 'NONE'];    " \n "      private _color = ([_side] call BIS_fnc_sideColor) call BIS_fnc_colorRGBAtoHTML;  " \n "      private _structuredText = format [""<t color='#ffffff' font='PuristaLight' size='1' align='center'>--------------------------------------------------------------<br/><t color='#FF00BFBF' font='RobotoCondensed' size='1.3'>You have been assigned to a team!<br/><t color='#ffffff' font='PuristaLight' size='1' align='center'>--------------------------------------------------------------<br/><t color='#ffffff' font='PuristaLight' size='5' align='center'><br/><img image='%3'></img><br/><br/><t color='%2' font='puristaBold' size='2'>%1<br/><t color='#ffffff' font='PuristaLight' size='1' align='center'>--------------------------------------------------------------</t>"", _text, _color, _flag];  " \n "      private _stringToHint = parseText _structuredText;  " \n "      [[_defaultGroup,_stringToHint],{  " \n "       params [""_group"",""_text""];  " \n "       if (!hasInterface) exitWith {};  " \n "       waitUntil { !isNil { player } && { !isNull player } };  " \n "       waitUntil { !isNull (findDisplay 46) };  " \n "       sleep 0.1;  " \n "       if(side (group player) != side _group) then {  " \n "        while {(side (group player) != side _group)} do {  " \n "         [player] joinSilent _group;  " \n "         sleep 0.5;  " \n "        };  " \n "        hint _text;  " \n "       };  " \n "      }] remoteExec ['spawn',0,""EZM_sideSwitcher""];  " \n "     }; " \n "     " \n "     " \n "    comment ""Friendly Markers""; " \n "     LM_fnc_friendlyMarkers = { " \n "      params [""_requireGPS"",""_showFactionOnly"",""_showAINames"",""_aiUnits"",""_aiGroups"",""_showWounded"",""_show3DHUD"",""_interactiveGroups"",""_groupIcons"",""_unitI