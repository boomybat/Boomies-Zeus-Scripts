[""ZMM_ZoneID"", _zoneID, true]; " \n "           _bombObj setVariable [""ZMM_BombID"", _i, true]; " \n "            " \n "           private _suffix = selectRandom [""ALPHA"", ""BRAVO"", ""CHARLIE""]; " \n "           private _serialNum = format[""%1-%2"", floor(random 900) + 100, _suffix]; " \n "           _bombObj setVariable [""ZMM_Serial"", _serialNum, true]; " \n "            " \n "           private _correctColor = ""Red""; " \n "           switch (_scenario) do { " \n "            case 0: { if (_suffix == ""ALPHA"") then {_correctColor=""Red""}; if (_suffix == ""BRAVO"") then {_correctColor=""Green""}; if (_suffix == ""CHARLIE"") then {_correctColor=""Blue""}; }; " \n "            case 1: { if (_suffix == ""ALPHA"") then {_correctColor=""Blue""}; if (_suffix == ""BRAVO"") then {_correctColor=""Green""}; if (_suffix == ""CHARLIE"") then {_correctColor=""Red""}; }; " \n "            case 2: { if (_suffix == ""ALPHA"") then {_correctColor=""Green""}; if (_suffix == ""BRAVO"") then {_correctColor=""Red""}; if (_suffix == ""CHARLIE"") then {_correctColor=""Blue""}; }; " \n "           }; " \n "           _bombObj setVariable [""ZMM_CorrectColor"", _correctColor, true]; " \n "            " \n "           private _bombTeam = []; " \n "           for ""_j"" from 0 to (1 + (missionNamespace getVariable [""ZZM_Diff"", 1])) do { _bombTeam set [_j, selectRandom _menArray] }; " \n "           private _bombGrp = [_bPos, _enemySide, _bombTeam] call BIS_fnc_spawnGroup; " \n "           [_bombGrp, _bPos, 20] call BIS_fnc_taskPatrol; " \n "            " \n "           private _props = []; " \n "           private _baseClass = selectRandom [""Land_Pallet_MilBoxes_F"", ""Land_WoodenTable_large_F"", ""Land_WorkStand_F"", ""Land_MetalBarrel_F""]; " \n "           private _base = ([AGLToASL (_bPos vectorAdd [0.8, 0, 0]), _baseClass, 1, [0,0,0], random 360, {0}, false] call BIS_fnc_spawnObjects) select 0; " \n "           _base setVectorUp surfaceNormal _bPos; " \n "           _props pushBack _base; " \n "            " \n "           for ""_k"" from 1 to (2 + floor(random 2)) do { " \n "            private _junkClass = selectRandom [""Land_Hammer_F"", ""Land_Pliers_F"", ""Land_DuctTape_F"", ""Land_ExtensionCord_F"", ""Land_PortableLight_single_F""]; " \n "            private _junkPos = _bPos getPos [1 + random 2, random 360]; " \n "            private _junk = ([AGLToASL _junkPos, _junkClass, 1, [0,0,0], random 360, {0}, false] call BIS_fnc_spawnObjects) select 0; " \n "            _junk setVectorUp surfaceNormal _junkPos; " \n "            _props pushBack _junk; " \n "           }; " \n " " \n "           { _x addCuratorEditableObjects [[_bombObj] + _props + units _bombGrp, true] } forEach allCurators; " \n "           _bombs pushBack _bombObj; " \n " " \n "           private _fuzzyPos = _bPos getPos [15 + random 25, random 360]; " \n "           private _mrkName = format[""MKR_%1_BOMB_%2"", _zoneID, _i]; " \n "            " \n "           private _mrkString = [format[""|%1|%2|Empty|ELLIPSE|[50,50]|0|SolidBorder|Default|0.5|"", _mrkName, _fuzzyPos]] call BIS_fnc_stringToMarker; " \n "           _mrkString setMarkerColor format[""Color%1"", _enemySide]; " \n " " \n "           private _subName = format[""ZMM_%1_SUB_BOMB_%2"", _zoneID, _i]; " \n "           [[_subName, format['ZMM_%1_TSK', _zoneID]], true,  " \n "           [format[""Search the marked area for Bomb #%1. WARNING: Do not cut wires without consulting the Manual.<br/><br/>Target Look:<br/><img image='%2' width='200' height='100'/>"", _i, _bombImg],  " \n "           format[""Defuse Bomb #%1"", _i], _mrkName],  " \n "           _fuzzyPos, ""AUTOASSIGNED"", 1, true, ""search"", false] call BIS_fnc_setTask; " \n "          }; " \n "           " \n "          missionNamespace setVariable [format[""ZMM_%1_BOMB_LIST"", _zoneID], _bombs]; " \n "          missionNamespace setVariable [format[""ZMM_%1_BOMBS_DEFUSED"", _zoneID], 0, true]; " \n "          missionNamespace setVariable [format[""ZMM_%1_BOMBS_BLOWN"", _zoneID], 0, true]; " \n "          missionNamespace setVariable [format[""ZMM_%1_BOMBS_TOTAL"", _zoneID], count _bombs, true]; " \n "           " \n "          private _manualPos = []; " \n "          private _isIndoor = false; " \n "           " \n "          private _validBuildings = _buildings select { count (_x buildingPos -1) > 0 }; " \n "          if (count _validBuildings > 0) then { " \n "           private _selBld = selectRandom _validBuildings; " \n "           _manualPos = selectRandom (_selBld buildingPos -1); " \n "           _isIndoor = true; " \n "          } else { " \n "           if (count _locations > 0) then {  " \n "            _manualPos = selectRandom _locations; " \n "            _locations deleteAt (_locations find _manualPos); " \n "           } else {  " \n "            _manualPos = [_centre getPos [50 + random _radius, random 360], 1, _radius, 1, 0, 0.5, 0, [], [ _centre, _centre ]] call BIS_fnc_findSafePos vectorAdd [0,0,0]; " \n "           }; " \n "           _manualPos = _manualPos findEmptyPosition [1, 50, ""Land_CampingTable_F""]; " \n "          }; " \n " " \n "          private _table = ([AGLToASL _manualPos, ""Land_CampingTable_F"", 1, [0,0,0], 0, {0}, false] call BIS_fnc_spawnObjects) select 0; " \n "           " \n "          if (_isIndoor) then { " \n "           _table setPosATL _manualPos; " \n "           _table setVectorUp [0,0,1]; " \n "          } else { " \n "           _table setPosATL _manualPos; " \n "           _table setVectorUp surfaceNormal _manualPos;  " \n "          }; " \n " " \n "          private _manualObj = ([AGLToASL _manualPos, ""Land_Tablet_02_F"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects) select 0; " \n "          _manualObj setPosATL (_manualPos vectorAdd [0,0,0.82]); " \n "          _manualObj setVectorUp [0,0,1]; " \n "          _manualObj setVariable [""ZMM_ZoneID"", _zoneID, true];  " \n "           " \n "          private _guardPos = if (_isIndoor) then { _manualPos getPos [15, random 360] } else { _manualPos }; " \n "          private _manualTeam = []; " \n "          for ""_j"" from 0 to (2 + (missionNamespace getVariable [""ZZM_Diff"", 1])) do { _manualTeam set [_j, selectRandom _menArray] }; " \n "          private _manualGrp = [_guardPos, _enemySide, _manualTeam] call BIS_fnc_spawnGroup; " \n "          [_manualGrp, _guardPos, 20] call BIS_fnc_taskPatrol; " \n " " \n "          { _x addCuratorEditableObjects [[_manualObj, _table] + units _manualGrp, true] } forEach allCurators; " \n " " \n "          private _intelImg = getText (configFile >> ""CfgVehicles"" >> ""Land_Tablet_02_F"" >> ""editorPreview""); " \n "          if (_intelImg == """") then { _intelImg = ""\A3\EditorPreviews_F\Data\CfgVehicles\Land_Tablet_02_F.jpg""; }; " \n " " \n "          private _mrkManual = format[""|%1|%2|Empty|ICON|[1,1]|0|Solid|Default|1|"",(format[""MKR_%1_MANUAL"", _zoneID]), _manualPos] call BIS_fnc_stringToMarker; " \n "          _mrkManual setMarkerType ""mil_unknown""; " \n "          _mrkManual setMarkerColor ""ColorYellow""; " \n "          _mrkManual setMarkerText ""Schematics""; " \n " " \n "          private _subTask1 = [[format[""ZMM_%1_SUB_MANUAL"", _zoneID], format['ZMM_%1_TSK', _zoneID]], true,  " \n "           [format[""Secure the <font color='#00FFFF'>Defusal Manual</font>. You will need to read it to understand which wire to cut for each bomb type.<br/><br/>Target Object:<br/><img image='%1' width='200' height='100'/>"", _intelImg],  " \n "           ""Secure Manual"", format[""MKR_%1_MANUAL"", _zoneID]], _manualPos, ""AUTOASSIGNED"", 1, false, true, ""documents""] call BIS_fnc_setTask; " \n " " \n "          { " \n "           [ " \n "            _x, " \n "            ""<t color='#FFA500'>Inspect Serial Number</t>"", " \n "            ""\a3\ui_f\data\IGUI\Cfg\holdActions\holdAction_search_ca.paa"", " \n "            ""\a3\ui_f\data\IGUI\Cfg\holdActions\holdAction_search_ca.paa"", " \n "            ""_this distance _target < 3"", ""_caller distance _target < 3"", {}, {}, " \n "            { " \n "             params [""_target"", ""_caller"", ""_actionId"", ""_arguments""]; " \n "             private _serial = _target getVariable [""ZMM_Serial"", ""ERROR""]; " \n "             private _id = _target getVariable [""ZMM_BombID"", 0]; " \n "             [name _caller, format[""Bomb #%2 Serial Number is: %1"", _serial, _id]] remoteExec [""BIS_fnc_showSubtitle""]; " \n "            }, {}, [], 3, 10, false, false " \n "           ] remoteExec [""bis_fnc_holdActionAdd"", 0, true]; " \n "          } forEach _bombs; " \n " " \n "          [ " \n "           _manualObj, " \n "           ""<t color='#00FFFF'>Read Defusal Manual</t>"", " \n "           ""\a3\ui_f\data\IGUI\Cfg\holdActions\holdAction_hack_ca.paa"", " \n "           ""\a3\ui_f\data\IGUI\Cfg\holdActions\holdAction_hack_ca.paa"", " \n "           ""_this distance _target < 3"", ""_caller distance _target < 3"", {}, {}, " \n "           { " \n "            params [""_target"", ""_caller"", ""_actionId"", ""_arguments""]; " \n "            private _zID = _target getVariable [""ZMM_ZoneID"", 0]; " \n "            private _dataArray = missionNamespace getVariable [format[""ZMM_%1_MANUAL_DATA"", _zID], [""ERROR""]]; " \n "             " \n "            [(_dataArray select 0), (_dataArray select 1)] remoteExec [""hintC"", _caller]; " \n "            [name _caller, ""I found the manual. I can state the wire codes on request.""] remoteExec [""BIS_fnc_showSubtitle""]; " \n "             " \n "            if !([format[""ZMM_%1_SUB_MANUAL"", _zID]] call BIS_fnc_taskCompleted) then { " \n "             [format[""ZMM_%1_SUB_MANUAL"", _zID], 'Succeeded', true] remoteExec [""BIS_fnc_taskSetState"", 2]; " \n "             deleteMarker format[""MKR_%1_MANUAL"", _zID]; " \n "            }; " \n "           }, {}, [], 4, 10, false, false " \n "          ] remoteExec [""bis_fnc_holdActionAdd"", 0, true]; " \n " " \n "          zmm_fnc_cutWireLogic = { " \n "           params [""_target"", ""_caller"", ""_color""]; " \n "           private _zID = _target getVariable [""ZMM_ZoneID"", 0]; " \n "           private _id = _target getVariable [""ZMM_BombID"", 0]; " \n "           private _correct = _target getVariable [""ZMM_CorrectColor"", ""Red""]; " \n "            " \n "           if (_color == _correct) then { " \n "            [name _caller, format[""Bomb #%2: Cutting %1 wire... Disarmed!"", _color, _id]] remoteExec [""BIS_fnc_showSubtitle""]; " \n "            _target remoteExecCall [""BIS_fnc_ambientAnim__terminate""]; " \n "            deleteVehicle _target;  " \n "           } else { " \n "            [name _caller, format[""Bomb #%2: Cutting %1 wire... WRONG WIRE!"", _color, _id]] remoteExec [""BIS_fnc_showSubtitle""]; " \n "            _target remoteExecCall [""BIS_fnc_ambientAnim__terminate""]; " \n "             " \n "            [_target] spawn { " \n "             params [""_source""]; " \n "             private _interval = 1; " \n "             for ""_i"" from 1 to 15 do { " \n "              if (!alive _source) exitWith {}; " \n "              playSound3D [""\a3\sounds_f\arsenal\tools\minedetector_beep_01.wss"", _source, false, getPosASL _source, 3, 1 + (_i * 0.2), 0]; " \n "              sleep _interval; " \n "              _interval = _interval * 0.7; " \n "             }; " \n "             if (alive _source) then { " \n "              private _pos = getPos _source; " \n "              private _zID = _source getVariable [""ZMM_ZoneID"", 0]; " \n "              private _id = _source getVariable [""ZMM_BombID"", 0]; " \n "               " \n "              deleteVehicle _source; " \n "               " \n "              private _boom = ([_pos, 0, ""Bo_GBU12_LGB"", sideEmpty] call BIS_fnc_spawnVehicle) select 0; " \n "               " \n "              [format[""ZMM_%1_SUB_BOMB_%2"", _zID, _id], 'Failed', true] remoteExec [""BIS_fnc_taskSetState"", 2]; " \n "               " \n "              private _count = missionNamespace getVariable [format[""ZMM_%1_BOMBS_DEFUSED"", _zID], 0]; " \n "              _count = _count + 1; " \n "              missionNamespace setVariable [format[""ZMM_%1_BOMBS_DEFUSED"", _zID], _count, true]; " \n " " \n "              private _count = missionNamespace getVariable [format[""ZMM_%1_BOMBS_BLOWN"", _zID], 0]; " \n "              _count = _count + 1; " \n "              missionNamespace setVariable [format[""ZMM_%1_BOMBS_BLOWN"", _zID], _count, true]; " \n "             }; " \n "            }; " \n "           }; " \n "          }; " \n "          missionNamespace setVariable [""zmm_fnc_cutWireLogic"", zmm_fnc_cutWireLogic, true]; " \n " " \n "          { " \n "           private _bomb = _x; " \n "           { " \n "            private _color = _x; " \n "            private _colorHex = switch (_color) do { case ""Red"": {""#FF0000""}; case ""Green"": {""#00FF00""}; case ""Blue"": {""#0080FF""}; }; " \n "             " \n "            [ " \n "             _bomb, " \n "             format[""<t color='%1'>Cut %2 Wire</t>"", _colorHex, toUpper(_color)], " \n "             ""\a3\ui_f\data\IGUI\Cfg\holdActions\holdAction_unbind_ca.paa"", " \n "             ""\a3\ui_f\data\IGUI\Cfg\holdActions\holdAction_unbind_ca.paa"", " \n "             ""_this distance _target < 3"", ""_caller distance _target < 3"",  " \n "             {}, " \n "             { " \n "              params [""_target"", ""_caller"", ""_actionId"", ""_arguments"", ""_frame"", ""_maxFrame""]; " \n "              if (_frame == 2) then { " \n "               [_caller, ""Acts_carFixingWheel""] remoteExecCall [""switchMove""]; " \n "               playSound3D [""\a3\sounds_f\sfx\ui\vehicles\vehicle_repair.wss"", _target]; " \n "              }; " \n "             }, " \n "             { " \n "              params [""_target"", ""_caller"", ""_actionId"", ""_arguments""]; " \n "              _arguments params [""_color""]; " \n "              [_target, _caller, _color] call (missionNamespace getVariable ""zmm_fnc_cutWireLogic""); " \n "              _caller remoteExecCall [""BIS_fnc_ambientAnim__terminate""]; " \n "             },  " \n "             { " \n "              params [""_target"", ""_caller"", ""_actionId"", ""_arguments""]; " \n "              _caller remoteExecCall [""BIS_fnc_ambientAnim__terminate""]; " \n "             }, " \n "             [_color], 6, 1, false, false " \n "            ] remoteExec [""bis_fnc_holdActionAdd"", 0, true]; " \n "           } forEach [""Red"", ""Green"", ""Blue""]; " \n "          } forEach _bombs; " \n " " \n "          [_zoneID, _bombs] spawn { " \n "           params [""_zID"", ""_bombs""]; " \n "           private _allDone = false; " \n "           while {!_allDone} do { " \n "            sleep 2; " \n "            private _activeBombs = 0; " \n "            { " \n "             private _bombObj = _x; " \n "             private _id = _bombObj getVariable [""ZMM_BombID"", _forEachIndex + 1]; " \n "             private _subName = format[""ZMM_%1_SUB_BOMB_%2"", _zID, _id]; " \n "             private _mrkName = format[""MKR_%1_BOMB_%2"", _zID, _id]; " \n "              " \n "             if (isNull _bombObj) then { " \n "              if !([_subName] call BIS_fnc_taskCompleted) then { " \n "               [_subName, 'Succeeded', true] call BIS_fnc_taskSetState; " \n "                " \n "               private _count = missionNamespace getVariable [format[""ZMM_%1_BOMBS_DEFUSED"", _zID], 0]; " \n "               _count = _count + 1; " \n "               missionNamespace setVariable [format[""ZMM_%1_BOMBS_DEFUSED"", _zID], _count, true]; " \n "                " \n "               private _total = missionNamespace getVariable [format[""ZMM_%1_BOMBS_TOTAL"", _zID], 3]; " \n "              }; " \n "              deleteMarker _mrkName; " \n "             } else { " \n "              _activeBombs = _activeBombs + 1; " \n "             }; " \n "            } forEach _bombs; " \n "             " \n "            if (_activeBombs == 0) then { _allDone = true; }; " \n "           }; " \n "          }; " \n " " \n "          private _successTrigger = ([AGLToASL _centre, ""EmptyDetector"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects) select 0; " \n "          _successTrigger setTriggerStatements [  " \n "           format[""((missionNamespace getVariable ['ZMM_%1_BOMBS_DEFUSED', 0]) >= (missionNamespace getVariable ['ZMM_%1_BOMBS_TOTAL', 99])) && ((missionNamespace getVariable ['ZMM_%1_BOMBS_BLOWN', 0]) < %2)"", _zoneID, _bombCount],  " \n "           format["" " \n "            ['ZMM_%1_TSK', 'Succeeded', true] spawn BIS_fnc_taskSetState;  " \n "            missionNamespace setVariable ['ZMM_DONE', true, true];  " \n "            { deleteMarker _x } forEach ['MKR_%1_MANUAL']; " \n "            { _x setMarkerColor ('Color' + str(missionNamespace getVariable ['ZMM_playerSide',WEST])) } forEach ['MKR_%1_LOC','MKR_%1_MIN']; " \n "           "", _zoneID],  " \n "           """"  " \n "          ]; " \n " " \n "          private _failTrigger = ([AGLToASL _centre, ""EmptyDetector"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects) select 0; " \n "          _failTrigger setTriggerStatements [  " \n "           format[""((missionNamespace getVariable ['ZMM_%1_BOMBS_BLOWN', 0]) >= %2)"", _zoneID, _bombCount],  " \n "           format[""['ZMM_%1_TSK', 'Failed', true] spawn BIS_fnc_taskSetState; missionNamespace setVariable ['ZMM_DONE', true, true]; { deleteMarker _x } forEach ['MKR_%1_MANUAL']; { _x setMarkerColor 'ColorGrey' } forEach ['MKR_%1_LOC','MKR_%1_MIN']"", _zoneID],  " \n "           """"  " \n "          ]; " \n " " \n "          true " \n "         }; " \n "        }; " \n " " \n "        if (isNil(""disarm_uxo_sqf"")) then { " \n "         disarm_uxo_sqf = { " \n "          params [ [""_zoneID"", 0], [""_targetPos"", [0,0,0]] ]; " \n " " \n "          private _centre = missionNamespace getVariable [format[""ZMM_%1_Location"", _zoneID], _targetPos]