ObjectGlobal"",2]; " \n "             }] remoteExec [""spawn"", _player]; " \n "             systemchat format [""[ EZM Addon: AEGIS ] : Player '%1' has been locked into Spectator mode!"", (name _player)]; " \n "            } else { " \n "             [[],{ " \n "              titleText [""<t color='#FFFFFF' size='1.5'font='PuristaBold'>FORCED SPECTATOR MODE DISABLED</t>"", ""PLAIN DOWN"", -1, false, true]; " \n "              player setVariable ['isRestricted',false]; " \n "              [""Terminate"", [player]] call BIS_fnc_EGSpectator; " \n "              player allowDamage true;  " \n "              [player,false] remoteExec [""hideObjectGlobal"",2]; " \n "             }] remoteExec [""spawn"", _player]; " \n "             systemchat format [""[ EZM Addon: AEGIS ] : Player '%1' has been released from Spectator mode!"", (name _player)]; " \n "            }; " \n "           }; " \n "          }; " \n "         }]; " \n "         ctrlToolboxSpectator ctrlCommit 0; " \n "           " \n "         lbClear ctrlToolboxSpectator; " \n "         { " \n "          _x params [""_text"",[""_tooltip"", '']]; " \n " " \n "          private _index = ctrlToolboxSpectator lbAdd _text; " \n "          ctrlToolboxSpectator lbSetTooltip [_index, _tooltip]; " \n "         } forEach [[""Disable"", ""Force the selected server player into spectator mode permanently.""], [""Enable"", ""Bring the selected server player out of an enforced spectator mode.""]]; " \n "         ctrlToolboxSpectator lbSetCurSel 0; " \n "         " \n "       _ctrlTitleZeus = _display ctrlCreate [""RscText"", -1, _ctrlGroup]; " \n "        _ctrlTitleZeus ctrlSetText ""Zeus Logic:""; " \n "        _ctrlTitleZeus ctrlSetTooltip ""Choose whether to enable or disable Zeus Logic for the choosen server player.""; " \n "        _ctrlTitleZeus ctrlSetPosition [0.57, 0.645, 0.135, 0.04]; " \n "        _ctrlTitleZeus ctrlSetBackgroundColor [0,0,0,0.6]; " \n "        _ctrlTitleZeus ctrlCommit 0; " \n "        " \n "        ctrlToolboxZeus = _display ctrlCreate [""RscToolbox"", -1, _ctrlGroup]; " \n "         ctrlToolboxZeus ctrlSetPosition [0.709, 0.645, 0.31, 0.04]; " \n "         ctrlToolboxZeus ctrlSetBackgroundColor [0,0,0,0.4]; " \n "         ctrlToolboxZeus ctrlAddEventHandler [""ToolBoxSelChanged"", { " \n "          params [""_control"", ""_selectedIndex""]; " \n "           " \n "          _lbCurSel = lbCurSel ctrlListboxAllPlayers; " \n "          if (_lbCurSel > -1) then { " \n "           _entity = (ctrlListboxAllPlayers lbData _lbCurSel) call BIS_fnc_getUnitByUID; " \n "           if (!isNull _entity) then { " \n "            if (lbCurSel ctrlToolboxZeus == 1) then { " \n "             if (isNull (getAssignedCuratorLogic _entity)) then { " \n "              [[_entity], { " \n "               params [""_entity""]; " \n " " \n "               [_entity] call LM_fnc_curatorAssignCodeCompile; " \n "              }] remoteExec [""bis_fnc_call"", 2]; " \n "               " \n "              [[], { " \n "               waitUntil {!isNull (getAssignedCuratorLogic player)}; " \n "               private _zeusLogic = getAssignedCuratorLogic player; " \n "                " \n "               player setVariable [""MAZ_EZM_ZeusLogic"",_zeusLogic]; " \n " " \n "               if (!isNil ""MAZ_EZM_zeusRespawnFix"") then { " \n "                player removeEventHandler [""Respawn"",MAZ_EZM_zeusRespawnFix]; " \n "               }; " \n " " \n "               LM_fnc_assignZeus = { " \n "                [] spawn { " \n "                 waitUntil {alive player && !isNull (findDisplay 46)}; " \n "                 private _zeusLogic = player getVariable ""MAZ_EZM_ZeusLogic""; " \n "                 if(isNil ""_zeusLogic"") exitWith { " \n "                  systemChat ""[ EZM Addon: AEGIS ] : Error! Zeus Logic not found!""; " \n "                  playSound ""addItemFailed""; " \n "                 }; " \n "                 [_zeusLogic] remoteExec ['unassignCurator',2]; " \n " " \n "                 waitUntil{isNull (getAssignedCuratorUnit _zeusLogic)}; " \n "                 systemChat ""[ EZM Addon: AEGIS ] : Curator unassigned.""; " \n " " \n "                 systemChat ""[ EZM Addon: AEGIS ] : Attempting to assign...""; " \n "                 while{isNull (getAssignedCuratorUnit _zeusLogic)} do { " \n "                  [player,_zeusLogic] remoteExec ['assignCurator',2]; " \n "                  sleep 0.1; " \n "                 }; " \n " " \n "                 waitUntil{getAssignedCuratorLogic player == _zeusLogic}; " \n " " \n "                 systemChat ""[ EZM Addon: AEGIS ] : Curator assigned! Press Y to open/close Zeus.""; " \n "                  " \n "                 { " \n "                  private _zeusLogic = _x; " \n "                  _zeusLogic removeAllEventHandlers ""CuratorPinged""; " \n "                  _zeusLogic addEventHandler [""CuratorPinged"", { " \n "                   params [""_curator"", ""_player""]; " \n " " \n "                   [""Zeus Pinged"", [""ZEUS INFORMED:"",  " \n "                   ""The Zeus has been informed of your ping, communicate with them via voice or text to coordinate actions."",  " \n "                   ""DISCLAIMER:"",  " \n "                   ""By pressing continue you agree to not abuse this action, understanding you may be kicked if you do not.""]] remoteExec [""hintC"", _player]; " \n "                    " \n "                   systemChat format[""[ EZM Addon: AEGIS ] : Be aware, player '%1' has pinged Zeus."", name _player]; " \n "                  }]; " \n "                 } foreach allCurators; " \n "                  " \n "                 systemChat ""[ EZM Addon: AEGIS ] : Extra logging when curator pinged enabled.""; " \n "                }; " \n "               }; " \n " " \n "               MAZ_EZM_zeusRespawnFix = player addEventhandler [""Respawn"",{ " \n "                [] spawn LM_fnc_assignZeus; " \n "               }]; " \n "                " \n "               [] spawn LM_fnc_assignZeus; " \n " " \n "               [[player], { " \n "                params [""_entity""]; " \n " " \n "                private _prompt = [""Zeus Access Granted"", [""ACCESS:"", ""Press 'Y' to open the Zeus interface anytime."", ""DISCLAIMER:"", ""By pressing continue you agree to use the interface responsibly understanding it can be taken away at anytime.""]]; " \n "                (_prompt select 0) hintC (_prompt select 1); " \n "                playSound ""addItemOk""; " \n "               }] remoteExec [""bis_fnc_call"", player, false]; " \n "              }] remoteExec [""bis_fnc_call"", _entity, false]; " \n " " \n "              systemChat format[""[ EZM Addon: AEGIS ] : Zeus Logic assigned to player '%1'!"", name _entity]; " \n "              playSound ""addItemOk""; " \n "             } else { " \n "              systemChat format[""[ EZM Addon: AEGIS ] : Zeus Logic already assigned to player '%1'!"", name _entity]; " \n "              playSound ""addItemFailed""; " \n "             }; " \n "            } else { " \n "             if (!isNull (getAssignedCuratorLogic _entity)) then { " \n "              [[_entity], { " \n "               params [""_entity""]; " \n " " \n "               private _zeusLogic = getAssignedCuratorLogic _entity; " \n "               unassignCurator _zeusLogic; " \n " " \n "               private _curatorWhitelist = missionNamespace getVariable [""MAZ_EZM_CuratorWhitelist"",[]]; " \n "               _curatorWhitelist = _curatorWhitelist - [_zeusLogic]; " \n "               missionNamespace setVariable [""MAZ_EZM_CuratorWhitelist"",_curatorWhitelist,true]; " \n "               waitUntil {!(_zeusLogic in (missionNamespace getVariable [""MAZ_EZM_CuratorWhitelist"",[]]))}; " \n " " \n "               private _zeusWhitelist = missionNamespace getVariable [""MAZ_EZM_ZeusWhitelist"",[]]; " \n "               _zeusWhitelist = _zeusWhitelist - [(getPlayerUID _entity)]; " \n "               missionNamespace setVariable [""MAZ_EZM_ZeusWhitelist"",_zeusWhitelist,true]; " \n "               waitUntil {!((getPlayerUID _entity) in (missionNamespace getVariable [""MAZ_EZM_ZeusWhitelist"",[]]))}; " \n " " \n "               deleteVehicle _zeusLogic; " \n "              }] remoteExec [""bis_fnc_call"", 2]; " \n " " \n "              [[],{ " \n "               if (!isNil ""MAZ_EZM_zeusRespawnFix"") then { " \n "                player removeEventHandler [""Respawn"",MAZ_EZM_zeusRespawnFix]; " \n "               }; " \n "              }] remoteExec [""bis_fnc_call"", _entity, false]; " \n " " \n "              systemChat format[""[ EZM Addon: AEGIS ] : Zeus Logic un-assigned from player '%1' and deleted!"", name _entity]; " \n "             } else { " \n "              systemChat format[""[ EZM Addon: AEGIS ] : Zeus Logic not currently assigned to player '%1'!"", name _entity]; " \n "              playSound ""addItemFailed""; " \n "             }; " \n "            }; " \n "           }; " \n "          }; " \n "         }]; " \n "         ctrlToolboxZeus ctrlCommit 0; " \n "           " \n "         lbClear ctrlToolboxZeus; " \n "         { " \n "          _x params [""_text"",[""_tooltip"", '']]; " \n " " \n "          private _index = ctrlToolboxZeus lbAdd _text; " \n "          ctrlToolboxZeus lbSetTooltip [_index, _tooltip]; " \n "         } forEach [[""Disable"", ""Force the selected server player back into player only mode.""], [""Enable"", ""Enable the selected server player to press 'Y' to access Zeus mode.\n\nNOTE: You may need to enable this twice for it to take affect on the player.""]]; " \n "         ctrlToolboxZeus lbSetCurSel 0; " \n " " \n "       lbClear ctrlListboxAllPlayers; " \n "       [[getPlayerUID player]] call LM_fnc_ctrlListboxAllPlayersUpdate; " \n "       ctrlListboxAllPlayers lbSetCurSel 0; " \n "          " \n "        " \n "      _ctrlTitleGlobalKick = _display ctrlCreate [""RscText"", -1, _ctrlGroup]; " \n "       _ctrlTitleGlobalKick ctrlSetText ""Global Auto