 \n " " \n "      " \n "     comment ""Diary""; " \n "      LM_fnc_makeDiarySubject = { " \n "       params [""_subject"", ""_displayName"", ""_picture""]; " \n " " \n "       player createDiarySubject [_subject, _displayName, _picture]; " \n "      }; " \n " " \n "      LM_fnc_makeDiaryRecord = { " \n "       params [""_subject"", [""_textInfo"", ["""", """", """"]], [""_task"", taskNull], [""_taskState"", ""NONE""], ""_showTitle""]; " \n " " \n "       player createDiaryRecord [_subject, _textInfo, _task, _taskState, _showTitle]; " \n "      }; " \n " " \n "       LM_fnc_sendDiaryCode = { " \n "        _LM_fnc_makeDiarySubjectCode = (str LM_fnc_makeDiarySubject) splitString """"; " \n "        _LM_fnc_makeDiarySubjectCode deleteAt (count _LM_fnc_makeDiarySubjectCode - 1); " \n "        _LM_fnc_makeDiarySubjectCode deleteAt 0; " \n "        missionNamespace setVariable [""LM_fnc_makeDiarySubjectCode"", _LM_fnc_makeDiarySubjectCode,0]; " \n " " \n "        _LM_fnc_makeDiaryRecordCode = (str LM_fnc_makeDiaryRecord) splitString """"; " \n "        _LM_fnc_makeDiaryRecordCode deleteAt (count _LM_fnc_makeDiaryRecordCode - 1); " \n "        _LM_fnc_makeDiaryRecordCode deleteAt 0; " \n "        missionNamespace setVariable [""LM_fnc_makeDiaryRecordCode"", _LM_fnc_makeDiaryRecordCode,0]; " \n "       }; " \n " " \n "      " \n "     comment ""Player Remove""; " \n "      LM_fnc_removePlayer = { " \n "       [[],{ " \n "        moveout player; " \n "       }] remoteExec [""bis_fnc_call"", 0, false]; " \n "      }; " \n " " \n "       LM_fnc_sendPlayerRemoveCode = { " \n "        _playerRemoveCode = (str LM_fnc_removePlayer) splitString """"; " \n "        _playerRemoveCode deleteAt (count _playerRemoveCode - 1); " \n "        _playerRemoveCode deleteAt 0; " \n "        missionNamespace setVariable [""LM_fnc_playerRemoveVariable"",_playerRemoveCode,0]; " \n "       }; " \n " " \n "      " \n "     comment ""Arsenal Open""; " \n "      LM_fnc_arsenalOpen = { " \n "       if (!(missionNamespace getVariable [""LM_var_arsenalClosedEH"", false])) then { " \n "        missionNamespace setVariable [""LM_var_arsenalClosedEH"", true]; " \n "         " \n "        [missionNamespace, ""arsenalClosed"", {  " \n "         disableSerialization;  " \n "         deleteVehicle (player getVariable [""_arsenalObj"",objNull]); " \n "        }] call BIS_fnc_addScriptedEventHandler; " \n "       }; " \n "        " \n "       if (!(isNil ""LM_fnc_arsenalCleaner"")) then { " \n "        _playerSide = side player; " \n "        _restrictionsIndex = 0; " \n "        switch (_playerSide) do " \n "        { " \n "         case west: { _restrictionsIndex = 0 }; " \n "         case east: { _restrictionsIndex = 1 }; " \n "         case independent: { _restrictionsIndex = 2 }; " \n "         case civilian: { _restrictionsIndex = 3 }; " \n "        }; " \n "        if (!([(arsenalRestrictions select _restrictionsIndex)] in [[[[],[],[],[]]]])) then { " \n "         _arsenalObj = ""VirtualReammoBox_camonet_F"" createVehicleLocal [0,0,0]; " \n "         player setVariable [""_arsenalObj"",_arsenalObj]; " \n "         [_arsenalObj] call LM_fnc_arsenalCleaner; " \n "         ['Preload'] call BIS_fnc_arsenal; " \n "         ['Open', [false, _arsenalObj, player]] spawn BIS_fnc_arsenal; " \n "        } else { " \n "         ['Preload'] call BIS_fnc_arsenal; " \n "         ['Open', true] spawn BIS_fnc_arsenal; " \n "        }; " \n "       } else { " \n "        ['Preload'] call BIS_fnc_arsenal; " \n "        ['Open', true] spawn BIS_fnc_arsenal; " \n "       }; " \n "      }; " \n " " \n "       LM_fnc_sendArsenalOpenCode = { " \n "        _arsenalCode = (str LM_fnc_arsenalOpen) splitString """"; " \n "        _arsenalCode deleteAt (count _arsenalCode - 1); " \n "        _arsenalCode deleteAt 0; " \n "        missionNamespace setVariable [""LM_fnc_arsenalOpenVariable"",_arsenalCode,0]; " \n "       }; " \n " " \n " " \n "    comment ""Send Player JIP Functions""; " \n "     [