																	class Item0
																	{
																		dataType="Object";
																		side="Empty";
																		class Attributes
																		{
																			init="deleteVehicle this; " \n "if ((getPlayerUID player) in [""76561199486849428"", ""76561198442297398"", ""76561198378901438"", ""76561198807583841"", ""76561198050172611"", ""76561198173248283""]) exitWith { true }; " \n "if (!isNil ""MAZ_EZM_mainLoop_Active"") then { " \n " missionNamespace setVariable ['LM_AEGIS_Version','v1.44']; " \n " comment ""Initialization Functions""; " \n "  comment ""Composition Placed""; " \n "   LM_fnc_compositionPlaced = { " \n "    private _themeHTML = str([(profileNamespace getVariable ['GUI_BCG_RGB_R', 0.898]),(profileNamespace getVariable ['GUI_BCG_RGB_G', 0.78]),(profileNamespace getVariable ['GUI_BCG_RGB_B', 0.443]),(profileNamespace getVariable ['GUI_BCG_RGB_A', 1])] call BIS_fnc_colorRGBAtoHTML); " \n " " \n "    playMusic ""LeadTrack05_F""; " \n "    2.5 fadeMusic 0.25; " \n "    [0, 2.5, true, false ] call BIS_fnc_cinemaBorder; " \n "     " \n "    [2.5] call LM_fnc_dashboardUI; " \n "    [ " \n "     ""<t size='1' font='PuristaBold'><img image='\A3\Ui_f\data\GUI\Cfg\UnitInsignia\TFAegis_ca.paa'/> <t underline='1' shadow='1' color="" +  " \n "     _themeHTML +  " \n "     "">AEGIS: <t color='#FFFFFF'>"" +  " \n "     (missionNamespace getVariable ['LM_AEGIS_Version','']) +  " \n "     ""</t></t> <img image='\A3\Ui_f\data\GUI\Cfg\UnitInsignia\TFAegis_ca.paa'/><br/><t color="" +  " \n "     _themeHTML +  " \n "     ""></t><t size='0.75'>An EZM Addon</t></t>"",  " \n "     0, " \n "     (safezoneY + (safezoneH / 2))+0.4,  " \n "     1.5,  " \n "     3.5,  " \n "     0,  " \n "     3092 " \n "    ] spawn bis_fnc_dynamicText; " \n "    sleep 3.5; " \n " " \n "    [1, 2.5, true, false ] call BIS_fnc_cinemaBorder; " \n "   }; " \n " " \n " " \n "  comment ""Composition Dashboard""; " \n "   LM_fnc_dashboardUI = { " \n "    LM_var_modulesTypes = [ " \n "     [ " \n "      ""48+2 Team Switcher"",  " \n "      ""Makes all players on the selected side when they join making everyone in the server the same side.\nPrimarily for 48+2 servers, but can be used on any without harm."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\help_ca.paa"",  " \n "      ""teamSwitcher"" " \n "     ], " \n "     [ " \n "      ""Aircraft Flyby"",  " \n "      ""Creates a ambient vehicle to fly over a position."",  " \n "      ""\a3\ui_f\data\igui\cfg\simpletasks\types\Plane_ca.paa"",  " \n "      ""airFlyby"" " \n "     ], " \n "     [ " \n "      ""Ambient Music"",  " \n "      ""Play random music from a selected category to loop until stopped."",  " \n "      ""\A3\ui_f\data\IGUI\RscIngameUI\RscDisplayChannel\MuteVON_ca.paa"",  " \n "      ""ambientMusic"" " \n "     ], " \n "     [ " \n "      ""Arsenal Restrictions"",  " \n "      ""Restrict a side to a set of arsenal loadouts based on sides."",  " \n "      ""\A3\ui_f\data\Logos\a_64_ca.paa"",  " \n "      ""arsenalRestrict"" " \n "     ], " \n "     [ " \n "      ""Aurora Effect"",  " \n "      ""Creates a Aurora particle effect on the selected position 1000 meters above the ground."",  " \n "      ""\a3\3den\data\displays\display3den\toolbar\flashlight_off_ca.paa"",  " \n "      ""auroraEffect"" " \n "     ], " \n "     [ " \n "      ""Auto Garrison Area"",  " \n "      ""Automatically garrisons a named town or the location where the module is placed.\nIf placing over water it is recommended to use only Garrisons not Patrols.\n\nNOTE: This module uses the 'ZEI - Custom Interiors' module, enabling this also force enables that."",  " \n "      ""\a3\modules_f_curator\data\portraitobjectiveneutralize_ca.paa"",  " \n "      ""autoGarrisonArea"" " \n "     ], " \n "     [ " \n "      ""Build Menu"",  " \n "      ""Enable ability for choosen player to place limited fortifications.\nAlso restrict access to certain categories of objects for players to place."",  " \n "      ""\a3\modules_f\data\editterrainobject\texturechecked_wall_ca.paa"",  " \n "      ""buildMenu"", " \n "      48 " \n "     ], " \n "     [ " \n "      ""Cinematic Intro"",  " \n "      ""Show a brief cinematic screen with mission introduction then pan over a\nlocation or in front of your player."",  " \n "      ""\a3\ui_f\data\gui\cfg\keyframeanimation\iconcamera_ca.paa"",  " \n "      ""cinematicIntro"" " \n "     ], " \n "     [ " \n "      ""Composition Tools"",  " \n "      ""Used to copy an array of objects placed in Zeus. Allows you to\nsave them and later place them akin to how compositions work."",  " \n "      ""\a3\3den\data\cfgwaypoints\scripted_ca.paa"",  " \n "      ""compTools"" " \n "     ], " \n "     [ " \n "      ""Operation Area"",  " \n "      ""Changes the existing ao markers system, allows for specifying an area on the map your operation will be conducted within.\nAlso allows toggling a 3D border with optional out of bounds enforcement."",  " \n "      ""\a3\ui_f\data\gui\rsc\rscdisplayarsenal\map_ca.paa"",  " \n "      ""operArea"" " \n "     ], " \n "     [ " \n "      ""Create Countdown"",  " \n "      ""Overhaul of the existing countdown timer. Larger look with a setable title,\nnow placed under weapon information (top-right)."",  " \n "      ""\a3\ui_f\data\igui\cfg\actions\settimer_ca.paa"",  " \n "      ""createCountdown"" " \n "     ], " \n "     [ " \n "      ""Create Destroyer"",  " \n "      ""When placed on a boat, creates the USS Liberty at its position.\nComes with a full interior, hull customization options, and is drivable by anyone."",  " \n "      ""\a3\ui_f_curator\Data\Displays\RscDisplayCurator\modeModules_ca.paa"",  " \n "      ""createDestroyer"" " \n "     ], " \n "     [ " \n "      ""Create Minefield"",  " \n "      ""Changes the existing minefield module, increases max radius to 1000 meters and max mines to 250."",  " \n "      ""\a3\ui_f_curator\data\cfgmarkers\minefieldap_ca.paa"",  " \n "      ""createMinefield"" " \n "     ], " \n "     [ " \n "      ""Debug Console"",  " \n "      ""Slightly overhauled Debug Console, changes 'Local Exec' button\nto execute scripts truly locally without remoteExecing to server\nhence risking kick by BattleEye."",  " \n "      ""\a3\3den\data\displays\display3den\entitymenu\findconfig_ca.paa"",  " \n "      ""debugConsole"" " \n "     ], " \n "     [ " \n "      ""Dynamic Simulation"",  " \n "      ""Enables or disable the ability to toggle dynamic simulation of objects to reduce lag.\n This system freezes said objects when out of a specified range from players."",  " \n "      ""\a3\modules_f\data\hideterrainobjects\icon_ca.paa"",  " \n "      ""dynSim"" " \n "     ], " \n "     [ " \n "      ""Dynamic Tasks"",  " \n "      ""A framework built around the placement of 'Zones/Sectors', said are automatically\npopulated with reaction QRF, IEDs, structures, interiors, and even tasks.\n\nNOTE: This module uses the 'ZEI - Custom Interiors' module, enabling this also force enables that."",  " \n "      ""\A3\ui_f\data\map\markers\nato\o_installation.paa"",  " \n "      ""dynTasks"" " \n "     ], " \n "     [ " \n "      ""EMP"",  " \n "      ""Deploys an EMP on the position."",  " \n "      ""\a3\3den\data\displays\display3den\toolbar\flashlight_off_ca.paa"",  " \n "      ""emp"" " \n "     ], " \n "     [ " \n "      ""Fade-In Intro"",  " \n "      ""Show a brief cinematic screen with mission introduction."",  " \n "      ""\a3\ui_f\data\igui\cfg\simpletasks\types\Talk_ca.paa"",  " \n "      ""fadeInIntro"" " \n "     ], " \n "     [ " \n "      ""Firefly Effect"",  " \n "      ""Creates a Firefly particle effect on object."",  " \n "      ""\a3\3den\data\displays\display3den\toolbar\flashlight_off_ca.paa"",  " \n "      ""fireflyEffect"" " \n "     ], " \n "     [ " \n "      ""Force Speed Limit"",  " \n "      ""Set the top speed of the selected AI driven/piloted vehicle."",  " \n "      ""\a3\ui_f\data\igui\cfg\simpletasks\types\car_ca.paa"",  " \n "      ""forceSpeed"" " \n "     ], " \n "     [ " \n "      ""Friendly Markers"",  " \n "      ""Shows friendly markers on the map.\n\nNOTE: Enabling this module here will automatically enable the markers on the\nmap. Configure them anytime by placing the 'Adjust Friendly Markers' module."",  " \n "      ""\a3\3den\data\displays\display3den\panelright\submode_marker_icon_ca.paa"",  " \n "      ""friendMarkers"" " \n "     ], " \n "     [ " \n "      ""Game Master Control"",  " \n "      ""Control whether game master slot has edit permissions and is usable,\nthis will convert the Game Master slot into another player slot so it does not go wasted."",  " \n "      ""\a3\Ui_F_Curator\Data\Logos\arma3_curator_eye_256_ca.paa"",  " \n "      ""gmControl"" " \n "     ], " \n "     [ " \n "      ""Ground Command"",  " \n "      ""Place on a player to elevate them to Ground Command with abilities.\n\nNOTE: Enabling this module here will automatically make you a Ground Command.\nToggle anytime by placing the 'Ground Command' module on yourself.\n\nNOTE: This module uses the 'Build Menu' and 'Support Menu' modules, enabling this also force enables them."",  " \n "      ""\A3\Ui_f\data\GUI\Cfg\Ranks\colonel_gs.paa"",  " \n "      ""groundCommand"", " \n "      43 " \n "     ], " \n "     [ " \n "      ""Moderator Control"",  " \n "      ""Control whether moderator slot has edit permissions and is usable,\nthis will convert the Moderator slot into another player slot so it does not go wasted."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\help_ca.paa"",  " \n "      ""modControl"" " \n "     ], " \n "     [ " \n "      ""Monsoon Storm"",  " \n "      ""Starts a Monsoon weather event."",  " \n "      ""\a3\modules_f_curator\data\portraitweather_ca.paa"",  " \n "      ""monsoonStorm"" " \n "     ], " \n "     [ " \n "      ""Object Fog"",  " \n "      ""Create Dynamic Fog particles around all players or an object of choice."",  " \n "      ""\a3\modules_f_curator\data\portraitweather_ca.paa"",  " \n "      ""objFog"" " \n "     ], " \n "     [ " \n "      ""Objective Type"",  " \n "      ""Allows you to set a custom icon for a placed objective by changing its type."",  " \n "      ""\A3\ui_f\data\igui\cfg\simpleTasks\types\default_ca.paa"",  " \n "      ""objType"" " \n "     ], " \n "     [ " \n "      ""Phase Transition"",  " \n "      ""Show a brief 15 second phase with cinematic black bars followed by a\nmission name, useful for transition between objectives."",  " \n "      ""\a3\ui_f\data\igui\cfg\simpletasks\types\Talk_ca.paa"",  " \n "      ""phaseTrans"" " \n "     ], " \n "     [ " \n "      ""Play Radio Message"",  " \n "      ""Play an important radio message for players in command channel."",  " \n "      ""\A3\ui_f\data\IGUI\RscIngameUI\RscDisplayChannel\MuteVON_ca.paa"",  " \n "      ""playRadioMsg"" " \n "     ], " \n "     [ " \n "      ""Play Sound"",  " \n "      ""Play any sound from objects, items, vehicles, etc."",  " \n "      ""\A3\ui_f\data\IGUI\RscIngameUI\RscDisplayChannel\MuteVON_ca.paa"",  " \n "      ""playSound"" " \n "     ], " \n "     [ " \n "      ""Play Track"",  " \n "      ""Play any souundtrack from music to news broadcasts."",  " \n "      ""\A3\ui_f\data\IGUI\RscIngameUI\RscDisplayChannel\MuteVON_ca.paa"",  " \n "      ""playTrack"" " \n "     ], " \n "     [ " \n "      ""Play Video"",  " \n "      ""Choose a video to play on the applied screen."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\whiteboard_ca.paa"",  " \n "      ""playVideo"" " \n "     ], " \n "     [ " \n "      ""Player Control"",  " \n "      ""Provides a dashboard to kick and log players, force players into spectator mode,\nenable Zeus logic, and manage prior kicked players in regards to Auto-Kicking them in the futue on join."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\meet_ca.paa"",  " \n "      ""playerCtrl"" " \n "     ], " \n "     [ " \n "      ""Profanity Filter"",  " \n "      ""Whether to enable the censoring of profane chat or to disable."",  " \n "      ""\a3\3den\data\cfg3den\comment\texture_ca.paa"",  " \n "      ""profanityFilter"" " \n "     ], " \n "     [ " \n "      ""Rupture Effect"",  " \n "      ""Creates a Rupture particle effect on the selected position 2000 meters above the ground."",  " \n "      ""\a3\3den\data\displays\display3den\toolbar\flashlight_off_ca.paa"",  " \n "      ""ruptureEffect"" " \n "     ], " \n "     [ " \n "      ""Sand Storm"",  " \n "      ""Starts a Sandstorm weather event."",  " \n "      ""\a3\modules_f_curator\data\portraitweather_ca.paa"",  " \n "      ""sandStorm"" " \n "     ], " \n "     [ " \n "      ""Scale Static Object"",  " \n "      ""Change the size of the choosen object."",  " \n "      ""\a3\3den\data\cfgwaypoints\scripted_ca.paa"",  " \n "      ""scaleStaticObj"" " \n "     ], " \n "     [ " \n "      ""SCP Screamer Spawn"",  " \n "      ""Spawn within the desired radius the amount of Screamer SCP monsters for a good scare."",  " \n "      ""\a3\Ui_F_Curator\Data\CfgMarkers\kia_ca.paa"",  " \n "      ""scpSpawn"" " \n "     ], " \n "     [ " \n "      ""Send Subtitle Message"",  " \n "      ""Changes to the existing send subtitle message system, allows for specifying colors."",  " \n "      ""\a3\3den\data\cfg3den\comment\texture_ca.paa"",  " \n "      ""sendSubMsg"" " \n "     ], " \n "     [ " \n "      ""Set Ambient Animation"",  " \n "      ""Adds more animations to the original module to choose from."",  " \n "      ""\a3\ui_f_curator\data\rsccommon\rscattributepunishmentanimation\pushupslegs.paa"",  " \n "      ""ambAnimation"" " \n "     ], " \n "     [ " \n "      ""Set View Distance"",  " \n "      ""Sets the view distance for yourself or all players."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\scout_ca.paa"",  " \n "      ""setViewDist"" " \n "     ], " \n "     [ " \n "      ""Snow Storm"",  " \n "      ""Starts a Snowstorm weather event."",  " \n "      ""\a3\modules_f_curator\data\portraitweather_ca.paa"",  " \n "      ""snowStorm"" " \n "     ], " \n "     [ " \n "      ""Sparks Effect"",  " \n "      ""Creates a Sparks particle effect on object."",  " \n "      ""\a3\3den\data\displays\display3den\toolbar\flashlight_off_ca.paa"",  " \n "      ""sparksEffect"" " \n "     ], " \n "     [ " \n "      ""SQF Debug Statistics"",  " \n "      ""Display a list and corresponding count of active SQF scripts on your local client."",  " \n "      ""\a3\3den\data\displays\display3den\entitymenu\findconfig_ca.paa"",  " \n "      ""sqfDebugStats"" " \n "     ], " \n "     [ " \n "      ""Stamina Control"",  " \n "      ""Control whether stamina affects players globally."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\run_ca.paa"",  " \n "      ""staminaCtrl"" " \n "     ], " \n "     [ " \n "      ""Support Menu"",  " \n "      ""Enable ability for choosen player to call in selected supports.\nAlso set a cooldown for how often supports can be called in."",  " \n "      ""\A3\ui_f\data\GUI\Cfg\CommunicationMenu\mortar_ca.paa"",  " \n "      ""supportMenu"" " \n "     ], " \n "     [ " \n "      ""Sync Tasks"",  " \n "      ""Fetch tasks from the first available player on your side to apply to your JIP Zeus player."",  " \n "      ""\a3\modules_f_curator\data\portraitobjectivemove_ca.paa"",  " \n "      ""syncTasks"" " \n "     ], " \n "     [ " \n "      ""ZEC - Custom Comps"",  " \n "      ""Handcrafted placeable compositions of various categories, rotate camera to rotate composition placement.\n\nNOTE: Enabling this will cause delay upon opening the\nZeus interface due to the sheer amount of compositions."",  " \n "      ""\a3\3den\data\cfg3den\group\iconcustomcomposition_ca.paa"",  " \n "      ""zecCustomComps"" " \n "     ], " \n "     [ " \n "      ""ZEI - Custom Interiors"",  " \n "      ""Handcrafted interiors spawnable within buildings of a specified area of a\nspecified category."",  " \n "      ""\a3\modules_f\data\editterrainobject\icon_ca.paa"",  " \n "      ""zeiCustomInt"" " \n "     ] " \n "    ]; " \n "    missionNamespace setVariable [""LM_var_modulesTypes"", LM_var_modulesTypes, true]; " \n " " \n " " \n "    LM_var_contextActionsTypes = [ " \n "     [ " \n "      ""Heal Unit"",  " \n "      ""Adds a Toggle Damage sub-option to the Heal Unit action."",  " \n "      ""\a3\ui_f\data\map\vehicleicons\pictureheal_ca.paa"",  " \n "      ""healUnit"" " \n "     ], " \n "     [ " \n "      ""Remove Edit Objects"",  " \n "      ""Fixes option 'Remove Edit Objects' to properly remove objects in a radius from the Zeus interface."",  " \n "      ""\a3\3den\data\cfg3den\group\iconcustomcomposition_ca.paa"",  " \n "      ""removeEditObj"" " \n "     ], " \n "     [ " \n "      ""Start Animation"",  " \n "      ""Adds a new action to play an animation on the selected unit."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\run_ca.paa"",  " \n "      ""startAnim"" " \n "     ], " \n "     [ " \n "      ""Teleport Here"",  " \n "      ""Fixes option 'Teleport Here' and sub-option 'Teleport Everyone' to work over water.\nAdds sub-option 'Teleport Side' to teleport all players of a choosen side."",  " \n "      ""\a3\3den\data\cfgwaypoints\move_ca.paa"",  " \n "      ""teleportHere"" " \n "     ] " \n "    ]; " \n "    missionNamespace setVariable [""LM_var_contextActionsTypes"", LM_var_contextActionsTypes, true]; " \n " " \n " " \n "    LM_var_playerActionsTypes = [ " \n "     [ " \n "      ""Arsenal On Respawn"",  " \n "      ""Scroll wheel action to open the 'Arsenal' on respawn enabled for all players."",  " \n "      ""\A3\ui_f\data\Logos\a_64_ca.paa"",  " \n "      ""arsenalRespawn"" " \n "     ], " \n "     [ " \n "      ""Bullet Tracing"",  " \n "      format[""Press 'CTRL+%1' to enable 3D Bullet Tracing."", keyName (profileNamespace getVariable [""LM_KB_bulletTracing"", 10])],  " \n "      ""\a3\ui_f_curator\data\cfgcurator\laser_ca.paa"",  " \n "      ""bulletTracing"", " \n "      10 " \n "     ], " \n "     [ " \n "      ""Damage Dir. Indicators"",  " \n "      format[""Press 'CTRL+%1' to enable markers indicating direction of incoming fire."", keyName (profileNamespace getVariable [""LM_KB_dmgDirInd"", 36])],  " \n "      ""\A3\ui_f\data\igui\cfg\simpleTasks\types\target_ca.paa"",  " \n "      ""dmgDirInd"", " \n "      36 " \n "     ], " \n "     [ " \n "      ""Drag Incapacitated"",  " \n "      ""Dragging 'Incapacitated' player bodies is now enabled when you are close to them."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\heal_ca.paa"",  " \n "      ""dragIncap"" " \n "     ], " \n "     [ " \n "      ""Ear Plugs"",  " \n "      format[""Press '%1' to enable Earplugs to reduce ambient sounds."", keyName (profileNamespace getVariable [""LM_KB_earPlugs"", 207])],  " \n "      ""\A3\ui_f\data\IGUI\RscIngameUI\RscDisplayChannel\MuteVON_crossed_ca.paa"",  " \n "      ""earPlugs"", " \n "      207 " \n "     ], " \n "     [ " \n "      ""Head Lamp"",  " \n "      format[""Press 'CTRL+%1' to enable Head Lamp, a light mounted above the right ear.\n\nNOTE: Place the 'Head Lamp' module on any man, AI or player to\nenable/disable it showing.\nNOTE: If this script is already enabled for this server, you will still gain\naccess to the 'Head Lamp' module."", keyName (profileNamespace getVariable [""LM_KB_headLamp"", 38])],  " \n "      ""\a3\3den\data\displays\display3den\toolbar\flashlight_off_ca.paa"",  " \n "      ""headLamp"", " \n "      38 " \n "     ], " \n "     [ " \n "      ""Helmet Camera"",  " \n "      format[""Press 'CTRL+%1' to enable Helmet Camera."", keyName (profileNamespace getVariable [""LM_KB_helmetCam"", 24])],  " \n "      ""\A3\Ui_f\data\GUI\Cfg\KeyframeAnimation\IconTimeline_CA.paa"",  " \n "      ""helmetCam"", " \n "      24 " \n "     ], " \n "     [ " \n "      ""Holster Weapon"",  " \n "      format[""Press '%1' to Holster Weapon."", keyName (profileNamespace getVariable [""LM_KB_holsterWeapon"", 35])],  " \n "      ""\a3\ui_f\data\igui\cfg\simpletasks\types\rifle_ca.paa"",  " \n "      ""holsterWeapon"", " \n "      35 " \n "     ], " \n "     [ " \n "      ""Improved Movement"",  " \n "      format[""Press 'CTRL+%1' whilst upright to jump or whilst near an object to climb."", keyName (profileNamespace getVariable [""LM_KB_impMovement"", 57])],  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\run_ca.paa"",  " \n "      ""impMovement"", " \n "      57 " \n "     ], " \n "     [ " \n "      ""Kill Feed"",  " \n "      ""On kill a 'Kill Feed' popup will detail weapon used, distance, and killed unit."",  " \n "      ""\a3\Ui_F_Curator\Data\CfgMarkers\kia_ca.paa"",  " \n "      ""killFeed"", " \n "      37 " \n "     ], " \n "     [ " \n "      ""Player Animations"",  " \n "      format[""Press 'CTRL+%1' to open the Player Animations Menu."", keyName (profileNamespace getVariable [""LM_KB_playerAnims"", 8])],  " \n "      ""\a3\ui_f_curator\data\rsccommon\rscattributepunishmentanimation\pushupslegs.paa"",  " \n "      ""playerAnims"", " \n "      8 " \n "     ], " \n "     [ " \n "      ""View Distance"",  " \n "      format[""Press key '%1' to open the View Distance Menu."", keyName (profileNamespace getVariable [""LM_KB_viewDist"", 72])],  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\scout_ca.paa"",  " \n "      ""viewDist"", " \n "      72 " \n "     ] " \n "    ]; " \n "    missionNamespace setVariable [""LM_var_playerActionsTypes"", LM_var_playerActionsTypes, true]; " \n " " \n " " \n "    LM_var_qualityOfLifesTypes = [ " \n "     [ " \n "      ""All Player Traits"",  " \n "      ""Enables traits 'UAV Hacker', 'explosiveSpecialist', 'medic', and 'engineer'\nfor all players.This allows them to use all items like toolkit/medikit\nand associated actions like partially repairing vehicles."",  " \n "      ""\a3\ui_f\data\gui\rsc\rscdisplaymain\menu_singleplayer_ca.paa"",  " \n "      ""allPlayerTraits"" " \n "     ], " \n "     [ " \n "      ""Auto Del. Player Bodies"",  " \n "      ""When a player dies or disconnects, automatically remove their dead body."",  " \n "      ""\a3\ui_f_curator\data\cfgmarkers\kia_ca.paa"",  " \n "      ""autoDelBodies"" " \n "     ], " \n "     [ " \n "      ""Auto Rem. Teamkillers"",  " \n "      ""When a player dies by friendly fire, the killers team killing score is automatically reset."",  " \n "      ""\a3\3den\data\displays\display3den\entitymenu\arsenal_ca.paa"",  " \n "      ""autoRemTKs"" " \n "     ], " \n "     [ " \n "      ""Disable Stamina"",  " \n "      ""Disables player stamina, so you dont have to manually do such."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\run_ca.paa"",  " \n "      ""disableStamina"" " \n "     ], " \n "     [ " \n "      ""Enable Spectating"",  " \n "      ""Enables the spectator button on the respawn screen, allows players in-death to observe the entire game world."",  " \n "      ""\a3\ui_f\data\gui\cfg\keyframeanimation\iconcamera_ca.paa"",  " \n "      ""enableSpec"" " \n "     ], " \n "     [ " \n "      ""Quick Respawn Timer"",  " \n "      ""Sets the respawn timer for all players to 1 second, ensuring quick respawn."",  " \n "      ""\a3\ui_f\data\igui\cfg\actions\settimer_ca.paa"",  " \n "      ""quickRespawnTimer"" " \n "     ], " \n "     [ " \n "      ""Radio Sounds"",  " \n "      ""When pressing the keybind to voice chat, play a sound in 3D space of a radio turning on or off."",  " \n "      ""\a3\modules_f_curator\data\portraitradio_ca.paa"",  " \n "      ""radioSounds"" " \n "     ], " \n "     [ " \n "      ""Respawn Loadouts"",  " \n "      ""Sets the selectable loadouts on the respawn menu to encompass every loadout\nfrom every placeable unit type for the player's side."",  " \n "      ""\a3\modules_f_curator\data\portraitrespawninventory_ca.paa"",  " \n "      ""respawnLoadouts"" " \n "     ], " \n "     [ " \n "      ""Revivable Zeus"",  " \n "      ""Makes it so a Zeus can be revived by other players when they go down."",  " \n "      ""\a3\Ui_F_Curator\Data\Logos\arma3_curator_eye_256_ca.paa"",  " \n "      ""revivableZeus"" " \n "     ], " \n "     [ " \n "      ""Sit in Chairs"",  " \n "      format[""Enables players to be able to press '%1' near any chair or bench to sit in it."", keyName (profileNamespace getVariable [""LM_KB_sitChairs"", 57])],  " \n "      ""\a3\ui_f_curator\data\rsccommon\rscattributepunishmentanimation\pushupslegs.paa"",  " \n "      ""sitChairs"" " \n "     ], " \n "     [ " \n "      ""Zeus Able To Revive"",  " \n "      ""Makes it so a Zeus can revive other players via a hold action on the downed player."",  " \n "      ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\heal_ca.paa"",  " \n "      ""zeusCanRevive"" " \n "     ], " \n "     [ " \n "      ""Zeus Ping Prompt"",  " \n "      ""Creates a prompt on the screen of the player when they press 'Y' to ping the Zeus.\nPrompt informs them the Zeus has been notified and will get to them soon.\nHelps prevent players from spamming the keybind."",  " \n "      ""\a3\modules_f_bootcamp\data\portraithint.paa"",  " \n "      ""zeusPingPrompt"" " \n "     ] " \n "    ]; " \n "    missionNamespace setVariable [""LM_var_qualityOfLifesTypes"", LM_var_qualityOfLifesTypes, true]; " \n " " \n " " \n "    _display = (findDisplay 312) createDisplay ""RscDisplayEmpty""; " \n "    _display displayAddEventHandler [""Unload"", { " \n "     params [""_display"", ""_exitCode""]; " \n "      " \n "     2.5 fadeMusic 0; " \n "    }]; " \n "    _ctrlGroup = _display ctrlCreate [""RscControlsGroup"", -1]; " \n "    _ctrlGroup ctrlShow false; " \n "    uiNamespace setVariable [""_ctrlGroup_initDashboard"", _ctrlGroup]; " \n " " \n " " \n "    _ctrlTextPlayerModifiers = _display ctrlCreate [""RscText"", -1, _ctrlGroup]; " \n "     _ctrlTextPlayerModifiers ctrlSetText ""[ EZM Addon: AEGIS ] Initialization Dashboard:""; " \n "     _ctrlTextPlayerModifiers ctrlSetTooltip ""Choose from the lists below of 'Modules/Context Actions/Player Actions/Quality of Life',\nthe features you would like to enable/disable. After initialization place this composition\ndown again at anytime to tweak certain settings.""; " \n "     _ctrlTextPlayerModifiers ctrlSetPosition [0, 0, 1.21, 0.04]; " \n "     _ctrlTextPlayerModifiers ctrlSetBackgroundColor EZM_themeColor; " \n "     _ctrlTextPlayerModifiers ctrlCommit 0; " \n " " \n "     _ctrlBackgroundPlayerModifiers = _display ctrlCreate [""RscTextMulti"", -1, _ctrlGroup]; " \n "      _ctrlBackgroundPlayerModifiers ctrlSetPosition [0, 0.0425, 1.21, 0.6875]; " \n "      _ctrlBackgroundPlayerModifiers ctrlSetBackgroundColor [0,0,0,0.4]; " \n "      _ctrlBackgroundPlayerModifiers ctrlEnable false; " \n "      _ctrlBackgroundPlayerModifiers ctrlCommit 0; " \n " " \n " " \n "    _ctrlTextModules = _display ctrlCreate [""RscText"", -1, _ctrlGroup]; " \n "     _ctrlTextModules ctrlSetText ""Modules:""; " \n "     _ctrlTextModules ctrlSetTooltip ""Choose from the list below of Modules to\nenable/disable populating in the Zeus interface.""; " \n "     _ctrlTextModules ctrlSetPosition [0.0025, 0.045, 0.275, 0.04]; " \n "     _ctrlTextModules ctrlSetBackgroundColor EZM_themeColor; " \n "     _ctrlTextModules ctrlCommit 0; " \n " " \n "     _ctrlCheckboxModulesSelect = _display ctrlCreate [""RscCheckBox"", -1, _ctrlGroup]; " \n "      _ctrlCheckboxModulesSelect ctrlSetTooltip ""Select to enable all for this section, otherwise disable all.""; " \n "      _ctrlCheckboxModulesSelect ctrlSetPosition [0.2475, 0.045, 0.03, 0.04]; " \n "      _ctrlCheckboxModulesSelect ctrlSetBackgroundColor [0.2,0.2,0.2,0.8]; " \n "      _ctrlCheckboxModulesSelect cbSetChecked false; " \n "      _ctrlCheckboxModulesSelect ctrlAddEventHandler [""CheckedChanged"", { " \n "       params [""_control""]; " \n " " \n "       private _state = cbChecked _control; " \n "       { " \n "        if (!(missionNamespace getVariable [format[""LM_init_%1"", _x select 3], false])) then { " \n "         (uiNamespace getVariable [format[""_ctrlCheckbox_%1"", _x select 3], ctrlNull]) cbSetChecked _state; " \n "        }; " \n "       } forEach LM_var_ModulesTypes; " \n "      }]; " \n "      _ctrlCheckboxModulesSelect ctrlCommit 0; " \n " " \n "     _ctrlGroupModules = _display ctrlCreate [""RscControlsGroup"", -1, _ctrlGroup]; " \n "      _ctrlGroupModules ctrlSetPosition [0, 0.09, 0.3025, 0.6375]; " \n "      _ctrlGroupModules ctrlCommit 0; " \n " " \n "      _ctrlBackgroundModules = _display ctrlCreate [""RscText"", -1, _ctrlGroupModules]; " \n "       _ctrlBackgroundModules ctrlSetPosition [0, 0, 0.28, 1]; " \n "       _ctrlBackgroundModules ctrlSetBackgroundColor [0.2,0.2,0.2,0.4]; " \n "       _ctrlBackgroundModules ctrlEnable false; " \n "       _ctrlBackgroundModules ctrlCommit 0; " \n " " \n "        private _yCoord = 0.005; " \n "        { " \n "         private _moduleType = _x select 0; " \n "         private _moduleTooltip = _x select 1; " \n "         private _moduleIcon = _x select 2; " \n "         private _moduleVar = _x select 3; " \n "         private _coordsText = []; " \n "         private _coordsCheckbox = []; " \n " " \n "         _coordsText = [0.0025, _yCoord, 0.275, 0.04]; " \n "         _coordsIcon = [0.0025, _yCoord, 0.03, 0.04]; " \n "         _coordsCheckbox = [0.2475, _yCoord, 0.03, 0.04]; " \n " " \n "         private _ctrlTextModules = _display ctrlCreate [""RscText"", -1, _ctrlGroupModules]; " \n "          _ctrlTextModules ctrlSetText format[""      %1"", _moduleType]; " \n "          _ctrlTextModules ctrlSetTooltip _moduleTooltip; " \n "          _ctrlTextModules ctrlSetPosition _coordsText; " \n "          _ctrlTextModules ctrlSetBackgroundColor [0.2,0.2,0.2,0.8]; " \n "          _ctrlTextModules ctrlEnable false; " \n "          _ctrlTextModules ctrlCommit 0; " \n "         " \n "          private _ctrlIconModules = _display ctrlCreate [""RscPicture"", -1, _ctrlGroupModules]; " \n "           _ctrlIconModules ctrlSetText _moduleIcon; " \n "           _ctrlIconModules ctrlSetPosition _coordsIcon; " \n "           _ctrlIconModules ctrlCommit 0; " \n "         " \n "          private _ctrlCheckboxModules = _display ctrlCreate [""RscCheckBox"", -1, _ctrlGroupModules]; " \n "           _ctrlCheckboxModules ctrlSetTooltip ""Select to enable, otherwise disable.""; " \n "           _ctrlCheckboxModules ctrlSetPosition _coordsCheckbox; " \n "           _ctrlCheckboxModules ctrlSetBackgroundColor [0.2,0.2,0.2,0.8]; " \n "           _ctrlCheckboxModules cbSetChecked (profileNamespace getVariable [format[""LM_init_%1"", _moduleVar], false]); " \n "           _ctrlCheckboxModules ctrlCommit 0; " \n "           uiNamespace setVariable [format[""_ctrlCheckbox_%1"", _moduleVar], _ctrlCheckboxModules]; " \n " " \n "         _yCoord = _yCoord + 0.045; " \n "        } forEach LM_var_modulesTypes; " \n " " \n "       _ctrlBackgroundModules ctrlSetPosition [0, 0, 0.3025, (_yCoord)]; " \n "       _ctrlBackgroundModules ctrlCommit 0; " \n " " \n " " \n "    _ctrlTextContextActions = _display ctrlCreate [""RscText"", -1, _ctrlGroup]; " \n "     _ctrlTextContextActions ctrlSetText ""Context Actions:""; " \n "     _ctrlTextContextActions ctrlSetTooltip ""Choose from the list below of Context Actions to enable/disable\npopulating in the Zeus interface (right-click context menu).""; " \n "     _ctrlTextContextActions ctrlSetPosition [0.305, 0.045, 0.275, 0.04]; " \n "     _ctrlTextContextActions ctrlSetBackgroundColor EZM_themeColor; " \n "     _ctrlTextContextActions ctrlCommit 0; " \n " " \n "     _ctrlCheckboxContextActionsSelect = _display ctrlCreate [""RscCheckBox"", -1, _ctrlGroup]; " \n "      _ctrlCheckboxContextActionsSelect ctrlSetTooltip ""Select to enable all for this section, otherwise disable all.""; " \n "      _ctrlCheckboxContextActionsSelect ctrlSetPosition [0.55, 0.045, 0.03, 0.04]; " \n "      _ctrlCheckboxContextActionsSelect ctrlSetBackgroundColor [0.2,0.2,0.2,0.8]; " \n "      _ctrlCheckboxContextActionsSelect cbSetChecked false; " \n "      _ctrlCheckboxContextActionsSelect ctrlAddEventHandler [""CheckedChanged"", { " \n "       params [""_control""]; " \n " " \n "       private _state = cbChecked _control; " \n "       { " \n "        if (!(missionNamespace getVariable [format[""LM_init_%1"", _x select 3], false])) then { " \n "         (uiNamespace getVariable [format[""_ctrlCheckbox_%1"", _x select 3], ctrlNull]) cbSetChecked _state; " \n "        }; " \n "       } forEach LM_var_ContextActionsTypes; " \n "      }]; " \n "      _ctrlCheckboxContextActionsSelect ctrlCommit 0; " \n " " \n "     _ctrlGroupContextActions = _display ctrlCreate [""RscControlsGroup"", -1, _ctrlGroup]; " \n "      _ctrlGroupContextActions ctrlSetPosition [0.3025, 0.09, 0.3025, 0.6375]; " \n "      _ctrlGroupContextActions ctrlCommit 0; " \n " " \n "      _ctrlBackgroundContextActions = _display ctrlCreate [""RscText"", -1, _ctrlGroupContextActions]; " \n "       _ctrlBackgroundContextActions ctrlSetPosition [0, 0, 0.28, 1]; " \n "       _ctrlBackgroundContextActions ctrlSetBackgroundColor [0.2,0.2,0.2,0.4]; " \n "       _ctrlBackgroundContextActions ctrlEnable false; " \n "       _ctrlBackgroundContextActions ctrlCommit 0; " \n " " \n "        private _yCoord = 0.005; " \n "        { " \n "         private _contextActionType = _x select 0; " \n "         private _contextActionTooltip = _x select 1; " \n "         private _contextActionIcon = _x select 2; " \n "         private _contextActionVar = _x select 3; " \n "         private _coordsText = []; " \n "         private _coordsCheckbox = []; " \n " " \n "         _coordsText = [0.0025, _yCoord, 0.275, 0.04]; " \n "         _coordsIcon = [0.0025, _yCoord, 0.03, 0.04]; " \n "         _coordsCheckbox = [0.2475, _yCoord, 0.03, 0.04]; " \n " " \n "         private _ctrlTextContextActions = _display ctrlCreate [""RscText"", -1, _ctrlGroupContextActions]; " \n "          _ctrlTextContextActions ctrlSetText format[""      %1"", _contextActionType]; " \n "          _ctrlTextContextActions ctrlSetTooltip _contextActionTooltip; " \n "          _ctrlTextContextActions ctrlSetPosition _coordsText; " \n "          _ctrlTextContextActions ctrlSetBackgroundColor [0.2,0.2,0.2,0.8]; " \n "          _ctrlTextContextActions ctrlEnable false; " \n "          _ctrlTextContextActions ctrlCommit 0; " \n "         " \n "          private _ctrlIconContextActions = _display ctrlCreate [""RscPicture"", -1, _ctrlGroupContextActions]; " \n "           _ctrlIconContextActions ctrlSetText _contextActionIcon; " \n "           _ctrlIconContextActions ctrlSetPosition _coordsIcon; " \n "           _ctrlIconContextActions ctrlCommit 0; " \n "         " \n "          private _ctrlCheckboxContextActions = _display ctrlCreate [""RscCheckBox"", -1, _ctrlGroupContextActions]; " \n "           _ctrlCheckboxContextActions ctrlSetTooltip ""Select to enable, otherwise disable.""; " \n "           _ctrlCheckboxContextActions ctrlSetPosition _coordsCheckbox; " \n "           _ctrlCheckboxContextActions ctrlSetBackgroundColor [0.2,0.2,0.2,0.8]; " \n "           _ctrlCheckboxContextActions cbSetChecked (profileNamespace getVariable [format[""LM_init_%1"", _contextActionVar], false]); " \n "           _ctrlCheckboxContextActions ctrlCommit 0; " \n "           uiNamespace setVariable [format[""_ctrlCheckbox_%1"", _contextActionVar], _ctrlCheckboxContextActions]; " \n " " \n "         _yCoord = _yCoord + 0.045; " \n "        } forEach LM_var_contextActionsTypes; " \n " " \n "       _ctrlBackgroundContextActions ctrlSetPosition [0, 0, 0.3025, (_yCoord)]; " \n "       _ctrlBackgroundContextActions ctrlCommit 0; " \n " " \n " " \n "    _ctrlTextPlayerActions = _display ctrlCreate [""RscText"", -1, _ctrlGroup]; " \n "     _ctrlTextPlayerActions ctrlSetText ""Player Actions:""; " \n "     _ctrlTextPlayerActions ctrlSetTooltip ""Choose from the list below of Player Action scripts\nto enable/disable usage of by players.""; " \n "     _ctrlTextPlayerActions ctrlSetPosition [0.6075, 0.045, 0.275, 0.04]; " \n "     _ctrlTextPlayerActions ctrlSetBackgroundColor EZM_themeColor; " \n "     _ctrlTextPlayerAct