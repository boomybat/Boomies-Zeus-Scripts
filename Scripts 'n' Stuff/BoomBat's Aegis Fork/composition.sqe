    _ammo setPosATL _safe; " \n "           _ammo setVectorUp surfaceNormal _safe; " \n "            " \n "           _ammo setVariable [""ZMM_ZoneID"", _zoneID, true]; " \n " " \n "           _enemySide revealMine _ammo; " \n "           CIVILIAN revealMine _ammo; " \n "            " \n "           _ieds pushBack _ammo; " \n "           _iedPositions pushBack _safe; " \n "          }; " \n " " \n "          missionNamespace setVariable [format[""ZMM_%1_IEDS_TOTAL"", _zoneID], count _ieds, true]; " \n "          missionNamespace setVariable [format[""ZMM_%1_IEDS_DISARMED"", _zoneID], 0, true]; " \n "           " \n "          missionNamespace setVariable [format[""ZMM_%1_IED_LIST"", _zoneID], _ieds]; " \n "          missionNamespace setVariable [format[""ZMM_%1_IED_POS_LIST"", _zoneID], _iedPositions]; " \n " " \n "          private _spotterPos = [_centre, 200, 300, 3, 0, 20, 0] call BIS_fnc_findSafePos vectorAdd [0,0,0]; " \n "          if (count _spotterPos == 0) then { _spotterPos = _centre getPos [250, random 360]; }; " \n " " \n "          private _spotterTeam = []; " \n "          private _sniperClass = _menArray select { (toLower(_x) find ""sniper"" > -1) or (toLower(_x) find ""sharpshooter"" > -1) }; " \n "          if (count _sniperClass == 0) then { _sniperClass = [selectRandom _menArray]; }; " \n "           " \n "          _spotterTeam pushBack (selectRandom _sniperClass); " \n "          _spotterTeam pushBack (selectRandom _menArray); " \n "           " \n "          private _spotterGrp = [_spotterPos, _enemySide, _spotterTeam] call BIS_fnc_spawnGroup; " \n "           " \n "          _spotterGrp setBehaviour ""STEALTH""; " \n "          _spotterGrp setCombatMode ""GREEN"";  " \n "          {  " \n "           _x doWatch _centre;  " \n "           _x disableAI ""PATH"";  " \n "           _x setUnitPos ""MIDDLE"";  " \n "          } forEach units _spotterGrp; " \n "           " \n "          { _x addCuratorEditableObjects [units _spotterGrp + _ieds, true] } forEach allCurators; " \n "           " \n "          private _spotterUnit = leader _spotterGrp; " \n "          missionNamespace setVariable [format[""ZMM_%1_SPOTTER"", _zoneID], _spotterUnit]; " \n "          _spotterUnit setVariable [""ZMM_ZoneID"", _zoneID, true]; " \n " " \n "          private _iedImg = getText (configFile >> ""CfgVehicles"" >> ""BombCluster_01_UXO1_F"" >> ""editorPreview""); " \n "          if (_iedImg == """") then { _iedImg = ""\A3\EditorPreviews_F\Data\CfgVehicles\BombCluster_01_UXO1_F.jpg""; }; " \n "           " \n "          private _spotterUnitImg = getText (configFile >> ""CfgVehicles"" >> (typeOf _spotterUnit) >> ""editorPreview""); " \n "          if (_spotterUnitImg == """") then { _spotterUnitImg = ""\A3\EditorPreviews_F\Data\CfgVehicles\O_Sniper_F.jpg""; }; " \n "           " \n "          private _mainTask = [format[""ZMM_%1_TSK"", _zoneID], true,  " \n "           [format[""<font color='#00FF80'>Mission (#ID%1)</font><br/>"", _zoneID] + format[selectRandom _missionDesc, _locName],  " \n "           [""Disarm""] call zmm_fnc_nameGen, format[""MKR_%1_IED_AREA"", _zoneID]], _centre, ""AUTOASSIGNED"", 1, false, true, ""mine""] call BIS_fnc_setTask; " \n " " \n "          private _mrkSpotter = format[""|%1|%2|Empty|ICON|[1,1]|0|Solid|Default|1|"",(format[""MKR_%1_SPOTTER"", _zoneID]), _spotterPos] call BIS_fnc_stringToMarker; " \n "          _mrkSpotter setMarkerShape ""ELLIPSE""; " \n "          _mrkSpotter setMarkerSize [75, 75]; " \n "          _mrkSpotter setMarkerColor format[""Color%1"", _enemySide]; " \n "          _mrkSpotter setMarkerBrush ""SolidBorder""; " \n "          _mrkSpotter setMarkerAlpha 0.5; " \n " " \n "          private _subTask1 = [[format[""ZMM_%1_SUB_HUNT"", _zoneID], format['ZMM_%1_TSK', _zoneID]], true,  " \n "           [format[""Search the surrounding high ground for the <font color='#00FFFF'>Spotter Team</font>. Neutralize them to prevent remote detonation.<br/><br/>Do NOT approach the main objective until they are down.<br/><br/>Look for this person:<br/><img image='%1' width='200' height='100'/>"", _spotterUnitImg],  " \n "           ""Neutralize Spotter"", format[""MKR_%1_SPOTTER"", _zoneID]], _spotterPos, ""AUTOASSIGNED"", 1, false, true, ""target""] call BIS_fnc_setTask; " \n " " \n "          private _mrkIEDs = format[""|%1|%2|Empty|ICON|[1,1]|0|Solid|Default|1|"",(format[""MKR_%1_IED_AREA"", _zoneID]), _centre] call BIS_fnc_stringToMarker; " \n "          _mrkIEDs setMarkerType ""n_mine""; " \n "          _mrkIEDs setMarkerColor ""ColorRed""; " \n "          _mrkIEDs setMarkerText ""Active Minefield""; " \n " " \n "          private _subTask2 = [[format[""ZMM_%1_SUB_DISARM"", _zoneID], format['ZMM_%1_TSK', _zoneID]], true,  " \n "           [format[""Once the spotter is dealt with, locate the <font color='#00FFFF'>IEDs</font> and disarm them.<br/><br/>Look for this object:<br/><img image='%1' width='200' height='100'/>"", _iedImg],  " \n "           ""Disarm IEDs"", format[""MKR_%1_IED_AREA"", _zoneID]], objNull, ""AUTOASSIGNED"", 1, false, true, ""mine""] call BIS_fnc_setTask; " \n " " \n "          [_zoneID, _spotterUnit, _ieds, _centre] spawn { " \n "           params [""_zID"", ""_spotter"", ""_ieds"", ""_centre""]; " \n "            " \n "           private _triggered = false; " \n "            " \n "           while {alive _spotter && !_triggered} do { " \n "            private _nearPlayers = allPlayers select { (_x distance2D _centre) < 35 }; " \n "             " \n "            if (count _nearPlayers > 0) then { " \n "             _triggered = true; " \n "              " \n "             [""Spotter"", ""I see them! Detonating now!""] remoteExec [""BIS_fnc_showSubtitle""]; " \n "             sleep 1; " \n "              " \n "             { " \n "              if (alive _x) then { " \n "               private _boom = (([(getPos _x), 0, ""Bo_GBU12_LGB"", sideEmpty] call BIS_fnc_spawnVehicle) select 0); " \n "               deleteVehicle _x;  " \n "              }; " \n "             } forEach _ieds; " \n "              " \n "             [format[""ZMM_%1_TSK"", _zID], 'Failed', true] remoteExec [""BIS_fnc_taskSetState"", 2]; " \n "             missionNamespace setVariable ['ZMM_DONE', true, true]; " \n "            }; " \n "             " \n "            sleep 2; " \n "           }; " \n "            " \n "           if (!alive _spotter && !_triggered) then { " \n "            [""High Command"", ""Spotter neutralized. The clacker should be on his body.""] remoteExec [""BIS_fnc_showSubtitle""]; " \n "            [format[""ZMM_%1_SUB_HUNT"", _zID], 'Succeeded', true] remoteExec [""BIS_fnc_taskSetState"", 2]; " \n "             " \n "            [format[""ZMM_%1_SUB_DISARM"", _zID], [missionNamespace getVariable [format[""ZMM_%1_Location"", _zID], [0,0,0]], true]] remoteExec [""BIS_fnc_taskSetDestination"", 2]; " \n "            [format[""ZMM_%1_SUB_DISARM"", _zID], ""AUTOASSIGNED""] remoteExec [""BIS_fnc_taskSetState"", 2]; " \n "           }; " \n "          }; " \n " " \n "          [ " \n "           _spotterUnit, " \n "           ""<t color='#FFFF00'>Search for Detonator Clacker</t>"", " \n "           ""\a3\ui_f\data\IGUI\Cfg\holdActions\holdAction_search_ca.paa"", " \n "           ""\a3\ui_f\data\IGUI\Cfg\holdActions\holdAction_search_ca.paa"", " \n "           ""!alive _target && !(_target getVariable ['ZMM_Clacker_Found', false]) && _this distance _target < 3"", " \n "           ""!alive _target && !(_target getVariable ['ZMM_Clacker_Found', false]) && _caller distance _target < 3"", " \n "           {}, " \n "           {}, " \n "           { " \n "            params [""_target"", ""_caller"", ""_actionId"", ""_arguments""]; " \n "            _target setVariable [""ZMM_Clacker_Found"", true, true]; " \n "            [_target, _actionId] remoteExec [""BIS_fnc_holdActionRemove"", 0, true]; " \n "             " \n "            private _zID = _target getVariable [""ZMM_ZoneID"", 0]; " \n "             " \n "            [name _caller, ""I found the clacker. Uploading IED locations to the squad HUD.""] remoteExec [""BIS_fnc_showSubtitle""]; " \n "             " \n "            [[_zID, _caller], { " \n "             params ['_zID', '_caller']; " \n "             private _ieds = missionNamespace getVariable [format[""ZMM_%1_IED_LIST"", _zID], []]; " \n "             private _iedPosList = missionNamespace getVariable [format[""ZMM_%1_IED_POS_LIST"", _zID], []]; " \n "              " \n "             { " \n "              private _idx = _forEachIndex + 1;  " \n "              private _subID = format[""ZMM_%1_SUB_IED_%2"", _zID, _idx]; " \n "               " \n "              private _taskPos = if (alive _x) then { getPos _x } else { _iedPosList select _forEachIndex }; " \n "               " \n "              [[_subID, format[""ZMM_%1_TSK"", _zID]], true,  " \n "              [format[""Disarm or destroy IED #%1 located at the marked position."", _idx], format[""Disarm IED #%1"", _idx], """"],  " \n "              _taskPos, ""AUTOASSIGNED"", 1, true, ""mine"", false] call BIS_fnc_setTask; " \n " " \n "              (side _caller) revealMine _x; " \n "             } forEach _ieds; " \n " " \n "             deleteMarker format[""MKR_%1_SPOTTER"", _zID]; " \n "              " \n "             [_zID, _ieds] spawn { " \n "              params [""_zID"", ""_ieds""]; " \n "               " \n "              private _allDone = false; " \n "               " \n "              while {!_allDone} do { " \n "               sleep 2; " \n "               private _activeIEDs = 0; " \n "                " \n "               { " \n "                private _iedObj = _x; " \n "                private _idx = _forEachIndex + 1; " \n "                 " \n "                if ((isNull _iedObj) || (!alive _iedObj) || (!mineActive _iedObj)) then { " \n "                  " \n "                 private _subID = format[""ZMM_%1_SUB_IED_%2"", _zID, _idx]; " \n "                  " \n "                 if !([_subID] call BIS_fnc_taskCompleted) then { " \n "                  [_subID, 'Succeeded', true] call BIS_fnc_taskSetState; " \n "                   " \n "                  private _count = missionNamespace getVariable [format[""ZMM_%1_IEDS_DISARMED"", _zID], 0]; " \n "                  _count = _count + 1; " \n "                  missionNamespace setVariable [format[""ZMM_%1_IEDS_DISARMED"", _zID], _count, true]; " \n "                   " \n "                  private _total = missionNamespace getVariable [format[""ZMM_%1_IEDS_TOTAL"", _zID], 3]; " \n "                  [""High Command"", format[""IED Neutralized. %1 remaining."", _total - _count]] remoteExec [""BIS_fnc_showSubtitle""]; " \n "                 }; " \n "                } else { " \n "                 _activeIEDs = _activeIEDs + 1; " \n "                }; " \n "               } forEach _ieds; " \n "                " \n "               if (_activeIEDs == 0) then { _allDone = true; }; " \n "              }; " \n "             }; " \n "              " \n "            }] remoteExec ['bis_fnc_call', 2]; " \n "           }, " \n "           {}, " \n "           [], " \n "           3, " \n "           10, " \n "           true, " \n "           false " \n "          ] remoteExec [""bis_fnc_holdActionAdd"", 0, true]; " \n " " \n "          private _successTrigger = ([AGLToASL _centre, ""EmptyDetector"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects) select 0; " \n "          _successTrigger setTriggerStatements [  " \n "           format[""(missionNamespace getVariable ['ZMM_%1_IEDS_DISARMED', 0]) >= (missionNamespace getVariable ['ZMM_%1_IEDS_TOTAL', 99])"", _zoneID],  " \n "           format["" " \n "            ['ZMM_%1_SUB_DISARM', 'Succeeded', true] spawn BIS_fnc_taskSetState;  " \n "            ['ZMM_%1_TSK', 'Succeeded', true] spawn BIS_fnc_taskSetState;  " \n "            missionNamespace setVariable ['ZMM_DONE', true, true];  " \n "            private _ieds = missionNamespace getVariable ['ZMM_%1_IED_LIST', []]; " \n "            { deleteMarker format['MKR_%1_IED_%%1', _forEachIndex] } forEach _ieds; " \n "            { deleteMarker _x } forEach ['MKR_%1_SPOTTER','MKR_%1_IED_AREA']; " \n "            { _x setMarkerColor ('Color' + str(missionNamespace getVariable ['ZMM_playerSide',WEST])) } forEach ['MKR_%1_LOC','MKR_%1_MIN']; " \n "           "", _zoneID],  " \n "           """"  " \n "          ]; " \n " " \n "          true " \n "         }; " \n "        }; " \n " " \n "        comment ""AI Generated Tasks""; " \n " " \n "        if (isNil(""sabotage_power_sqf"")) then { " \n "         sabotage_power_sqf = { " \n "          params [ [""_zoneID"", 0], [""_targetPos"", [0,0,0]] ]; " \n " " \n "          private _centre = missionNamespace getVariable [format[""ZMM_%1_Location"", _zoneID], _targetPos]; " \n "          private _enemySide = missionNamespace getVariable [format[""ZMM_%1_EnemySide"", _zoneID], EAST]; " \n "          private _menArray = missionNamespace getVariable [format[""ZMM_%1Man"", _enemySide], [""O_Soldier_F""]]; " \n "          private _radius = ((getMarkerSize format[""MKR_%1_MIN"", _zoneID])#0) max 100;  " \n "           " \n "          private _rawLocName = missionNamespace getVariable [format[""ZMM_%1_Name"", _zoneID], ""this Location""]; " \n "          private _locName = format[""<font color='#0080FF'>%1</font>"", _rawLocName]; " \n " " \n "          private _missionDesc = [ " \n "           ""The enemy garrison in %1 relies on a local power grid. We need to cut the lights. Locate and destroy the <font color='#00FFFF'>3 Circuit Breakers</font> to destabilize the grid, then overload the <font color='#00FFFF'>Main Transformer</font>."", " \n "           ""Sabotage operation approved. To take down the power in %1, you must physically destroy the perimeter <font color='#00FFFF'>Breaker Boxes</font>. Once the grid is unstable, force a meltdown at the <font color='#00FFFF'>Substation</font>."", " \n "           ""Blackout required. Locate the distributed <font color='#00FFFF'>Power Nodes</font> and destroy them with explosives. This will allow you to bypass the safeties on the <font color='#00FFFF'>Primary Transformer</font> and detonate it."" " \n "          ]; " \n "           " \n "          private _transPos = [_centre, 0, _radius, 8, 0, 0.25, 0] call BIS_fnc_findSafePos; " \n "          if (count _transPos == 0) then { _transPos = _centre; }; " \n "          _transPos = _transPos vectorAdd [0,0,0];  " \n " " \n "          private _breakerMax = missionNamespace getVariable [""ZZM_ObjectiveCount"", 3]; " \n "          missionNamespace setVariable [format[""ZMM_%1_BREAKERS_MAX"", _zoneID], _breakerMax, true]; " \n " " \n "          private _breakerPositions = []; " \n "          for ""_i"" from 1 to _breakerMax do { " \n "           private _angle = _i * 120; " \n "           private _dist = 150 + random 100; " \n "           private _safe = [_centre, 0, _radius, 2, 0, 0.5, 0] call BIS_fnc_findSafePos vectorAdd [0,0,0]; " \n "           if (count _safe == 0) then { _safe = (_centre getPos [_dist, _angle]); }; " \n "           _breakerPositions pushBack _safe; " \n "          }; " \n " " \n "          private _transformer = ([AGLToASL _transPos, ""Land_dp_transformer_F"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects) select 0; " \n "          _transformer setPosATL _transPos; " \n "          _transformer setVectorUp [0,0,1];  " \n "          _transformer setVectorUp surfaceNormal _transPos; " \n "           " \n "          _transformer allowDamage false;  " \n "          _transformer setVariable [""ZMM_ZoneID"", _zoneID, true]; " \n "           " \n "          private _transTeam = []; " \n "          for ""_j"" from 0 to (4 + (missionNamespace getVariable [""ZZM_Diff"", 1])) do { _transTeam set [_j, selectRandom _menArray] }; " \n "          private _transGrp = [_transPos, _enemySide, _transTeam] call BIS_fnc_spawnGroup; " \n "          [_transGrp, _transPos, 30] call BIS_fnc_taskPatrol; " \n "           " \n "          private _transProps = [ " \n "           [_transPos vectorAdd [4, 4, 0], ""Land_JunkPile_F"", random 360], " \n "           [_transPos vectorAdd [-4, -4, 0], ""Land_JunkPile_F"", random 360], " \n "           [_transPos vectorAdd [4, -4, 0], ""Land_Wreck_Skodovka_F"", random 360] " \n "          ]; " \n "           " \n "          private _refVectorUp = vectorUp _transformer; " \n "           " \n "          { " \n "           _x params [""_p"", ""_cls"", ""_d""]; " \n "           private _obj = ([AGLToASL _p, _cls, 1, [0,0,0], _d, {0}, false] call BIS_fnc_spawnObjects) select 0; " \n "           _obj setVectorUp _refVectorUp; " \n "           _obj setPosASL (getPosASL _obj vectorAdd [0, 0, 0.05]);  " \n "          } forEach _transProps; " \n "           " \n "          private _transImg = getText (configFile >> ""CfgVehicles"" >> ""Land_dp_transformer_F"" >> ""editorPreview""); " \n "          if (_transImg == """") then { _transImg = ""\A3\EditorPreviews_F\Data\CfgVehicles\Land_dp_transformer_F.jpg""; }; " \n " " \n "          private _mainTask = [format[""ZMM_%1_TSK"", _zoneID], true,  " \n "           [format[""<font color='#00FF80'>Mission (#ID%1)</font><br/>"", _zoneID] + format[selectRandom _missionDesc, _locName],  " \n "           [""Sabotage""] call zmm_fnc_nameGen, format[""MKR_%1_MAIN"", _zoneID]], _centre, ""AUTOASSIGNED"", 1, false, true, ""destroy""] call BIS_fnc_setTask; " \n " " \n " " \n "          private _breakers = []; " \n "          missionNamespace setVariable [format[""ZMM_%1_BREAKERS_DESTROYED"", _zoneID], 0, true]; " \n "           " \n "          private _breakerImg = getText (configFile >> ""CfgVehicles"" >> ""Land_PowerGenerator_F"" >> ""editorPreview"");  " \n "           " \n "          { " \n "           private _bPos = _x; " \n "            " \n "           private _breaker = ([AGLToASL _bPos, ""Land_PowerGenerator_F"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects) select 0; " \n "           _breaker setPosATL _bPos; " \n "           _breaker setVectorUp surfaceNormal _bPos; " \n "           _breaker setVariable [""ZMM_ZoneID"", _zoneID, true]; " \n "           _breaker setVariable [""ZMM_BreakerID"", _forEachIndex, true]; " \n "            " \n "           _breaker addEventHandler [""Killed"", { " \n "            params [""_unit"", ""_killer"", ""_instigator"", ""_useEffects""]; " \n "            private _zID = _unit getVariable [""ZMM_ZoneID"", 0]; " \n "            private _bID = _unit getVariable [""ZMM_BreakerID"", 0]; " \n "             " \n "            private _breakerTotal = missionNamespace getVariable [format[""ZMM_%1_BREAKERS_MAX"", _zID], 0]; " \n "            private _count = missionNamespace getVariable [format[""ZMM_%1_BREAKERS_DESTROYED"", _zID], 0]; " \n "            _count = _count + 1; " \n "            missionNamespace setVariable [format[""ZMM_%1_BREAKERS_DESTROYED"", _zID], _count, true]; " \n "             " \n "            [format[""ZMM_%1_SUB_BREAK_%2"", _zID, _bID], 'Succeeded', true] remoteExec [""BIS_fnc_taskSetState"", 2]; " \n "            deleteMarker format[""MKR_%1_BREAKER_%2"", _zID, _bID]; " \n "             " \n "            if (_count < _breakerTotal) then { " \n "             [""High Command"", format[""Grid Destabilized: %1/%2 Breakers Destroyed"", _count, (count _breakerTotal)]] remoteExec [""BIS_fnc_showSubtitle""]; " \n "            } else { " \n "             [""High Command"", ""Grid is unstable! The Main Transformer safeties are offline. Destroy it now!""] remoteExec [""BIS_fnc_showSubtitle""]; " \n "             [format[""ZMM_%1_SUB_CORE"", _zID], [missionNamespace getVariable [format[""ZMM_%1_Location"", _zID], [0,0,0]], true]] remoteExec [""BIS_fnc_taskSetDestination"", 2]; " \n "             [format[""ZMM_%1_SUB_CORE"", _zID], ""AUTOASSIGNED""] remoteExec [""BIS_fnc_taskSetState"", 2]; " \n "            }; " \n "           }]; " \n "            " \n "           _breakers pushBack _breaker; " \n "            " \n "           private _breakerTeam = []; " \n "           for ""_j"" from 0 to (1 + (missionNamespace getVariable [""ZZM_Diff"", 1])) do { _breakerTeam set [_j, selectRandom _menArray] }; " \n "           private _bGrp = [_bPos, _enemySide, _breakerTeam] call BIS_fnc_spawnGroup; " \n "           [_bGrp, _bPos, 20] call BIS_fnc_taskPatrol; " \n "           { _x addCuratorEditableObjects [units _bGrp, true] } forEach allCurators; " \n "            " \n "           private _mrkPos = _bPos getPos [15 + random 25, random 360]; " \n "            " \n "           private _mrkName = format[""MKR_%1_BREAKER_%2"", _zoneID, _forEachIndex]; " \n "           private _mrk = format[""|%1|%2|Empty|ICON|[1,1]|0|Solid|Default|1|"", _mrkName, _mrkPos] call BIS_fnc_stringToMarker; " \n "           _mrk setMarkerShape ""ELLIPSE""; " \n "           _mrk setMarkerSize [60, 60]; " \n "           _mrk setMarkerBrush ""SolidBorder""; " \n "           _mrk setMarkerColor format[""Color%1"", _enemySide]; " \n "           _mrk setMarkerAlpha 0.5; " \n " " \n "           [[format[""ZMM_%1_SUB_BREAK_%2"", _zoneID, _forEachIndex], format['ZMM_%1_TSK', _zoneID]], true,  " \n "           [format[""Search the marked area and destroy the <font color='#00FFFF'>Circuit Breaker Node</font>.<br/><br/>Look for this generator:<br/><img image='%1' width='200' height='100'/>"", _breakerImg],  " \n "           format[""Destroy Breaker %1"", _forEachIndex + 1], _mrkName], _mrkPos, ""AUTOASSIGNED"", 1, false, true, ""destroy""] call BIS_fnc_setTask; " \n " " \n "          } forEach _breakerPositions; " \n " " \n "          private _mrkrMain = format[""|%1|%2|Empty|ICON|[1,1]|0|Solid|Default|1|"",(format[""MKR_%1_MAIN"", _zoneID]), _transPos] call BIS_fnc_stringToMarker; " \n "          _mrkrMain setMarkerType ""loc_Power""; " \n "          _mrkrMain setMarkerColor format[""Color%1"", _enemySide]; " \n "          _mrkrMain setMarkerText ""Main Transformer""; " \n " " \n "          private _subTask2 =