asks\types\repair_ca.paa' width='20' height='20' /> <font font size='17' face='PuristaBold'>Reclaimer</font><br /><br />"" + " \n "             format[""• <font color='#ff9100' face='PuristaBold'>ACTIVE:</font> Press 'CTRL+%1' to resurrect a targeted vehicle wreck within 7m using a Toolkit.<br />"", keyName (profileNamespace getVariable [""LM_KB_roleReclaimer"", 20])] +  " \n "             ""• <font color='#ff9100' face='PuristaBold'>PASSIVE:</font> Gradually boost speeds of vics within 100m, max 200% over 2~ minutes.<br />"" + " \n " " \n "             ""<img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>"" + " \n " " \n "             ""<img image='\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\destroy_ca.paa' width='20' height='20' /> <font font size='17' face='PuristaBold'>Sapper</font><br /><br />"" + " \n "             ""• <font color='#ff9100' face='PuristaBold'>ACTIVE:</font> 'Seismic Cascade' uses MineDetector, destroys mines, 15% of buildings in 250m.<br />"" +  " \n "             ""• <font color='#ff9100' face='PuristaBold'>PASSIVE:</font> Reveal to your side overtime, all mines within 50m of you.<br />"" + " \n " " \n "             ""<img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>"" + " \n " " \n "             ""<img image='\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\heal_ca.paa' width='20' height='20' /> <font font size='17' face='PuristaBold'>Medic</font><br /><br />"" + " \n "             ""• <font color='#ff9100' face='PuristaBold'>ACTIVE:</font> 'Vitality Surge' uses MediKit, heals and revives all players within 100m of you.<br />"" +  " \n "             ""• <font color='#ff9100' face='PuristaBold'>PASSIVE:</font> 3D HUD always shows downed players, players within 15m regen health slowly.<br />"" + " \n " " \n "             ""<img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>"" + " \n " " \n "             ""<img image='\a3\Modules_F_Curator\Data\iconLightning_ca.paa' width='20' height='20' /> <font font size='17' face='PuristaBold'>Cipher</font><br /><br />"" + " \n "             ""• <font color='#ff9100' face='PuristaBold'>ACTIVE:</font> 'EMP' requires RadioPack, disables lights and vehicle engines within 100m.<br />"" +  " \n "             ""• <font color='#ff9100' face='PuristaBold'>PASSIVE:</font> 3D HUD always shows enemies within 50m of you, even through obstacles.<br />"" + " \n " " \n "             ""<img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>"" + " \n " " \n "             ""<img image='\a3\modules_f\data\editterrainobject\texturechecked_wall_ca.paa' width='20' height='20' /> <font font size='17' face='PuristaBold'>Engineer</font><br /><br />"" + " \n "             format[""• <font color='#ff9100' face='PuristaBold'>ACTIVE:</font> Press 'CTRL+%1' to construct fortifications, statics, structures, and supports.<br />"", keyName (profileNamespace getVariable [""LM_KB_buildMenu"", 48])] +  " \n "             ""• <font color='#ff9100' face='PuristaBold'>PASSIVE:</font> Friendly players within 15m gain 25% reduction in weapon recoil and sway.<br />"" + " \n " " \n "             ""<img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>"" + " \n " " \n "             ""The icon for the assigned role of a player can be seen on their chest.</font>"", " \n "             ""\a3\ui_f\data\gui\rsc\rscdisplaymain\menu_multiplayer_ca.paa"" " \n "            ],  " \n "            taskNull,  " \n "            ""NONE"",  " \n "            false " \n "           ] call LM_fnc_makeDiaryRecordCodeCompile; " \n " " \n "           [ " \n "            ""LM_diary_groundCommandSystem"",  " \n "            [ " \n "             ""Hierarchy"",  " \n "             ""<font size='12'><font size='20' face='PuristaBold'>Hierarchy:</font><br /><img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>3D markers on all friendly unit chests will be present, the displayed information will be:"" +  " \n "             ""<br /><br /><font size='14'>Identification:</font><br />Visible colors and prefixes:<br />"" +  " \n "             ""<br />• <font color='#ffffff'>[HC]</font> - High Command (Zeus)"" +  " \n "             ""<br />• <font color='#ff9100'>[GC]</font> - Ground Command"" +   " \n "             ""<br />• <font color='#fcfe69'>[SL]</font> - A Squad Leader"" +  " \n "             ""<br />• '<font color='#FF004C99'>Player Name</font>' - Non-Group Member"" +  " \n "             ""<br />• '<font color='#c5f478'>Player Name</font>' - Group Member"" +  " \n "             ""<br /><br /><font size='14'>Ranks:</font><br />Visible rank icons, ordered highest to lowest:<br />"" +  " \n "             ""<br />• <img image='\A3\Ui_f\data\GUI\Cfg\Ranks\colonel_gs.paa' width='20' height='20' /> - Colonel"" +  " \n "             ""<br />• <img image='\A3\Ui_f\data\GUI\Cfg\Ranks\major_gs.paa' width='20' height='20' /> - Major"" +  " \n "             ""<br />• <img image='\A3\Ui_f\data\GUI\Cfg\Ranks\captain_gs.paa' width='20' height='20' /> - Captain"" +  " \n "             ""<br />• <img image='\A3\Ui_f\data\GUI\Cfg\Ranks\lieutenant_gs.paa' width='20' height='20' /> - Lieutenant"" +  " \n "             ""<br />• <img image='\A3\Ui_f\data\GUI\Cfg\Ranks\sergeant_gs.paa' width='20' height='20' /> - Sergeant"" +  " \n "             ""<br />• <img image='\A3\Ui_f\data\GUI\Cfg\Ranks\corporal_gs.paa' width='20' height='20' /> - Corporal"" +  " \n "             ""<br />• <img image='\A3\Ui_f\data\GUI\Cfg\Ranks\private_gs.paa' width='20' height='20' /> - Private</font>"", " \n "             ""\A3\Ui_f\data\GUI\Cfg\Ranks\general_gs.paa"" " \n "            ],  " \n "            taskNull,  " \n "            ""NONE"",  " \n "            false " \n "           ] call LM_fnc_makeDiaryRecordCodeCompile; " \n " " \n "           [ " \n "            ""LM_diary_groundCommandSystem"",  " \n "            [ " \n "             ""Overview"",  " \n "             ""<font size='12'><font size='20' face='PuristaBold'>Overview:</font><br /><img image='#(argb,8,8,3)color(1,1,1,0.1)' height='1' width='640' /><br/><br/>Zeus can designate player(s) as a '<font color='#ff9100'>Ground Command</font>', giving them access to a special menu accessed by pressing '<font color='#ff9100'>\</font>'. "" +  " \n "             ""Abilities granted by the menu are:<br /><br />• Assign custom objectives (Side, Squad, or Player).<br />• Place respawn points.<br />• Change player squads.<br />• Change squad names.<br />• Promote squad leaders.<br />• Assign player ranks.<br />• Assign player roles.<br />• Assign players supports.<br /><br />Multiple Ground Commanders can be assigned for any side to control any player squads.</font>"",  " \n "             ""\A3\ui_f\data\IGUI\Cfg\simpleTasks\types\whiteboard_ca.paa"" " \n "            ],  " \n "            taskNull,  " \n "            ""NONE"",  " \n "            false " \n "           ] call LM_fnc_makeDiaryRecordCodeCompile; " \n "          }; " \n "         }; " \n "        }] remoteExec ['bis_fnc_call',0,""LM_JIP_groundCommandInit""]; " \n "         " \n "        if (isNull (getAssignedCuratorLogic _entity)) then { " \n "         [[_entity],{ " \n "          params [""_entity""]; " \n "          systemchat format [""[ EZM Addon: AEGIS ] : Be advised, '%1' is now your Ground Commander. Open your map and read the 'Ground Command' tab to understand what supports and traits you can request they assign you!"", (name _entity)]; " \n "         }] remoteExec ['bis_fnc_call',0,false]; " \n "         [[_entity],{ " \n "          params [""_entity""]; " \n "          private _prompt = [ " \n "           ""Ground Command Access Granted"",  " \n "           [""ACCESS:"",  " \n "           format[""Press '%1' to open the Ground Command interface anytime."", keyName (profileNamespace getVariable [""LM_KB_groundCommand"", 43])],  " \n "           ""USAGE:"",  " \n "           ""The top half of the window allows you to select a squad and associated player. You may assign traits, supports, ranks, and even promote users."",  " \n "           ""Bottom half of the window you may make and assign custom objectives to the selected side, squad, or player. You may also place respawn points for your side."",  " \n "           ""SUPPORTS/TRAITS:"",  " \n "           ""Instruct players to open their map and select the Ground Command tab to read up on the supports and traits they can be assigned by you."",  " \n "           ""DISCLAIMER:"",  " \n "           ""By pressing continue you agree to use the interface responsibly understanding it can be taken away at anytime.""]]; " \n "          (_prompt select 0) hintC (_prompt select 1); " \n "          playSound ""addItemOk""; " \n "         }] remoteExec ['bis_fnc_call',_entity,false]; " \n " " \n "        }; " \n "        systemchat format [""[ EZM Addon: AEGIS ] : Ground Command menu action for '%1' has been enabled!"", (name _entity)]; " \n " " \n "        if (_playerNames) then { " \n "         [] spawn LM_fnc_playerNamesModule; " \n "        } else { " \n "         ['Draw3D', (player getVariable ['LM_MEH_playerNames',-1])] remoteExec [""removeMissionEventHandler"", 0, ""LM_JIP_playerNames""]; " \n "        }; " \n "       } else { " \n "        systemchat format [""[ EZM Addon: AEGIS ] : Ground Command menu action for '%1' already enabled!"", (name _entity)]; " \n "       }; " \n " " \n "       if (_restrictSide) then { " \n "        [1, [true, false]] remoteExec [""enableChannel"", 0, ""LM_JIP_groundCommandSideChannel""]; " \n "       } else { " \n "        [1, [true, true]] remoteExec [""enableChannel"", 0, true]; " \n "       }; " \n "      } else { " \n "       if (_groundCommandMenuCurrent) then { " \n "        [_entity, ""PRIVATE""] remoteExec [""setRank"", _entity, true]; " \n " " \n "        [_entity,{ " \n "         params [""_entity""]; " \n "         if (player == _entity) then { " \n "          waitUntil {(!isNull (findDisplay 46)) && (alive player)}; " \n "          (player getVariable ['LM_var_groundCommandMenuDisplay', displayNull]) closeDisplay 1; " \n "          (findDisplay 46) displayRemoveEventHandler ['KeyDown', (player getVariable ['LM_DEH_groundCommandMenu', -1])]; " \n "          player setVariable ['LM_var_nameGroundCommand', false, 0]; " \n "         }; " \n "         if (isNull (getAssignedCuratorLogic _entity)) then { " \n "          systemchat format [""[ EZM Addon: AEGIS ] : Be advised, '%1' is no longer your Ground Commander. They can no longer assign supports or traits to you!"", (name _entity)]; " \n "         }; " \n "        }] remoteExec ['bis_fnc_call',0,false]; " \n "        systemchat format [""[ EZM Addon: AEGIS ] : Ground Command menu action for '%1' has been disabled!"", (name _entity)]; " \n "        [1, [true, true]] remoteExec [""enableChannel"", 0, true]; " \n "       } else { " \n "        systemchat format [""[ EZM Addon: AEGIS ] : Ground Command menu action for '%1' already disabled!"", (name _entity)]; " \n "       }; " \n "      }; " \n "     }; " \n " " \n "      LM_fnc_playerNamesModule = { " \n "       [[],{ " \n "        waitUntil {(!isNull (findDisplay 46)) && (alive player)}; " \n "        missionNamespace setVariable [""LM_var_playerNamesModule"",false,true]; " \n "        removeMissionEventHandler ['Draw3D', (player getVariable ['LM_MEH_playerNames',-1])]; " \n "        (findDisplay 46) displayRemoveEventHandler ['KeyDown', (player getVariable ['LM_DEH_isCapsHeldDown',-1])]; " \n "        (findDisplay 46) displayRemoveEventHandler ['KeyUp', (player getVariable ['LM_DEH_isCapsHeldUp',-1])]; " \n " " \n "        player setVariable [""LM_var_isCapsHeld"", false, true]; " \n " " \n "        _dehIDDown = (findDisplay 46) displayAddEventHandler [""KeyDown"", { " \n "         params [""_display"", ""_key""]; " \n "          " \n "         if (_key == 58) then { " \n "          player setVariable [""LM_var_isCapsHeld"", true, true]; " \n "         }; " \n "         false;  " \n "        }]; " \n "        player setVariable ['LM_DEH_isCapsHeldDown',_mehID]; " \n " " \n "        _dehIDUp = (findDisplay 46) displayAddEventHandler [""KeyUp"", { " \n "         params [""_display"", ""_key""]; " \n "          " \n "         if (_key == 58) then { " \n "          player setVariable [""LM_var_isCapsHeld"", false, true]; " \n "         }; " \n "         false; " \n "        }]; " \n "        player setVariable ['LM_DEH_isCapsHeldUp',_mehID]; " \n " " \n " " \n "        _mehID = addMissionEventHandler [""Draw3D"", " \n "         { " \n "          private _friendlySides = ([west, east, independent] select { ((side (group player)) getFriend _x) >= 0.6 }); " \n "          private _testerUUIDs = [""76561198448021639""]; " \n " " \n "          if (count _friendlySides > 0) then { " \n "           { " \n "            private _hackerCheck = (!([(side _x), (side (group player))] call BIS_fnc_sideIsFriendly) && ((player getVariable [""LM_var_roleIndex"", 0]) == 4) && (_x distance player <= 50)); " \n "            private _medicCheck = ((player getVariable [""LM_var_roleIndex"", 0]) == 3) && (lifestate _x == 'INCAPACITATED'); " \n "             " \n "            if ( " \n "             (player!=_x) && (name _x != ""Male06ENG"")  " \n "             &&  " \n "             ( " \n "              ([(side _x), (side (group player))] call BIS_fnc_sideIsFriendly) " \n "              || " \n "              ((lifestate _x == 'INCAPACITATED') && ([(side (group _x)), (side (group player))] call BIS_fnc_sideIsFriendly)) " \n "              || " \n "              _hackerCheck " \n "             ) " \n "             && " \n "             (_x distance player < 1000) " \n "            ) then { " \n "             if((((vehicle _x)!=_x)&&(_x==effectiveCommander (vehicle _x)))||((vehicle _x)==_x)) then { " \n "              private _camPos = AGLToASL (positionCameraToWorld [0,0,0]); " \n "              private _camDir = _camPos vectorFromTo (AGLToASL (positionCameraToWorld [0,0,1])); " \n "              private _posTarget = getPosASL _x; " \n "              private _targetPos = aimPos _x; " \n " " \n "              private _dirToTarget = vectorNormalized (_posTarget vectorDiff _camPos); " \n "              private _dotProduct = _camDir vectorDotProduct _dirToTarget; " \n " " \n "              private _isLookingAt = { " \n "               params [""_target"", ""_buffer""]; " \n " " \n "               private _bBox = boundingBoxReal _target; " \n " " \n "               private _centerRelative = ((_bBox select 0) vectorAdd (_bBox select 1)) vectorMultiply 0.5; " \n " " \n "               private _centerWorld = _target modelToWorldVisual _centerRelative; " \n " " \n "               private _screenPos = worldToScreen _centerWorld; " \n " " \n "               if (count _screenPos == 0) exitWith { false }; " \n " " \n "               private _distFromCrosshair = _screenPos distance [0.5, 0.5]; " \n " " \n "               _distFromCrosshair <= _buffer " \n "              }; " \n " " \n "              if ([_x, 0.5] call _isLookingAt) then { " \n "               private _intersections = lineIntersectsSurfaces [ " \n "                _camPos,  " \n "                _targetPos,  " \n "                player,  " \n "                _x,  " \n "                true,  " \n "                1,  " \n "                ""GEOM"",  " \n "                ""FIRE"" " \n "               ]; " \n " " \n "               if ( " \n "                (count _intersections == 0) " \n "                || " \n "                (_medicCheck) " \n "                || " \n "                (_hackerCheck) " \n "               ) then { " \n "                private _texture = ([_x, ""texture""] call BIS_fnc_rankParams); " \n "                private _traitTexture = _x getVariable [""LM_var_traitTexture"", """"]; " \n "                if (_traitTexture != """") then { " \n "                 _texture = _traitTexture; " \n "                }; " \n "                if (_x getVariable [""LM_var_isCapsHeld"", false]) then { " \n "                 _texture = ""\A3\ui_f\data\IGUI\RscIngameUI\RscDisplayVoiceChat\microphone_ca.paa""; " \n "                }; " \n "                private _color = ([side _x, false] call BIS_fnc_sideColor) vectorAdd [0.25, 0.25, 0.25]; " \n " " \n "                private _position = []; " \n "                if (((vehicle _x)!=_x) && (_x==effectiveCommander (vehicle _x))) then { " \n "                 _position = (vehicle _x) modelToWorld [0,0,3]; " \n "                } else { " \n "                 if ((vehicle _x)==_x) then { " \n "                  _position = _x modelToWorld [0,0,2.3]; " \n "                 }; " \n "                }; " \n " " \n "                private _maxDistance = 200; " \n "                private _dist = player distance _x; " \n "                _factor = (1 - (_dist / _maxDistance)) max 0; " \n " " \n "                private _alpha = 1 * _factor; " \n "                private _width = 0.25 * _factor; " \n "                private _height = 0.25 * _factor; " \n "                private _textSize = 0.025 * _factor; " \n " " \n "                private _zoomedFactor = 2; " \n "                if (cameraView == ""GUNNER"") then { " \n "                 if (_factor <= 0.75) then { " \n "                  if (_dotProduct >= 0.9999) then { " \n "                   _alpha = 0.75; " \n "                   _width = 0.1875; " \n "                   _height = 0.1875; " \n "                   _textSize = 0.0225; " \n "                  }; " \n "                 } else { " \n "                  _alpha = 1 mod (_alpha * _zoomedFactor); " \n "                  _width = 0.25 mod (_width * _zoomedFactor); " \n "                  _height = 0.25 mod (_height * _zoomedFactor); " \n "                  _textSize = 0.025 mod (_textSize * _zoomedFactor); " \n "                 }; " \n "                }; " \n " " \n "                private _typeUnit = """"; " \n "                private _curatorObj =