/> Howitzer Strike"" +  " \n "             ""<br />• <img image='\a3\Modules_F_Curator\Data\portraitOrdnanceRocket_ca.paa' width='20' height='20' /> Rocket Cluster Strike"" +  " \n "             ""<br />• <img image='\a3\Modules_F_Curator\Data\portraitOrdnance_ca.paa' width='20' height='20' /> Cruise Missile Strike"" +  " \n "             ""<br />• <img image='\a3\Modules_F_Curator\Data\portraitCASGun_ca.paa' width='20' height='20' /> Guns Strike (CAS)"" +  " \n "             ""<br />• <img image='\a3\Modules_F_Curator\Data\portraitCASMissile_ca.paa' width='20' height='20' /> Missiles Strike (CAS)"" +  " \n "             ""<br />• <img image='\a3\Modules_F_Curator\Data\portraitCASGunMissile_ca.paa' width='20' height='20' /> Guns and Missiles Strike (CAS)"" +  " \n "             ""<br />• <img image='\a3\Modules_F_Curator\Data\portraitCASBomb_ca.paa' width='20' height='20' /> Bomb Strike (CAS)"" +  " \n "             ""<br />• <img image='\A3\Air_F_Exp\VTOL_01\Data\UI\Map_VTOL_01_armed_CA.paa' width='20' height='20' /> Gunship Cover"" +  " \n "             ""<br />• <img image='\A3\Drones_F\Air_F_Gamma\UAV_02\Data\UI\Map_UAV_02_CA.paa' width='20' height='20' /> UAV Surveillance Cover"" +  " \n "             ""<br />• <img image='\A3\Air_F_Beta\Heli_Attack_01\Data\UI\Map_Heli_Attack_01_CA.paa' width='20' height='20' /> Attack Chopper Cover"" +  " \n "             ""<br />• <img image='\A3\Air_F_Jets\Plane_Fighter_01\Data\UI\Fighter01_icon_ca.paa' width='20' height='20' /> Fighter Jet Cover"" +  " \n "             ""<br />• <img image='\A3\ui_f\data\Logos\a_64_ca.paa' width='20' height='20' /> Arsenal Airdrop"" +  " \n "             ""<br />• <img image='\A3\Soft_F_Exp\LSV_01\Data\UI\map_LSV_01_base_CA.paa' width='20' height='20' /> HMG Truck Airdrop"" +  " \n "             ""<br />• <img image='\a3\soft_f_beta\Truck_01\Data\UI\map_truck_01_covered_CA.paa' width='20' height='20' /> Transport Truck Airdrop"" +  " \n "             ""<br />• <img image='\A3\armor_f_beta\A