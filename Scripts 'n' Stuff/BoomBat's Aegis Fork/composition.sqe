" " \n "       private _objs = nearestObjects [_position, [], _sizeTown]; " \n "       private _terrain = nearestTerrainObjects [_position, [], _sizeTown]; " \n "       private _buildings = ((_objs + _terrain) arrayIntersect (_objs + _terrain)); " \n " " \n "       { " \n "        private _bld = _x; " \n "        private _bldObjs = _bld getVariable [""zei_furnished_objs"", []]; " \n "        if (count (_bld getVariable [""zei_furnished_objs"", []]) > 0) then { " \n "         { " \n "          deleteVehicle _x; " \n "         } forEach _bldObjs; " \n "         _bld setVariable [""zei_furnished_objs"", [], 0]; " \n "        }; " \n "       } forEach _buildings; " \n " " \n "       if (_town != """") then { " \n "        systemChat format[""[ EZM Addon: AEGIS ] : Interiors removed at location '%1' for all buildings, location radius was '%2'."", _town, _sizeTown]; " \n "        playSound ""3DEN_notificationDefault""; " \n "       } else { " \n "        systemChat format[""[ EZM Addon: AEGIS ] : Interiors removed at position '%1' for all buildings in a radius of '%2'."", _position, _sizeTown]; " \n "        playSound ""3DEN_notificationDefault""; " \n "       }; " \n " " \n "       _display closeDisplay 1; " \n "      },{ " \n "       params [""_values"",""_args"",""_display""]; " \n "       _display closeDisplay 2; " \n "      },[_pos]] call MAZ_EZM_fnc_createDialog; " \n "     }; " \n " " \n " " \n "    comment ""Cinematic Intro""; " \n "     LM_fnc_cinematicIntroModule = { " \n "      private _trackArray =  (configfile >> ""CfgMusic"") call BIS_fnc_getCfgSubClasses; " \n "      private _optionsArray = []; " \n "      for ""_x"" from 0 to ((count _trackArray) - 1) do { " \n "       private _track = (getText(configfile >> ""CfgMusic"" >> _trackArray select _x >> ""name"")); " \n "       private _type = (getText(configfile >> ""CfgMusic"" >> _trackArray select _x >> ""theme"")); " \n "       private _length = (getNumber(configfile >> ""CfgMusic"" >> _trackArray select _x