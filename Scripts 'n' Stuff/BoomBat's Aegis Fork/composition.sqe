 0]; " \n "             " \n "            [_target, _actionId] remoteExec [""BIS_fnc_holdActionRemove"", 0, true]; " \n "             " \n "            playSound3D [""\a3\Sounds_F\sfx\alarm_BLUFOR.wss"", _target]; " \n "             " \n "            [name _caller, ""Safeties overridden! It's going critical in 10 seconds! Run!""] remoteExec [""BIS_fnc_showSubtitle""]; " \n "             " \n "            [_target, _zID] spawn { " \n "             params [""_obj"", ""_zID""]; " \n "             private _radius = ((getMarkerSize format[""MKR_%1_MIN"", _zID])#0) max 100;  " \n "              " \n "             private _psArray = [getPosASL _obj, ""#particlesource"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects; " \n "             private _ps = _psArray select 0; " \n "             _ps setParticleClass ""MediumDestructionSmoke""; " \n "             _ps setDropInterval 0.05; " \n "             _ps attachTo [_obj, [0,0,0.5]]; " \n "             [_ps] spawn { params [""_ps""]; sleep 30; deleteVehicle _ps; }; " \n " " \n "             private _psArray2 = [getPosASL _obj, ""#particlesource"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects; " \n "             private _ps2 = _psArray2 select 0; " \n "             _ps2 setParticleClass ""ExpSparks1""; " \n "             _ps2 setDropInterval 0.05; " \n "             _ps2 attachTo [_obj, [0,0,0.5]]; " \n "             [_ps2] spawn { params [""_ps""]; sleep 30; deleteVehicle _ps; }; " \n " " \n "             sleep 10;  " \n " " \n "             [_radius, (getPos _obj), false] remoteExec [""LM_fnc_empSpawn"", 2]; " \n "              " \n "             _obj setDamage 1; " \n "              " \n "             missionNamespace setVariable [format[""ZMM_%1_POWER_DOWN"", _zID], true, true]; " \n "            }; " \n "            _caller remoteExecCall [""BIS_fnc_ambientAnim__terminate""]; " \n "           }, " \n "           { " \n "            params [""_target"", ""_caller"", ""_actionId"", ""_arguments""]; " \n "            _caller remoteExecCall [""BIS_fnc_ambientAnim__terminate""]; " \n "           }, " \n "           [], " \n "           10, " \n "           10, " \n "           true, " \n "           false " \n "          ] remoteExec [""bis_fnc_holdActionAdd"", 0, true]; " \n " " \n "          private _successTrigger = ([AGLToASL _centre, ""EmptyDetector"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects) select 0; " \n "          _successTrigger setTriggerStatements [  " \n "           format[""missionNamespace getVariable ['ZMM_%1_POWER_DOWN', false]"", _zoneID],  " \n "           format["" " \n "            ['ZMM_%1_SUB_CORE', 'Succeeded', true] spawn BIS_fnc_taskSetState;  " \n "            ['ZMM_%1_TSK', 'Succeeded', true] spawn BIS_fnc_taskSetState;  " \n "            missionNamespace setVariable ['ZMM_DONE', true, true];  " \n "            { deleteMarker _x } forEach ['MKR_%1_MAIN','MKR_%1_BREAKER_0','MKR_%1_BREAKER_1','MKR_%1_BREAKER_2']; " \n "            { _x setMarkerColor ('Color' + str(missionNamespace getVariable ['ZMM_playerSide',WEST])) } forEach ['MKR_%1_LOC','MKR_%1_MIN']; " \n "           "", _zoneID],  " \n "           """"  " \n "          ]; " \n " " \n "          { _x addCuratorEditableObjects [[_transformer] + _breakers + units _transGrp, true] } forEach allCurators; " \n " " \n "          true " \n "         }; " \n "        }; " \n " " \n "        if (isNil(""sabotage_supplies_sqf"")) then { " \n "         sabotage_supplies_sqf = { " \n "          params [ [""_zoneID"", 0], [""_targetPos"", [0,0,0]] ]; " \n " " \n "          private _centre = missionNamespace getVariable [format[""ZMM_%1_Location"", _zoneID], _targetPos]; " \n "          private _enemySide = missionNamespace getVariable [format[""ZMM_%1_EnemySide"", _zoneID], EAST]; " \n "          private _menArray = missionNamespace getVariable [format[""ZMM_%1Man"", _enemySide], [""O_Soldier_F""]]; " \n "          private _radius = ((getMarkerSize format[""MKR_%1_MIN"", _zoneID])#0) max 100;  " \n "           " \n "          private _rawLocName = missionNamespace getVariable [format[""ZMM_%1_Name"", _zoneID], ""this Location""]; " \n "          private _locName = format[""<font color='#0080FF'>%1</font>"", _rawLocName]; " \n " " \n "          private _missionDesc = [ " \n "           ""We have an opportunity to weaken the garrison at %1 without firing a shot. First, recover a canister of <font color='#00FFFF'>Experimental Toxin</font> from a nearby cache. Then, infiltrate the main camp and contaminate their <font color='#00FFFF'>Water Supplies</font>."", " \n "           ""The enemy's supply chain is vulnerable. Locate the lost <font color='#00FFFF'>Chemical Agent</font>, then use it to taint the <font color='#00FFFF'>3 Water Pallets</font> feeding the enemy barracks in %1."", " \n "           ""Psychological warfare is approved. Retrieve the <font color='#00FFFF'>Viral Canister</font> marked on your map. Take it to the enemy Forward Base and pour it into their <font color='#00FFFF'>Water Reserves</font>."" " \n "          ]; " \n " " \n "          private _cachePos = [_centre, 300, 600, 3, 0, 20, 0] call BIS_fnc_findSafePos vectorAdd [0,0,0]; " \n "          if (count _cachePos == 0) then { _cachePos = _centre getPos [400, random 360]; }; " \n " " \n "          private _depotPos = _centre; " \n " " \n "          private _toxinObj = ([AGLToASL _cachePos, ""Land_CanisterPlastic_F"", 1, [0,0,0], 0, {0}, true] call BIS_fnc_spawnObjects) select 0; " \n "          _toxinObj setPosATL _cachePos; " \n "          _toxinObj setVectorUp surfaceNormal _cachePos; " \n "           " \n "          _toxinObj setVariable [""ZMM_ZoneID"", _zoneID, true]; " \n "           " \n "          private _toxinImg = getText (configFile >> ""CfgVehicles"" >> ""Land_CanisterPlastic_F"" >> ""editorPreview""); " \n " " \n "          private _cacheTeam = []; " \n "          for ""_j"" from 0 to (2 + (missionNamespace getVariable [""ZZM_ObjectiveCount"", 3])) do { _cacheTeam set [_j, sele